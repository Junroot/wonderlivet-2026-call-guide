    },
    {
      "t": 56,
      "text": "Oh 星屑もない",
      "ko": "Oh 호시쿠즈모 나이"
    },
    {
      "t": 60,
      "text": "ふたりぼっちの世界でずっと",
      "ko": "후타리봇치노 세카이데 즛토"
    },
    {
      "t": 65.44,
      "text": "最後の花火をあげて",
      "ko": "사이고노 하나비오 아게테"
    },
    {
      "t": 69.35,
      "text": "フィナーレを飾って",
      "ko": "휘나-레오 카잣테"
    },
    {
      "t": 72,
      "text": "奇跡の降る恋に落ちて",
      "ko": "키세키노 후루 코이니 오치테"
    },
    {
      "t": 77.66,
      "text": "ダーリン もう離さないで",
      "ko": "다-린 모- 하나사나이데"
    },
    {
      "t": 82.36,
      "text": "味気ない世界も悪くないね",
      "ko": "아지케나이 세카이모 와루쿠 나이네"
    },
    {
