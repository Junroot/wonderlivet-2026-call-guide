  "lrclib": {
    "id": 14733700,
    "trackName": "ケダモノのフレンズ",
    "artistName": "にしな"
  },
  "durationSec": 217,
  "lines": [
    {
      "t": 9.52,
      "text": "ネイビーブルーの海を飲み干し",
      "ko": "네이비- 부루-노 우미오 노미호시"
    },
    {
      "t": 15.74,
      "text": "月の灯りももう食べ尽くしたよ",
      "ko": "츠키노 아카리모 모- 타베츠쿠시타요"
    },
    {
      "t": 21.56,
      "text": "ここは僕らだけの国",
      "ko": "코코와 보쿠라다케노 쿠니"
    },
    {
      "t": 26.37,
      "text": "Where the wild things are",
      "ko": null
    },
    {
      "t": 31.09,
      "text": "ずっとどこかで泣いてる",
      "ko": "즛토 도코카데 나이테루"
    },
    {
      "t": 35.49,
      "text": "風が炎を揺らせば",
      "ko": "카제가 호노오오 유라세바"
    },
    {
      "t": 40.62,
      "text": "ダンスパーティーが始まる",
      "ko": "단스 파-티-가 하지마루"
    },
    {
      "t": 44.92,
      "text": "眠れぬ夜",
      "ko": "네무레누 요루"
    },
    {
      "t": 55.68,
      "text": "ゆらりゆらり揺れる",
      "ko": "유라리 유라리 유레루"
    },
    {
      "t": 58.58,
      "text": "ケダモノのフレンズ",
      "ko": "케다모노노 후렌즈"
    },
    {
      "t": 60.7,
      "text": "醜さが愛しさを",
      "ko": "미니쿠사가 이토시사오"
    },
    {
      "t": 63.3,
      "text": "抱きしめているなら",
      "ko": "다키시메테 이루나라"
    },
    {
      "t": 66.36,
      "text": "クライクライ夜は",
      "ko": "쿠라이 쿠라이 요루와"
    },
    {
      "t": 68.53,
      "text": "照らさない魔法が欲しい",
      "ko": "테라사나이 마호-가 호시-"
    },
    {
      "t": 73.16,
      "text": "優しくなれるように",
      "ko": "야사시쿠 나레루 요-니"
    },
    {
      "t": 85.32,
      "text": "ベイビートゥルー朝日が登る前",
      "ko": "베이비- 투루- 아사히가 노보루 마에"
    },
    {
      "t": 90.75,
      "text": "遠くで一つ星が壊れたよ",
      "ko": "토-쿠데 히토츠 호시가 코와레타요"
    },
    {
      "t": 96.35,
      "text": "きっと誰も知らない",
      "ko": "킷토 다레모 시라나이"
    },
    {
      "t": 100.78,
      "text": "Where the wild things are",
      "ko": null
    },
    {
      "t": 105.87,
      "text": "孤独はここだけにしか",
      "ko": "코도쿠와 코코다케니시카"
    },
    {
      "t": 110.66,
      "text": "ないようなフリしてた",
      "ko": "나이 요-나 후리 시테타"
    },
    {
      "t": 115.47,
      "text": "見上げればユニオンリバー",
      "ko": "미아게레바 유니온 리바-"
    },
    {
      "t": 120.06,
      "text": "が溢れ始める",
      "ko": "가 아후레 하지메루"
    },
    {
      "t": 130.52,
      "text": "ゆらりゆらり揺れる",
      "ko": "유라리 유라리 유레루"
    },
    {
      "t": 133.41,
      "text": "ケダモノのフレンズ",
      "ko": "케다모노노 후렌즈"
    },
    {
      "t": 136.05,
      "text": "悲しみが優しさを",
      "ko": "카나시미가 야사시사오"
    },
    {
      "t": 138.74,
      "text": "抱きしめているなら",
      "ko": "다키시메테 이루나라"
    },
    {
      "t": 141.18,
      "text": "クライクライ夜は",
      "ko": "쿠라이 쿠라이 요루와"
    },
    {
      "t": 143.35,
      "text": "溢れてしまうままに",
      "ko": "아후레테 시마우 마마니"
    },
    {
      "t": 148.19,
      "text": "愛しあえるように",
      "ko": "아이시아에루 요-니"
    },
    {
      "t": 151.62,
      "text": "Let the wild rumpus start",
      "ko": null
    },
    {
      "t": 153.28,
      "text": "食べ尽くした孤独を愛した",
      "ko": "타베츠쿠시타 코도쿠오 아이시타"
    },
    {
      "t": 155.63,
      "text": "ひとりぼっちの夜が無数に",
      "ko": "히토리봇치노 요루가 무스-니"
    },
    {
      "t": 158.38,
      "text": "散らばって煌くチリのように",
      "ko": "치라밧테 키라메쿠 치리노 요-니"
    },
    {
      "t": 161.05,
      "text": "抱きしめられず壊すんだろう",
      "ko": "다키시메라레즈 코와슨다로-"
    },
    {
      "t": 163.83,
      "text": "踊り疲れて眠るんだろう",
      "ko": "오도리 츠카레테 네무룬다로-"
    },
    {
      "t": 165.77,
      "text": "誰にも分からない僕らの",
      "ko": "다레니모 와카라나이 보쿠라노"
    },
    {
      "t": 168.27,
      "text": "Where the wild things are",
      "ko": null
    },
    {
      "t": 171.15,
      "text": "ゆらりゆらり揺れる",
      "ko": "유라리 유라리 유레루"
    },
    {
      "t": 173.36,
      "text": "ケダモノのフレンズ",
      "ko": "케다모노노 후렌즈"
    },
    {
      "t": 175.66,
      "text": "踊ろうよ今夜は",
      "ko": "오도로-요 콘야와"
    },
    {
      "t": 178.25,
      "text": "はぐれた世界の隅",
      "ko": "하구레타 세카이노 스미"
    },
    {
      "t": 180.76,
      "text": "るらりるらり歌う",
      "ko": "루라리 루라리 우타우"
    },
    {
      "t": 183.42,
      "text": "醜いこんな声を",
      "ko": "미니쿠이 콘나 코에오"
    },
    {
      "t": 188.39,
      "text": "優しいあの子まで",
      "ko": "야사시- 아노 코마데"
    },
    {
      "t": 198.43,
      "text": "We are the wild things",
      "ko": null
    }
  ],
