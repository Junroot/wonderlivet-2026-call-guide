    {
      "t": 14.22,
      "text": "맑은 하늘에 비 내리는 날",
      "ko": null
    },
    {
      "t": 19.2,
      "text": "내 마음과 정말 닮아서 이상하네요",
      "ko": null
    },
    {
      "t": 25.65,
      "text": "한 방울 한 방울씩 떨어지는 비가",
      "ko": null
    },
    {
      "t": 30.42,
      "text": "점점 맘에 차서 숨쉬기가 힘들 것 같아요",
      "ko": null
    },
    {
      "t": 37.04,
      "text": "세상이 아직은 무섭고",
      "ko": null
    },
    {
      "t": 39.95,
      "text": "여전히 넘어지는 게",
      "ko": null
    },
    {
      "t": 43.54,
      "text": "아직은 너무 어려운가 봐",
      "ko": null
    },
    {
      "t": 48.14,
      "text": "눈물 멈추는 법을 몰라요",
      "ko": null
    },
    {
      "t": 51.9,
      "text": "차디차고 너무 아파요",
      "ko": null
    },
    {
      "t": 54.94,
      "text": "괜찮다는 말은 다 거짓말",
      "ko": null
    },
    {
      "t": 59.56,
      "text": "비가 내리는 여기 남겨져",
      "ko": null
    },
    {
      "t": 63.36,
      "text": "혼자 울고 싶지 않아요",
      "ko": null
    },
    {
      "t": 66.38,
      "text": "알려주세요",
      "ko": null
    },
    {
      "t": 68.52,
      "text": "눈물을 참는 방법",
      "ko": null
    },
    {
      "t": 82.8,
      "text": "하나둘 한숨 위로 차오른 슬픔이",
      "ko": null
    },
    {
      "t": 87.58,
      "text": "이제는 밖으로 다 쏟아져 넘칠 것 같아요",
      "ko": null
    },
    {
