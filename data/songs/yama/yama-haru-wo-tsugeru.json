  "lines": [
    {
      "t": 0.95,
      "text": "深夜東京の6畳半夢を見てた",
      "ko": "신야 토-쿄-노 로쿠조-한 유메오 미테타"
    },
    {
      "t": 5.99,
      "text": "灯りの灯らない蛍光灯",
      "ko": "아카리노 토모라나이 케-코-토-"
    },
    {
      "t": 7.99,
      "text": "明日には消えてる電脳城に",
      "ko": "아시타니와 키에테루 덴노-조-니"
    },
    {
      "t": 10.03,
      "text": "開幕戦打ち上げていなくなんないよね",
      "ko": "카이마쿠센 우치아게테 이나쿠난나이요네"
    },
    {
      "t": 13.88,
      "text": "ここには誰もいない ここには誰もいないから",
      "ko": "코코니와 다레모 이나이 코코니와 다레모 이나이카라"
    },
    {
      "t": 34.07,
      "text": "ここに救いはないよ",
      "ko": "코코니 스쿠이와 나이요"
    },
    {
      "t": 35.94,
      "text": "早く行っておいで",
      "ko": "하야쿠 잇테 오이데"
    },
    {
      "t": 37.86,
      "text": "難しい話はやめよう",
      "ko": "무즈카시- 하나시와 야메요-"
    },
    {
      "t": 39.94,
      "text": "とりあえず上がって酒でも飲んでさ",
      "ko": "토리아에즈 아갓테 사케데모 논데사"
    },
    {
      "t": 43.34,
      "text": "いつも誰にでもいうことを繰り返してる",
      "ko": "이츠모 다레니데모 이우 코토오 쿠리카에시테루"
    },
    {
      "t": 49.62,
      "text": "完璧な演出と 完璧な人生を",
      "ko": "칸페키나 엔슈츠토 칸페키나 진세-오"
    },
    {
      "t": 53.46,
      "text": "幼少期の面影は誰も知らないんだ",
      "ko": "요-쇼-키노 오모카게와 다레모 시라나인다"
    },
    {
      "t": 58.14,
      "text": "誰もがマイノリティなタイムトラベラー",
      "ko": "다레모가 마이노리티나 타이무 토라베라-"
    },
    {
      "t": 61.62,
      "text": "ほら真夜中はすぐそこさ",
      "ko": "호라 마요나카와 스구 소코사"
    },
    {
      "t": 65.62,
      "text": "深夜東京の6畳半夢を見てた",
      "ko": "신야 토-쿄-노 로쿠조-한 유메오 미테타"
    },
    {
