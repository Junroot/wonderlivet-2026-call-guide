  },
  "durationSec": 232,
  "lines": [
    {
      "t": 23.62,
      "text": "他じゃ味わえないこの品と感",
      "ko": "호카쟈 아지와에나이 코노 시나토 칸"
    },
    {
      "t": 26.13,
      "text": "一度喰らっちまったらendless",
      "ko": "이치도 쿠랏치맛타라 endless"
    },
    {
      "t": 28.54,
      "text": "現在進行形の中毒性",
      "ko": "겐자이 신코-케-노 츄-도쿠세-"
    },
    {
      "t": 30.85,
      "text": "常に変化を続ける一等星 yeah",
      "ko": "츠네니 헨카오 츠즈케루 잇토-세- yeah"
    },
    {
      "t": 33.81,
      "text": "我ら「君の分身だ」とか言って",
      "ko": "와레라 「키미노 분신다」토카 잇테"
    },
    {
      "t": 36.06,
      "text": "自分自身も何か分かっちゃ無いな",
      "ko": "지분지신모 나니카 와캇챠 나이나"
    },
    {
      "t": 38.59,
      "text": "肥大した自尊心並びに 酷い膿の様な劣等に、葛藤",
      "ko": "히다이시타 지손신 나라비니 히도이 우미노 요-나 렛토-니, 캇토-"
    },
    {
      "t": 43.33,
      "text": "善悪美醜綺麗も汚いも",
      "ko": "젠아쿠 비슈- 키레-모 키타나이모"
    },
    {
      "t": 46.87,
      "text": "余すこと無くこの身削って一生を賭けたフルコース",
      "ko": "아마스 코토 나쿠 코노 미 케즛테 잇쇼-오 카케타 후루코-스"
    },
    {
      "t": 53.25,
      "text": "さあ、ご賞味あれ",
      "ko": "사-, 고쇼-미 아레"
    },
    {
      "t": 57.29,
      "text": "我が命枯れるその時まで終わること無き晩餐会",
      "ko": "와가 이노치 카레루 소노 토키마데 오와루 코토 나키 반산카이"
    },
    {
      "t": 61.83,
      "text": "Banquet 喰らい尽くしてくれ",
      "ko": "Banquet 쿠라이츠쿠시테쿠레"
    },
    {
      "t": 66.56,
      "text": "伝い流れる血の一滴まで飲み干して、欲して",
      "ko": "츠타이 나가레루 치노 잇테키마데 노미호시테, 호시테"
    },
    {
      "t": 71.27,
      "text": "Banquet 歌い明かしてくれ",
      "ko": "Banquet 우타이아카시테쿠레"
    },
    {
      "t": 76.06,
      "text": "最期を告げる一時まで、毎夜続く山羊の宴さ",
      "ko": "사이고오 츠게루 히토토키마데, 마이요 츠즈쿠 야기노 우타게사"
    },
    {
      "t": 80.97,
      "text": "君だけのBanquet",
      "ko": "키미다케노 Banquet"
    },
    {
      "t": 83.6,
      "text": "「生きたい」とか「死にたい」とか日々怠惰な言葉吐いては",
      "ko": "「이키타이」토카 「시니타이」토카 히비 타이다나 코토바 하이테와"
    },
    {
      "t": 86.38,
      "text": "意味ない様なその態度も笑い合いたいよな",
      "ko": "이미나이 요-나 소노 타이도모 와라이아이타이요나"
    },
    {
      "t": 89.03,
      "text": "描きたいのは私の脳内の往来の奇ッ怪な愛",
      "ko": "에가키타이노와 와타시노 노-나이노 오-라이노 킷카이나 아이"
    },
    {
      "t": 92.4,
      "text": "息絶える前に 嗚呼、神様",
      "ko": "이키타에루 마에니 아-, 카미사마"
    },
    {
      "t": 96.47,
      "text": "ここに何故、私が居るのか教えてくれ",
      "ko": "코코니 나제, 와타시가 이루노카 오시에테쿠레"
    },
    {
      "t": 100.46,
      "text": "今宵、我等の生誕祭",
      "ko": "코요이, 와레라노 세-탄사이"
    },
    {
      "t": 102.53,
      "text": "Birthday 盛大に祝ってやってくれ",
      "ko": "Birthday 세-다이니 이왓테 얏테쿠레"
    },
    {
      "t": 107.21,
      "text": "流れ流れてようやっと来たんだ 居場所を探して",
      "ko": "나가레 나가레테 요-얏토 키탄다 이바쇼오 사가시테"
    },
    {
      "t": 112.16,
      "text": "Birthday 存分に暴れてやろうぜ",
      "ko": "Birthday 존분니 아바레테 야로-제"
    },
    {
      "t": 116.92,
      "text": "押し潰される様な痛みだって 身を攀じる程の悲しみだって",
      "ko": "오시츠부사레루 요-나 이타미닷테 미오 요지루 호도노 카나시미닷테"
    },
    {
      "t": 121.88,
      "text": "止められぬRampage",
      "ko": "토메라레누 Rampage"
    },
    {
      "t": 127.32,
      "text": "本能で踊れ 暴動を起こせ 今日も筆を取れ",
      "ko": "혼노-데 오도레 보-도-오 오코세 쿄-모 후데오 토레"
    },
    {
      "t": 134.77,
      "text": "煩悩を忘れるなよ",
      "ko": "본노-오 와스레루나요"
    },
    {
      "t": 136.89,
      "text": "本能で踊れ 暴動を起こせ 今日も筆を取れ",
      "ko": "혼노-데 오도레 보-도-오 오코세 쿄-모 후데오 토레"
    },
    {
      "t": 144.19,
      "text": "衝動の火を消すなよ",
      "ko": "쇼-도-노 히오 케스나요"
    },
    {
      "t": 146.58,
      "text": "本能で踊れ 暴動を起こせ 今日も筆を取れ",
      "ko": "혼노-데 오도레 보-도-오 오코세 쿄-모 후데오 토레"
    },
    {
      "t": 153.81,
      "text": "真実を恐れるな",
      "ko": "신지츠오 오소레루나"
    },
    {
      "t": 155.74,
      "text": "さァ、教祖を ×せ 共依存で行こうぜ",
      "ko": "사-, 쿄-소오 ×세 쿄-이존데 이코-제"
    },
    {
      "t": 160.52,
      "text": "この憂いが叫びが君の血肉に成れば、万々歳",
      "ko": "코노 우레이가 사케비가 키미노 치니쿠니 나레바, 반반자이"
    },
    {
      "t": 166.12,
      "text": "Banquet 奪い去って何処かへ",
      "ko": "Banquet 우바이삿테 도코카에"
    },
    {
      "t": 170.99,
      "text": "廃り流行りなんて通り越してしまえ",
      "ko": "스타리 하야리난테 토-리코시테 시마에"
    },
    {
      "t": 173.71,
      "text": "手を取って、挙って、踊って",
      "ko": "테오 톳테, 코좃테, 오돗테"
    },
    {
      "t": 175.76,
      "text": "Banquet ふたりだけでもっと深くへ",
      "ko": "Banquet 후타리다케데 못토 후카쿠에"
    },
    {
      "t": 180.85,
      "text": "堕ちられるとこまで、堕ちてやろうぜ果てまでも",
      "ko": "오치라레루 토코마데, 오치테 야로-제 하테마데모"
    },
    {
      "t": 185.46,
      "text": "喰らい尽くしてくれBanquet 歌い明かしてくれBanquet",
      "ko": "쿠라이츠쿠시테쿠레 Banquet 우타이아카시테쿠레 Banquet"
    },
    {
      "t": 190.76,
      "text": "流れる血の一滴まで飲み干して、欲して",
      "ko": "나가레루 치노 잇테키마데 노미호시테, 호시테"
    },
    {
      "t": 194.99,
      "text": "Banquet なァ、もっと俺を愛してくれ",
      "ko": "Banquet 나-, 못토 오레오 아이시테쿠레"
    },
    {
      "t": 199.53,
      "text": "最期を告げる一時まで、毎夜続く山羊の宴さ",
      "ko": "사이고오 츠게루 히토토키마데, 마이요 츠즈쿠 야기노 우타게사"
    },
    {
      "t": 204.52,
      "text": "君だけのBanquet",
      "ko": "키미다케노 Banquet"
    },
    {
      "t": 214.64,
      "text": "ご馳走様には、まだ早いぜ",
      "ko": "고치소-사마니와, 마다 하야이제"
    }
  ],
