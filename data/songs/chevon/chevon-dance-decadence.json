{
  "id": "chevon-dance-decadence",
  "artistId": "chevon",
  "title": "ダンス・デカダンス",
  "youtube": {
    "videoId": "nJ_jkiYmDR0",
    "offsetSec": 0
  },
  "lrclib": {
    "id": 25114523,
    "trackName": "ダンス・デカダンス - Dance Decadance",
    "artistName": "Chevon"
  },
  "durationSec": 202,
  "lines": [
    {
      "t": null,
      "text": "嗚呼、難解な世界なんです",
      "ko": "아-, 난카이나 세카이난데스"
    },
    {
      "t": null,
      "text": "どう考えてもそんなに上手に生きられないの",
      "ko": "도- 칸가에테모 손나니 조-즈니 이키라레나이노"
    },
    {
      "t": null,
      "text": "なんで？？",
      "ko": "난데??"
    },
    {
      "t": null,
      "text": "もう一挙手一投足の労すら勿体無いなんて",
      "ko": "모- 잇쿄슈잇토-소쿠노 로-스라 못타이나이난테"
    },
    {
      "t": null,
      "text": "思って、劣っていく、現状。",
      "ko": "오못테, 오톳테이쿠, 겐조-."
    },
    {
      "t": null,
      "text": "毎回、簡単な言い訳で",
      "ko": "마이카이, 칸탄나 이이와케데"
    },
    {
      "t": null,
      "text": "冴えない好意を抱いては泣いて",
      "ko": "사에나이 코-이오 이다이테와 나이테"
    },
    {
      "t": null,
      "text": "曖昧な息をして朝を待っていた",
      "ko": "아이마이나 이키오 시테 아사오 맛테이타"
    },
    {
      "t": null,
      "text": "あーーーー！！！！",
      "ko": "아----!!!!"
    },
    {
      "t": null,
      "text": "ツマンナイ思考になっちゃっている",
      "ko": "츠만나이 시코-니 낫챳테이루"
    },
    {
      "t": null,
      "text": "独りになっちゃっている",
      "ko": "히토리니 낫챳테이루"
    },
    {
      "t": null,
      "text": "救われてたいやいや",
      "ko": "스쿠와레테타이야이야"
    },
    {
      "t": null,
      "text": "誰がどうだって彼がどうだって",
      "ko": "다레가 도-닷테 카레가 도-닷테"
    },
    {
      "t": null,
      "text": "それがどうしたって啖呵切って",
      "ko": "소레가 도-시탓테 탄카 킷테"
    },
    {
      "t": null,
      "text": "言えなくて下らない",
      "ko": "이에나쿠테 쿠다라나이"
    },
    {
      "t": null,
      "text": "ツマンナイ大人になってきている",
      "ko": "츠만나이 오토나니 낫테키테이루"
    },
    {
      "t": null,
      "text": "人の目ばっか見ている",
      "ko": "히토노 메밧카 미테이루"
    },
    {
      "t": null,
      "text": "息ができないやいや",
      "ko": "이키가 데키나이야이야"
    },
    {
      "t": null,
      "text": "読んだ本だって暮れた今日だって",
      "ko": "욘다 혼닷테 쿠레타 쿄-닷테"
    },
    {
      "t": null,
      "text": "触れた頬だって冷たくなって",
      "ko": "후레타 호호닷테 츠메타쿠 낫테"
    },
    {
      "t": null,
      "text": "｢⋯こんなモンだ｣って夢は将来性を失ってゆく",
      "ko": "「…콘나 몬다」앗테 유메와 쇼-라이세-오 우시낫테 유쿠"
    },
    {
      "t": null,
      "text": "ああ。バイバイ だ、また来世。",
      "ko": "아-. 바이바이다, 마타 라이세-."
    },
    {
      "t": null,
      "text": "生存安牌で平坦な道を選んで歩いて",
      "ko": "세-존안파이데 헤-탄나 미치오 에란데 아루이테"
    },
    {
      "t": null,
      "text": "埋まらない距離を今日も歌っている",
      "ko": "우마라나이 쿄리오 쿄-모 우탓테이루"
    },
    {
      "t": null,
      "text": "(ｿﾚｼﾞｬｧﾀﾞﾚｶﾉｸｸﾞﾂｼﾞｬﾅｲｶ)",
      "ko": "(소레쟈- 다레카노 쿠구츠쟈 나이카)"
    },
    {
      "t": null,
      "text": "年齢相応に予定通り",
      "ko": "넨레-소-오-니 요테-도-리"
    },
    {
      "t": null,
      "text": "次第に死体が動いている様に笑って",
      "ko": "시다이니 시타이가 우고이테이루 요-니 와랏테"
    },
    {
      "t": null,
      "text": "平々凡々なロボットになってゆくんだ",
      "ko": "헤-헤-본본나 로봇토니 낫테 유쿤다"
    },
    {
      "t": null,
      "text": "ツマンナイ思考になっちゃっている",
      "ko": "츠만나이 시코-니 낫챳테이루"
    },
    {
      "t": null,
      "text": "独りになっちゃっている",
      "ko": "히토리니 낫챳테이루"
    },
    {
      "t": null,
      "text": "救われてたいやいや",
      "ko": "스쿠와레테타이야이야"
    },
    {
      "t": null,
      "text": "誰がどうだって彼がどうだって",
      "ko": "다레가 도-닷테 카레가 도-닷테"
    },
    {
      "t": null,
      "text": "それがどうしたって啖呵切って",
      "ko": "소레가 도-시탓테 탄카 킷테"
    },
    {
      "t": null,
      "text": "言えなくて下らない",
      "ko": "이에나쿠테 쿠다라나이"
    },
    {
      "t": null,
      "text": "ツマンナイ理想を描いちゃっている",
      "ko": "츠만나이 리소-오 에가이챳테이루"
    },
    {
      "t": null,
      "text": "｢普通｣に特化している",
      "ko": "「후츠-」니 톡카시테이루"
    },
    {
      "t": null,
      "text": "心踊らないやいや",
      "ko": "코코로 오도라나이야이야"
    },
    {
      "t": null,
      "text": "本当になったって、嘘になったって",
      "ko": "혼토-니 낫탓테, 우소니 낫탓테"
    },
    {
      "t": null,
      "text": "壊れたって元に戻ったってどうでもいいよ。",
      "ko": "코와레탓테 모토니 모돗탓테 도-데모 이-요."
    },
    {
      "t": null,
      "text": "ずっとそうやって生きてゆくのなら",
      "ko": "즛토 소-얏테 이키테 유쿠노나라"
    },
    {
      "t": null,
      "text": "ああ。バイバイ だ、待てないぜ。",
      "ko": "아-. 바이바이다, 마테나이제."
    },
    {
      "t": null,
      "text": "相対した未来の僕はどう映っていますか。",
      "ko": "소-타이시타 미라이노 보쿠와 도- 우츳테이마스카."
    },
    {
      "t": null,
      "text": "どっちを向いたって落っこちそうになっているんだ",
      "ko": "돗치오 무이탓테 옷코치소-니 낫테이룬다"
    },
    {
      "t": null,
      "text": "故にバイバイ",
      "ko": "유에니 바이바이"
    },
    {
      "t": null,
      "text": "遠ざかって消える車窓をずっと見ている",
      "ko": "토-자캇테 키에루 샤소-오 즛토 미테이루"
    },
    {
      "t": null,
      "text": "前を向けないやいや",
      "ko": "마에오 무케나이야이야"
    },
    {
      "t": null,
      "text": "ありがとう。それじゃ、さよなら",
      "ko": "아리가토-. 소레쟈, 사요나라"
    },
    {
      "t": null,
      "text": "そんなことを何回も繰り返したって",
      "ko": "손나 코토오 난카이모 쿠리카에시탓테"
    },
    {
      "t": null,
      "text": "後に何が残るのだろう",
      "ko": "아토니 나니가 노코루노다로-"
    },
    {
      "t": null,
      "text": "踊ってくれ、踊っておくれよ僕の歌で",
      "ko": "오돗테쿠레, 오돗테오쿠레요 보쿠노 우타데"
    },
    {
      "t": null,
      "text": "なあ、｢ここだよ｣って教えて",
      "ko": "나-, 「코코다요」앗테 오시에테"
    },
    {
      "t": null,
      "text": "君だけが愛やいや",
      "ko": "키미다케가 아이야이야"
    },
    {
      "t": null,
      "text": "生まれ変わったって、鳥になったって",
      "ko": "우마레카왓탓테, 토리니 낫탓테"
    },
    {
      "t": null,
      "text": "虫になったって、草になったって",
      "ko": "무시니 낫탓테, 쿠사니 낫탓테"
    },
    {
      "t": null,
      "text": "僕はずっと君だけに命を賭すのだろう",
      "ko": "보쿠와 즛토 키미다케니 이노치오 토스노다로-"
    },
    {
      "t": null,
      "text": "ああ、踊ってくれ来世でも。僕の歌で",
      "ko": "아-, 오돗테쿠레 라이세-데모. 보쿠노 우타데"
    }
  ],
