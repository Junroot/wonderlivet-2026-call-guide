  "lines": [
    {
      "t": null,
      "text": "ゲルニカ",
      "ko": "게루니카"
    },
    {
      "t": null,
      "text": "もう誰を信じればいいの",
      "ko": "모- 다레오 신지레바 이-노"
    },
    {
      "t": null,
      "text": "共感が正義?",
      "ko": "쿄-칸가 세-기?"
    },
    {
      "t": null,
      "text": "無知蒙昧気付かず",
      "ko": "무치모-마이 키즈카즈"
    },
    {
      "t": null,
      "text": "善意を吐いて",
      "ko": "젠이오 하이테"
    },
    {
      "t": null,
      "text": "私を指差した",
      "ko": "와타시오 유비사시타"
    },
    {
      "t": null,
      "text": "ディケーは糾弾し",
      "ko": "디케-와 큐-단시"
    },
    {
      "t": null,
      "text": "全ての努力はもう",
      "ko": "스베테노 도료쿠와 모-"
    },
    {
      "t": null,
      "text": "焼べられ焦げていく",
      "ko": "쿠베라레 코게테 이쿠"
    },
    {
      "t": null,
      "text": "「正義振り翳せ",
      "ko": "「세-기 후리카자세"
    },
    {
      "t": null,
      "text": "悪意より高く」",
      "ko": "아쿠이요리 타카쿠」"
    },
    {
      "t": null,
      "text": "悲劇で肥やした",
      "ko": "히게키데 코야시타"
    },
    {
      "t": null,
      "text": "お前じゃ",
      "ko": "오마에쟈"
    },
    {
      "t": null,
      "text": "つまんないね",
      "ko": "츠만나이네"
    },
    {
      "t": null,
      "text": "ゲルニカ戯けた理想像で",
      "ko": "게루니카 오도케타 리소-조-데"
    },
    {
      "t": null,
      "text": "バラバラに砕け散る人生なんです",
      "ko": "바라바라니 쿠다케치루 진세- 난데스"
    },
    {
      "t": null,
      "text": "痛んで分け合った致命傷で",
      "ko": "이탄데 와케앗타 치메-쇼-데"
    },
    {
      "t": null,
      "text": "怪物になって撃ち抜いて",
      "ko": "카이부츠니 낫테 우치누이테"
    },
    {
      "t": null,
      "text": "Whoa, whoa",
      "ko": null
    },
    {
      "t": null,
      "text": "瘡蓋分だけ優しさを分かっていたいよ",
      "ko": "카사부타 분다케 야사시사오 와캇테 이타이요"
    },
    {
      "t": null,
      "text": "Whoa, whoa",
      "ko": null
    },
    {
      "t": null,
      "text": "言葉の弾丸で君の心乗っ取ろうか?",
      "ko": "코토바노 단간데 키미노 코코로 놋토로-카?"
    },
    {
      "t": null,
      "text": "再放送中のシーンでまた",
      "ko": "사이호-소-츄-노 신-데 마타"
    },
    {
      "t": null,
      "text": "シャーデンフロイデ過多",
      "ko": "샤-덴후로이데 카타"
    },
    {
      "t": null,
      "text": "生まれた街が灰色になる",
      "ko": "우마레타 마치가 하이이로니 나루"
    },
    {
      "t": null,
      "text": "その頃にはここに何があったのかすらも分からずいる",
      "ko": "소노 코로니와 코코니 나니가 앗타노카스라모 와카라즈 이루"
    },
    {
      "t": null,
      "text": "まだ大衆派のフリして",
      "ko": "마다 타이슈-하노 후리시테"
    },
    {
      "t": null,
      "text": "\"正論\"とか語尾捉えて",
      "ko": "\"세-론\"토카 고비 토라에테"
    },
    {
      "t": null,
      "text": "君を知ってしまったら",
      "ko": "키미오 싯테 시맛타라"
    },
    {
      "t": null,
      "text": "少しトドメ刺しづらいの",
      "ko": "스코시 토도메 사시즈라이노"
    },
    {
      "t": null,
      "text": "「正義振り翳せ",
      "ko": "「세-기 후리카자세"
    },
    {
      "t": null,
      "text": "悪意より高く」",
      "ko": "아쿠이요리 타카쿠」"
    },
    {
