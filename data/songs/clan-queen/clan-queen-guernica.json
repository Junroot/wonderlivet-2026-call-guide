    },
    {
      "t": null,
      "text": "こんな苦しい思いするのなら",
      "ko": "콘나 쿠루시- 오모이 스루노나라"
    },
    {
      "t": null,
      "text": "他人なんか理解しようとしなかった",
      "ko": "타닌난카 리카이 시요-토 시나캇타"
    },
    {
      "t": null,
      "text": "自分自身の輪郭ですら",
      "ko": "지분 지신노 린카쿠데스라"
    },
    {
      "t": null,
      "text": "救えない救えない救えない",
