  "durationSec": 232.19,
  "lines": [
    {
      "t": null,
      "text": "ぶっ飛んじゃってる 自意識過剰",
      "ko": "붓톤쟛테루 지이시키 카죠-"
    },
    {
      "t": null,
      "text": "自分守る為 過剰包装",
      "ko": "지분 마모루 타메 카죠- 호-소-"
    },
    {
      "t": null,
      "text": "知ったっ気に 神のまにまに",
      "ko": "싯탓 키니 카미노 마니마니"
    },
    {
      "t": null,
      "text": "自尊守る為 生きる塊",
      "ko": "지손 마모루 타메 이키루 카타마리"
    },
    {
      "t": null,
      "text": "奇怪 (きっかい) CITY",
      "ko": "킷카이 CITY"
    },
    {
      "t": null,
      "text": "離れない霧 灰色の幹に",
      "ko": "하나레나이 키리 하이이로노 미키니"
    },
    {
      "t": null,
      "text": "眩暈卒倒 (めまいそっとう)",
      "ko": "메마이 솟토-"
    },
    {
      "t": null,
      "text": "行ったり来たりしている間にも もう1人の自分が登場",
      "ko": "잇타리 키타리 시테이루 아이다니모 모- 히토리노 지분가 토-죠-"
    },
    {
      "t": null,
      "text": "正直言うとね本当は",
      "ko": "쇼-지키 이우토네 혼토-와"
    },
    {
      "t": null,
      "text": "人に期待なんかしていませんし",
      "ko": "히토니 키타이난카 시테이마센시"
    },
    {
      "t": null,
      "text": "正直言うとね本当は 全部演じてんだよ",
      "ko": "쇼-지키 이우토네 혼토-와 젠부 엔지텐다요"
    },
    {
      "t": null,
      "text": "ねぇ誰か",
      "ko": "네- 다레카"
    },
    {
      "t": null,
      "text": "聞こえないか？",
      "ko": "키코에나이카?"
    },
    {
      "t": null,
      "text": "ここは脳下垂体の森林か？",
      "ko": "코코와 노-카스이타이노 신린카?"
    },
    {
      "t": null,
      "text": "まぁ",
      "ko": "마-"
    },
    {
      "t": null,
      "text": "逃げ出せない",
      "ko": "니게다세나이"
    },
    {
      "t": null,
      "text": "まぁ 逃げ出せ",
      "ko": "마- 니게다세"
    },
    {
      "t": null,
      "text": "もう",
      "ko": "모-"
    },
    {
      "t": null,
      "text": "客観って気づいて 自分を操作中です",
      "ko": "캿칸테 키즈이테 지분오 소-사츄-데스"
    },
    {
      "t": null,
      "text": "現状",
      "ko": "겐죠-"
    },
    {
      "t": null,
      "text": "Aボタン連打連打中 快調です",
      "ko": "에-보탄 렌다 렌다츄- 카이쵸-데스"
    },
    {
      "t": null,
      "text": "でも感情の 制御反動 すらも メタ認知",
      "ko": "데모 칸죠-노 세-교 한도- 스라모 메타닌치"
    },
    {
      "t": null,
      "text": "どこか知らないこの 期待すらも賽を",
      "ko": "도코카 시라나이 코노 키타이스라모 사이오"
    },
    {
      "t": null,
      "text": "投げたいくらいの滞納 誰かしら対応してくれよ",
      "ko": "나게타이 쿠라이노 타이노- 다레카시라 타이오- 시테 쿠레요"
    },
    {
      "t": null,
      "text": "純粋でいたいだけです",
      "ko": "쥰스이데 이타이 다케데스"
    },
    {
      "t": null,
      "text": "もう、知りたく無くて",
      "ko": "모-, 시리타쿠 나쿠테"
    },
    {
      "t": null,
      "text": "それが君にとっての 悪でも構わないです",
      "ko": "소레가 키미니 톳테노 아쿠데모 카마와나이데스"
    },
    {
      "t": null,
      "text": "さよなら 最低な五臓 掻い出して",
      "ko": "사요나라 사이테-나 고조- 카이다시테"
    },
    {
      "t": null,
      "text": "真っ黒に なった心を 漂白して",
      "ko": "맛쿠로니 낫타 코코로오 효-하쿠시테"
    },
    {
      "t": null,
      "text": "絡まる 最低な脳を 掻い出して",
      "ko": "카라마루 사이테-나 노-오 카이다시테"
    },
    {
      "t": null,
      "text": "ベッタリ絡んだ フォークロア 問いだして",
      "ko": "벳타리 카란다 포-쿠로아 토이다시테"
    },
    {
      "t": null,
      "text": "自白",
      "ko": "지하쿠"
    },
    {
      "t": null,
      "text": "知識の実を食べた途端から 後には戻れないの lalala",
      "ko": "치시키노 미오 타베타 토탄카라 아토니와 모도레나이노 lalala"
    },
    {
      "t": null,
      "text": "知ってしまった途端からもう 焼き付いて 消えぬ構造",
      "ko": "싯테 시맛타 토탄카라 모- 야키츠이테 키에누 코-조-"
    },
    {
      "t": null,
      "text": "サンタクロースの正体も 彼の心境も",
      "ko": "산타쿠로-스노 쇼-타이모 카레노 신쿄-모"
    },
    {
      "t": null,
      "text": "地球の賞味期限すら 知りたく無かった",
      "ko": "치큐-노 쇼-미키겐스라 시리타쿠 나캇타"
    },
    {
      "t": null,
      "text": "知らないまま",
      "ko": "시라나이 마마"
    },
    {
      "t": null,
      "text": "死んでみたかった",
      "ko": "신데 미타캇타"
    },
    {
      "t": null,
      "text": "もう十分です この世には 存在価値が",
      "ko": "모- 쥬-분데스 코노 요니와 손자이 카치가"
    },
    {
      "t": null,
      "text": "狂ってるほど 高騰中です そうですか",
      "ko": "쿠룻테루호도 코-토-츄-데스 소-데스카"
    },
    {
      "t": null,
      "text": "人類が付けた 価値なんかどうも",
      "ko": "진루이가 츠케타 카치난카 도-모"
    },
    {
      "t": null,
      "text": "笑えてくるほど 無意味な指標 でしょ？",
      "ko": "와라에테 쿠루호도 무이미나 시효- 데쇼?"
    },
    {
      "t": null,
      "text": "純粋でいたいだけです",
      "ko": "쥰스이데 이타이 다케데스"
    },
    {
      "t": null,
      "text": "もう、知りたく無くて",
      "ko": "모-, 시리타쿠 나쿠테"
    },
    {
      "t": null,
      "text": "それが君にとっての 悪でも構わないです",
      "ko": "소레가 키미니 톳테노 아쿠데모 카마와나이데스"
    },
    {
      "t": null,
      "text": "さよなら 最低な五臓 掻い出して",
      "ko": "사요나라 사이테-나 고조- 카이다시테"
    },
    {
      "t": null,
      "text": "真っ黒に なった心を 漂白して",
      "ko": "맛쿠로니 낫타 코코로오 효-하쿠시테"
    },
    {
      "t": null,
      "text": "絡まる 最低な脳を 掻い出して",
      "ko": "카라마루 사이테-나 노-오 카이다시테"
    },
    {
      "t": null,
      "text": "ベッタリ絡んだ フォークロア 飛び出して",
      "ko": "벳타리 카란다 포-쿠로아 토비다시테"
    },
    {
      "t": null,
      "text": "邪悪",
      "ko": "쟈아쿠"
    },
    {
      "t": null,
      "text": "自分は、そう きっと 強い人間と",
      "ko": "지분와, 소- 킷토 츠요이 닌겐토"
    },
    {
      "t": null,
      "text": "思っていたんです",
      "ko": "오못테 이탄데스"
    },
    {
      "t": null,
      "text": "でもそうじゃ無かったよ",
      "ko": "데모 소-쟈 나캇타요"
    },
    {
      "t": null,
      "text": "泣いたってそんな 代わりはいなくて",
      "ko": "나이탓테 손나 카와리와 이나쿠테"
    },
    {
      "t": null,
      "text": "今いる これが私",
      "ko": "이마 이루 코레가 와타시"
    },
    {
      "t": null,
      "text": "純粋でいたいだけです",
      "ko": "쥰스이데 이타이 다케데스"
    },
    {
      "t": null,
      "text": "もう、知りたく無くて",
