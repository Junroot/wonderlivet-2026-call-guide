  "lines": [
    {
      "t": 2.45,
      "text": "凡才じゃ何も救えないの？",
      "ko": "본사이쟈 나니모 스쿠에나이노?"
    },
    {
      "t": 5.52,
      "text": "身に余った その飾りに",
      "ko": "미니 아맛타 소노 카자리니"
    },
    {
      "t": 7.61,
      "text": "呑まれて 憂さ晴らし？",
      "ko": "노마레테 우사바라시?"
    },
    {
      "t": 10.12,
      "text": "偏見じゃ誰も救えないよ",
      "ko": "헨켄쟈 다레모 스쿠에나이요"
    },
    {
      "t": 13.39,
      "text": "なら馬鹿な 私にも常識を",
      "ko": "나라 바카나 와타시니모 죠-시키오"
    },
    {
      "t": 16.47,
      "text": "教えてよ",
      "ko": "오시에테요"
    },
    {
      "t": 19.16,
      "text": "眩暈がするほど",
      "ko": "메마이가 스루호도"
    },
    {
      "t": 23.14,
      "text": "壊れそうな心を",
      "ko": "코와레소-나 코코로오"
    },
    {
      "t": 27.02,
      "text": "手を伸ばす声と",
      "ko": "테오 노바스 코에토"
    },
    {
      "t": 29.36,
      "text": "私が放つそんな 言葉に",
      "ko": "와타시가 하나츠 손나 코토바니"
    },
    {
      "t": 32.9,
      "text": "乱れてる",
      "ko": "미다레테루"
    },
    {
      "t": 33.68,
      "text": "メーデーメーデー 誰にだって",
      "ko": "메-데- 메-데- 다레니닷테"
    },
    {
      "t": 35.46,
      "text": "メーデーメーデー 手を握って",
      "ko": "메-데- 메-데- 테오 니깃테"
    },
    {
      "t": 37.39,
      "text": "最上級の愛を頂戴よ もう一回",
      "ko": "사이죠-큐-노 아이오 쵸-다이요 모- 잇카이"
    },
    {
      "t": 40.75,
      "text": "乱れてる",
      "ko": "미다레테루"
    },
    {
      "t": 41.39,
      "text": "メーデーメーデー 誰にだって",
      "ko": "메-데- 메-데- 다레니닷테"
    },
    {
      "t": 43.13,
      "text": "メーデーメーデー 手を握って",
      "ko": "메-데- 메-데- 테오 니깃테"
    },
    {
      "t": 45.16,
      "text": "反則級の 言葉で魅せて",
      "ko": "한소쿠큐-노 코토바데 미세테"
    },
    {
      "t": 64.87,
      "text": "どうか 知った気に なるなよ感情",
      "ko": "도-카 싯타 키니 나루나요 칸죠-"
    },
    {
      "t": 66.81,
      "text": "ロールシャッハみたいな この現状",
      "ko": "로-루샷하 미타이나 코노 겐죠-"
    },
    {
      "t": 68.76,
      "text": "自己相似性 君の尺度で 図られる",
      "ko": "지코소-지세- 키미노 샤쿠도데 하카라레루"
    },
    {
      "t": 72.15,
      "text": "もう優しい人 見当たらない",
      "ko": "모- 야사시- 히토 미아타라나이"
    },
    {
      "t": 74.43,
      "text": "誰も彼も 利己主義らしい",
      "ko": "다레모 카레모 리코슈기라시-"
    },
    {
