  },
  "lrclib": {
    "id": 21830447,
    "trackName": "砂寸奏",
    "artistName": "MyGO!!!!!"
  },
  "durationSec": 226,
  "lines": [
    {
      "t": 38.87,
      "text": "同じ音符を追いかけるのに",
      "ko": "오나지 온푸오 오이카케루노니"
    },
    {
      "t": 44.1,
      "text": "昨日とは何かが 違うみたいだ",
      "ko": "키노-토와 나니카가 치가우 미타이다"
    },
    {
      "t": 49.19,
      "text": "止まらないよね砂時計",
      "ko": "토마라나이요네 스나도케이"
    },
    {
      "t": 51.66,
      "text": "サラサラこぼれ落ちてく",
      "ko": "사라사라 코보레오치테쿠"
    },
    {
      "t": 54.88,
      "text": "1秒前の僕はもういない",
      "ko": "이치뵤-마에노 보쿠와 모- 이나이"
    },
    {
      "t": 59.67,
      "text": "彷徨する渇望",
      "ko": "호-코-스루 카츠보-"
    },
    {
      "t": 65.22,
      "text": "もう止めないで",
      "ko": "모- 토메나이데"
    },
    {
      "t": 69.52,
      "text": "いいよね",
      "ko": "이이요네"
    },
    {
      "t": 70.37,
      "text": "たった今 今にしか さわれない",
      "ko": "탓타 이마 이마니시카 사와레나이"
    },
    {
      "t": 75.37,
      "text": "(Ooh-whoa, ooh-whoa)",
      "ko": null
    },
    {
      "t": 78.04,
      "text": "ぐるりの音",
      "ko": "구루리노 오토"
    },
    {
      "t": 79.97,
      "text": "君と 持ち寄ったこの鼓動が現在地",
      "ko": "키미토 모치욧타 코노 코도-가 겐자이치"
    },
    {
      "t": 85.31,
      "text": "揺らせ (ooh-whoa, ooh-whoa)",
      "ko": "유라세 (ooh-whoa, ooh-whoa)"
    },
    {
      "t": 88.46,
      "text": "旅人のように うたからうたへ",
      "ko": "타비비토노 요-니 우타카라 우타에"
    },
    {
      "t": 97.08,
      "text": "乾いた喉が 掠れる声が",
      "ko": "카와이타 노도가 카스레루 코에가"
    },
    {
      "t": 102.36,
      "text": "絞り出してた咆哮 この身に刻む",
      "ko": "시보리다시테타 호-코- 코노 미니 키자무"
    },
    {
      "t": 107.15,
      "text": "方向感覚 見失う",
      "ko": "호-코-칸카쿠 미우시나우"
    },
    {
      "t": 109.73,
      "text": "さかさま 宇宙に転がって",
      "ko": "사카사마 소라니 코로갓테"
    },
    {
      "t": 112.94,
      "text": "手を伸ばしたものはなんだった？",
      "ko": "테오 노바시타 모노와 난닷타?"
    },
    {
      "t": 117.4,
      "text": "過去も未来も",
      "ko": "카코모 미라이모"
    },
    {
      "t": 121.48,
      "text": "見えないくらい",
      "ko": "미에나이 쿠라이"
    },
    {
      "t": 123.04,
      "text": "たった今 今にしか 叫べない",
      "ko": "탓타 이마 이마니시카 사케베나이"
    },
    {
      "t": 128.09,
      "text": "(Ooh-whoa, ooh-whoa)",
      "ko": null
    },
    {
      "t": 130.83,
      "text": "感情ごと",
      "ko": "칸죠-고토"
    },
    {
      "t": 132.69,
      "text": "放て 足跡 砂風が隠しても",
      "ko": "하나테 아시아토 스나카제가 카쿠시테모"
    },
    {
      "t": 137.91,
      "text": "決して (ooh-whoa, ooh-whoa)",
      "ko": "켓시테 (ooh-whoa, ooh-whoa)"
    },
    {
      "t": 141.37,
      "text": "消えないうたを 道連れにして",
      "ko": "키에나이 우타오 미치즈레니 시테"
    },
    {
      "t": 154.95,
      "text": "僕らに降り注ぐ",
      "ko": "보쿠라니 후리소소구"
    },
    {
      "t": 157.66,
      "text": "時の粒つかまえ",
      "ko": "토키노 츠부 츠카마에"
    },
    {
      "t": 160.22,
      "text": "握りしめた熱を",
      "ko": "니기리시메타 네츠오"
    },
    {
      "t": 162.16,
      "text": "轟かせて",
      "ko": "토도로카세테"
    },
    {
      "t": 175.73,
      "text": "今日に馳せても",
      "ko": "쿄-니 하세테모"
    },
    {
      "t": 182.82,
      "text": "いいよね",
      "ko": "이이요네"
    },
    {
      "t": 183.64,
      "text": "たった今 今にしか さわれない",
      "ko": "탓타 이마 이마니시카 사와레나이"
    },
    {
      "t": 188.7,
      "text": "(Ooh-whoa, ooh-whoa)",
      "ko": null
    },
    {
      "t": 191.5,
      "text": "生きてる音",
      "ko": "이키테루 오토"
    },
    {
      "t": 193.51,
      "text": "君と 持ち寄った1秒をあたためて",
      "ko": "키미토 모치욧타 이치뵤-오 아타타메테"
    },
    {
      "t": 198.52,
      "text": "鳴らせ (ooh-whoa, ooh-whoa)",
      "ko": "나라세 (ooh-whoa, ooh-whoa)"
    },
    {
      "t": 201.93,
      "text": "旅人のように 泡沫に舞え",
      "ko": "타비비토노 요-니 우타카타니 마에"
    },
    {
      "t": 209.29,
      "text": "うたからうたへ",
      "ko": "우타카라 우타에"
    }
  ],
