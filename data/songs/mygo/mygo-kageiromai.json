  "durationSec": 211.07,
  "lines": [
    {
      "t": 17.52,
      "text": "あと一匙の憂鬱で",
      "ko": "아토 히토사지노 유-우츠데"
    },
    {
      "t": 20.75,
      "text": "壊れそうなんて",
      "ko": "코와레소-난테"
    },
    {
      "t": 23.07,
      "text": "のたまえど おかまいなく 記憶域",
      "ko": "노타마에도 오카마이나쿠 키오쿠이키"
    },
    {
      "t": 26.68,
      "text": "圧されてしまう",
      "ko": "오사레테 시마우"
    },
    {
      "t": 29.1,
      "text": "躓いては 縋っていた",
      "ko": "츠마즈이테와 스갓테이타"
    },
    {
      "t": 32.39,
      "text": "未検証フィロソフィー",
      "ko": "미켄쇼- 피로소피-"
    },
    {
      "t": 34.63,
      "text": "己さえ ごまかせない チープな理論武装",
      "ko": "오노레사에 고마카세나이 치-푸나 리론부소-"
    },
    {
      "t": 40.72,
      "text": "答えが出るまでとか",
      "ko": "코타에가 데루마데토카"
    },
    {
      "t": 43.88,
      "text": "イコール未来永劫",
      "ko": "이코-루 미라이에-고-"
    },
    {
      "t": 46.38,
      "text": "とめどない思考回路を",
      "ko": "토메도나이 시코-카이로오"
    },
    {
      "t": 49.41,
      "text": "誰か ねえ止めて",
      "ko": "다레카 네- 토메테"
    },
    {
      "t": 54.1,
      "text": "もうなにもかも 忘れて",
      "ko": "모- 나니모카모 와스레테"
    },
    {
      "t": 56.77,
      "text": "今宵は シルエットダンス",
      "ko": "코요이와 시루엣토단스"
    },
    {
      "t": 60.04,
      "text": "知らない 要らない 全然",
      "ko": "시라나이 이라나이 젠젠"
    },
    {
      "t": 61.46,
      "text": "なんの法則もなく ただ舞って舞う (今日を称えて)",
      "ko": "난노 호-소쿠모나쿠 타다 맛테 마우 (쿄-오 타타에테)"
    },
    {
      "t": 65.83,
      "text": "照明一切を消しちゃって",
      "ko": "쇼-메- 잇사이오 케시챳테"
    },
    {
      "t": 68.56,
      "text": "さあ 宇宙へとリンク",
      "ko": "사- 우츄-에토 링쿠"
    },
    {
      "t": 70.66,
      "text": "ビートに呼応して浮かび上がる",
      "ko": "비-토니 코오-시테 우카비아가루"
    },
    {
      "t": 74.08,
      "text": "超然的シルエットダンス",
      "ko": "쵸-젠테키 시루엣토단스"
    },
    {
      "t": 88.98,
      "text": "音の中に溶けていく",
      "ko": "오토노 나카니 토케테이쿠"
    },
    {
      "t": 92.36,
      "text": "僕のリアリティー",
      "ko": "보쿠노 리아리티-"
    },
    {
      "t": 94.57,
      "text": "感傷も 焦燥も 粉々に",
      "ko": "칸쇼-모 쇼-소-모 코나고나니"
    },
    {
      "t": 98.16,
      "text": "ちりぬる模様",
      "ko": "치리누루 모요-"
    },
    {
      "t": 100.62,
      "text": "五臓六腑に響いちゃって",
      "ko": "고조-롯푸니 히비이챳테"
    },
    {
      "t": 103.72,
      "text": "脈打つメロディライン",
      "ko": "먀쿠우츠 메로디라인"
    },
    {
      "t": 106.25,
      "text": "この僕を 駆け巡る",
      "ko": "코노 보쿠오 카케메구루"
    },
    {
      "t": 108.45,
      "text": "流星が跳ねる",
      "ko": "류-세-가 하네루"
    },
    {
      "t": 112.09,
      "text": "呼吸音と重なってく",
      "ko": "코큐-온토 카사낫테쿠"
    },
    {
      "t": 115.55,
      "text": "リズムの波に",
      "ko": "리즈무노 나미니"
    },
    {
      "t": 117.99,
      "text": "任せて揺れていたい",
      "ko": "마카세테 유레테이타이"
    },
    {
      "t": 121.03,
      "text": "それだけでいいよ",
      "ko": "소레다케데 이이요"
    },
    {
      "t": 124.28,
      "text": "飛び込んだなら そこはもう",
      "ko": "토비콘다나라 소코와 모-"
    },
    {
      "t": 127.14,
      "text": "無重力 浮遊してダンス",
      "ko": "무쥬-료쿠 후유-시테 단스"
    },
    {
      "t": 130.19,
      "text": "意味ない 間違い 全然",
      "ko": "이미나이 마치가이 젠젠"
    },
    {
      "t": 131.56,
      "text": "気にも とめないで 舞って 舞って 舞う (直感を盲信)",
      "ko": "키니모 토메나이데 맛테 맛테 마우 (춋칸오 모-신)"
    },
    {
      "t": 135.74,
      "text": "何一つ生み出さない",
      "ko": "나니히토츠 우미다사나이"
    },
    {
      "t": 138.77,
      "text": "ああ 透明な自由",
      "ko": "아- 토-메-나 지유-"
    },
    {
      "t": 140.77,
      "text": "全部リセットで 空っぽになれたら",
      "ko": "젠부 리셋토데 카랍포니 나레타라"
    },
    {
      "t": 158.45,
      "text": "宇宙をクラウドにして",
      "ko": "우츄-오 쿠라우도니 시테"
    },
    {
      "t": 161.77,
      "text": "預けてしまえ",
      "ko": "아즈케테 시마에"
    },
    {
      "t": 164.07,
      "text": "すべて",
      "ko": "스베테"
    },
    {
      "t": 170.46,
      "text": "もうなにもかも 忘れて",
      "ko": "모- 나니모카모 와스레테"
    },
    {
      "t": 172.96,
      "text": "今宵は シルエットダンス",
      "ko": "코요이와 시루엣토단스"
    },
    {
      "t": 176.53,
      "text": "知らない 要らない 全然",
      "ko": "시라나이 이라나이 젠젠"
    },
    {
      "t": 177.99,
      "text": "なんの法則もなく ただ舞って舞う (今日を称えて)",
      "ko": "난노 호-소쿠모나쿠 타다 맛테 마우 (쿄-오 타타에테)"
    },
    {
      "t": 182.04,
      "text": "金輪際誰も知らない夜",
      "ko": "콘린자이 다레모 시라나이 요루"
    },
    {
      "t": 185.55,
      "text": "僕の夜",
      "ko": "보쿠노 요루"
    },
    {
      "t": 187.25,
      "text": "星あかり纏うも あはれ",
      "ko": "호시아카리 마토우모 아와레"
    },
    {
      "t": 190.38,
      "text": "前衛的シルエットダンス",
      "ko": "젠에-테키 시루엣토단스"
    }
  ],
