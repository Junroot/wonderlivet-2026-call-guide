  },
  "lrclib": {
    "id": 36843921,
    "trackName": "往欄印",
    "artistName": "MyGO!!!!!"
  },
  "durationSec": 298,
  "lines": [
    {
      "t": 24.38,
      "text": "分厚く巻いた緩衝材の中",
      "ko": "부아츠쿠 마이타 칸쇼-자이노 나카"
    },
    {
      "t": 26.55,
      "text": "僕は僕を守ろうとした",
      "ko": "보쿠와 보쿠오 마모로-토 시타"
    },
    {
      "t": 29.03,
      "text": "それは 壊れやすいものなんだって",
      "ko": "소레와 코와레야스이 모노난닷테"
    },
    {
      "t": 32.12,
      "text": "張り巡らした予防線",
      "ko": "하리메구라시타 요보-센"
    },
    {
      "t": 34.53,
      "text": "ズンズンと振動に突き動かされて",
      "ko": "즌즌토 신도-니 츠키우고카사레테"
    },
    {
      "t": 36.99,
      "text": "一枚 また一枚と振り落ちた",
      "ko": "이치마이 마타 이치마이토 후리오치타"
    },
    {
      "t": 39.87,
      "text": "安心する場所から顔を出して",
      "ko": "안신스루 바쇼카라 카오오 다시테"
    },
    {
      "t": 41.95,
      "text": "僕は僕に 傷つくことを許した",
      "ko": "보쿠와 보쿠니 키즈츠쿠 코토오 유루시타"
    },
    {
      "t": 45.75,
      "text": "ここからじゃなきゃ見えない気がしたんだ",
      "ko": "코코카라쟈나캬 미에나이 키가 시탄다"
    },
    {
      "t": 48.32,
      "text": "手すりの無い端っこに立って",
      "ko": "테스리노 나이 핫코니 탓테"
    },
    {
      "t": 50.06,
      "text": "些細な風にバランスを崩しながら",
      "ko": "사사이나 카제니 바란스오 쿠즈시나가라"
    },
    {
      "t": 52.31,
      "text": "それでも伝い歩いていく",
      "ko": "소레데모 츠타이 아루이테이쿠"
    },
    {
      "t": 55.09,
      "text": "いまたしかに僕をかたどる（かたどる）",
      "ko": "이마 타시카니 보쿠오 카타도루 (카타도루)"
    },
    {
      "t": 60.07,
      "text": "心のはしに ひらひら晒されてる",
      "ko": "코코로노 하시니 히라히라 사라사레테루"
    },
    {
      "t": 65.08,
      "text": "君から僕のすがたが見えるように（ここから）",
      "ko": "키미카라 보쿠노 스가타가 미에루요-니 (코코카라)"
    },
    {
      "t": 71.05,
      "text": "途切れずに焚べて歩こう 目印のうた",
      "ko": "토기레즈니 쿠베테 아루코- 메지루시노 우타"
    },
    {
      "t": 80.78,
      "text": "（どこまでも）",
      "ko": "(도코마데모)"
    },
    {
      "t": 88.52,
      "text": "思いがけず近づいて",
      "ko": "오모이가케즈 치카즈이테"
    },
    {
      "t": 90.95,
      "text": "見えかけた君への入口",
      "ko": "미에카케타 키미에노 이리구치"
    },
    {
      "t": 93.86,
      "text": "ひとつなぎの橋をかけて",
      "ko": "히토츠나기노 하시오 카케테"
    },
    {
      "t": 96.51,
      "text": "その気持ちを知りたかった",
      "ko": "소노 키모치오 시리타캇타"
    },
    {
      "t": 99.16,
      "text": "だけど 打ち明けてくれた苦しみに",
      "ko": "다케도 우치아케테쿠레타 쿠루시미니"
    },
    {
      "t": 101.96,
      "text": "僕は答えを持ち合わせていない",
      "ko": "보쿠와 코타에오 모치아와세테이나이"
    },
    {
      "t": 103.94,
      "text": "きっと言うべき何かを",
      "ko": "킷토 이우베키 나니카오"
    },
    {
      "t": 105.29,
      "text": "見つけられなくて 押し黙る",
      "ko": "미츠케라레나쿠테 오시다마루"
    },
    {
      "t": 109.64,
      "text": "君はどうしてほしい？僕に何が言えるんだろう",
      "ko": "키미와 도-시테 호시이? 보쿠니 나니가 이에룬다로-"
    },
    {
      "t": 112.89,
      "text": "いつだってそれがはじめてで 考え込んでしまう",
      "ko": "이츠닷테 소레가 하지메테데 칸가에콘데 시마우"
    },
    {
      "t": 115.13,
      "text": "だけどもし届かなくたって",
      "ko": "다케도 모시 토도카나쿠탓테"
    },
    {
      "t": 117.05,
      "text": "それでもやっぱり届けたいんだ",
      "ko": "소레데모 얏파리 토도케타인다"
    },
    {
      "t": 119.18,
      "text": "今音に導かれるように（導き）",
      "ko": "이마 오토니 미치비카레루요-니 (미치비키)"
    },
    {
      "t": 124.06,
      "text": "心のはしは君を目指してのびる",
      "ko": "코코로노 하시와 키미오 메자시테 노비루"
    },
    {
      "t": 129.03,
      "text": "踏み外しそうで まだ怖いままだけど（君へと）",
      "ko": "후미하즈시소-데 마다 코와이마마다케도 (키미에토)"
    },
    {
      "t": 135.04,
      "text": "震えても 挫けそうでも 辿り着きたい",
      "ko": "후루에테모 쿠지케소-데모 타도리츠키타이"
    },
    {
      "t": 152.88,
      "text": "片道だと思ってた矢印が",
      "ko": "카타미치다토 오못테타 야지루시가"
    },
    {
      "t": 155.35,
      "text": "反転して ここへ届いた声音",
      "ko": "한텐시테 코코에 토도이타 코와네"
    },
    {
      "t": 158.75,
      "text": "ああ 心強くて あったかくて",
      "ko": "아- 코코로즈요쿠테 앗타카쿠테"
    },
    {
      "t": 162.07,
      "text": "僕の命綱になった",
      "ko": "보쿠노 이노치즈나니 낫타"
    },
    {
      "t": 164.33,
      "text": "すべての音が鳴り止んで",
      "ko": "스베테노 오토가 나리얀데"
    },
    {
      "t": 166.51,
      "text": "やがて僕らは日常に戻る",
      "ko": "야가테 보쿠라와 니치죠-니 모도루"
    },
    {
      "t": 169.32,
      "text": "それぞれをただ生きるときにも",
      "ko": "소레조레오 타다 이키루 토키니모"
    },
    {
      "t": 171.54,
      "text": "鳴り止まない残響になりたい",
      "ko": "나리야마나이 잔쿄-니 나리타이"
    },
    {
      "t": 174.27,
      "text": "どこにいたって思い出してほしくて",
      "ko": "도코니 이탓테 오모이다시테 호시쿠테"
    },
    {
      "t": 177.02,
      "text": "どんな街にだって連れて行ってほしくて",
      "ko": "돈나 마치니닷테 츠레테잇테 호시쿠테"
    },
    {
      "t": 179.92,
      "text": "僕らの音を 僕らの声を",
      "ko": "보쿠라노 오토오 보쿠라노 코에오"
    },
    {
      "t": 183.23,
      "text": "離さないでほしいんだ",
      "ko": "하나사나이데 호시인다"
    },
    {
      "t": 208.31,
      "text": "いまたしかに僕をかたどる（かたどる）",
      "ko": "이마 타시카니 보쿠오 카타도루 (카타도루)"
    },
    {
      "t": 213.27,
      "text": "心のはしは ゆらゆらたなびいてる",
      "ko": "코코로노 하시와 유라유라 타나비이테루"
    },
    {
      "t": 218.22,
      "text": "音伝いに進んでいく その向こうで（いまから）",
      "ko": "오토즈타이니 스슨데이쿠 소노 무코-데 (이마카라)"
    },
    {
      "t": 224.24,
      "text": "何度だって君の声を 聞きたいんだよ",
      "ko": "난도닷테 키미노 코에오 키키타인다요"
    },
    {
      "t": 230.24,
      "text": "心のはしを辿って君に 会いに行く",
      "ko": "코코로노 하시오 타돗테 키미니 아이니 이쿠"
    },
    {
      "t": 242.19,
      "text": "待っててくれるかな",
      "ko": "맛테테 쿠레루카나"
    },
    {
      "t": 245.26,
      "text": "僕らは 迷っても途切れない",
      "ko": "보쿠라와 마욧테모 토기레나이"
    },
    {
      "t": 250.6,
      "text": "心のはしを辿り 君に触れたい",
      "ko": "코코로노 하시오 타도리 키미니 후레타이"
    },
    {
      "t": 261.95,
      "text": "不安さえ見えなくなるくらい（僕らは）",
      "ko": "후안사에 미에나쿠나루 쿠라이 (보쿠라와)"
    },
    {
      "t": 266.6,
      "text": "君と同じ音の中を 駆け抜けていく",
      "ko": "키미토 오나지 오토노 나카오 카케누케테이쿠"
    },
    {
      "t": 273.87,
      "text": "鳴り止んでも 鳴り止まない 音の中を",
      "ko": "나리얀데모 나리야마나이 오토노 나카오"
    }
  ],
