  "lrclib": {
    "id": 16047634,
    "trackName": "孤壊牢",
    "artistName": "MyGO!!!!!"
  },
  "durationSec": 215.57,
  "lines": [
    {
      "t": 28.54,
      "text": "まるで違う生き物なのに",
      "ko": "마루데 치가우 이키모노나노니"
    },
    {
      "t": 30.9,
      "text": "何故か僕ら一括りで",
      "ko": "나제카 보쿠라 히토쿠쿠리데"
    },
    {
      "t": 33.56,
      "text": "語られる度に虚しい（侘しい）",
      "ko": "카타라레루 타비니 무나시- (와비시-)"
    },
    {
      "t": 39.17,
      "text": "上辺だけを飛ばし読みして",
      "ko": "우와베다케오 토바시요미시테"
    },
    {
      "t": 41.41,
      "text": "計り知れる そんなものが",
      "ko": "하카리시레루 손나 모노가"
    },
    {
      "t": 44.38,
      "text": "僕だというなら",
      "ko": "보쿠다토 이우나라"
    },
    {
      "t": 47.35,
      "text": "理解らなくていいよ 理解ろうとするな",
      "ko": "와카라나쿠테 이이요 와카로-토 스루나"
    },
    {
      "t": 51.31,
      "text": "（追いつかない）修復が間に合わない",
      "ko": "(오이츠카나이) 슈-후쿠가 마니아와나이"
    },
    {
      "t": 57.13,
      "text": "こころ こころ",
      "ko": "코코로 코코로"
    },
    {
      "t": 61.11,
      "text": "壊れない 消えない ものはどこにもない（こたえを）",
      "ko": "코와레나이 키에나이 모노와 도코니모 나이 (코타에오)"
    },
    {
      "t": 65.67,
      "text": "誰も 教えてくれない 投げ出されていた 僕ら",
      "ko": "다레모 오시에테쿠레나이 나게다사레테이타 보쿠라"
    },
    {
      "t": 71.19,
      "text": "明日もない 描けない",
      "ko": "아스모 나이 에가케나이"
    },
    {
      "t": 73.59,
      "text": "どんなに鮮やかな景色も",
      "ko": "돈나니 아자야카나 케시키모"
    },
    {
      "t": 76.49,
      "text": "僕の目には鈍色に映る仕様（それでも）",
      "ko": "보쿠노 메니와 니비이로니 우츠루 시요- (소레데모)"
    },
    {
      "t": 82.02,
      "text": "こころは僕のものだ",
      "ko": "코코로와 보쿠노 모노다"
    },
    {
      "t": 97.03,
      "text": "迷い込んだ方程式も",
      "ko": "마요이콘다 호-테-시키모"
    },
    {
      "t": 99.48,
      "text": "解があると知ってるなら",
      "ko": "카이가 아루토 싯테루나라"
    },
    {
      "t": 102.35,
      "text": "不可解な今日より 幾分ましだ ずっとましに見えたんだ",
      "ko": "후카카이나 쿄-요리 이쿠분 마시다 즛토 마시니 미에탄다"
    },
    {
      "t": 109.34,
      "text": "（許されない）大枠に塡まれない",
      "ko": "(유루사레나이) 오-와쿠니 하마레나이"
    },
    {
      "t": 115.2,
      "text": "こころ こころ",
      "ko": "코코로 코코로"
    },
    {
      "t": 119.19,
      "text": "甘くない にべない 世界だと僕に（差しだす）",
      "ko": "아마쿠나이 니베나이 세카이다토 보쿠니 (사시다스)"
    },
    {
      "t": 123.52,
      "text": "その手 正しいらしい道筋へ招く 誘う",
      "ko": "소노 테 타다시-라시- 미치스지에 마네쿠 사소우"
    },
    {
      "t": 129.38,
      "text": "手負いの僕らは 信じるすべさえ持たなくて",
      "ko": "테오이노 보쿠라와 신지루 스베사에 모타나쿠테"
    },
    {
      "t": 134.46,
      "text": "胸をつんざく音だけが何よりも（確かで）",
      "ko": "무네오 츤자쿠 오토다케가 나니요리모 (타시카데)"
    },
    {
      "t": 140.02,
      "text": "こころは僕のものだと喚く",
      "ko": "코코로와 보쿠노 모노다토 와메쿠"
    },
    {
      "t": 158.81,
      "text": "撒いたはずの目印はもう",
      "ko": "마이타 하즈노 메지루시와 모-"
    },
    {
      "t": 161.52,
      "text": "いとも容易く ついばまれて",
      "ko": "이토모 타야스쿠 츠이바마레테"
    },
    {
      "t": 164.19,
      "text": "帰り道を忘れてしまった放浪",
      "ko": "카에리미치오 와스레테시맛타 호-로-"
    },
    {
      "t": 169.27,
      "text": "まともになれない それは本当に",
      "ko": "마토모니 나레나이 소레와 혼토-니"
    },
    {
      "t": 173.15,
      "text": "僕だけなの？",
      "ko": "보쿠다케나노?"
    },
    {
      "t": 174.44,
      "text": "壊れない 消えない ものを隠し持つ ひとつ",
      "ko": "코와레나이 키에나이 모노오 카쿠시모츠 히토츠"
    },
    {
      "t": 179.51,
      "text": "止まれない 戻れない",
      "ko": "토마레나이 모도레나이"
    },
    {
      "t": 181.75,
      "text": "どんなに懐かしい景色も",
      "ko": "돈나니 나츠카시- 케시키모"
    },
    {
      "t": 184.5,
      "text": "僕の手では守れやしないんだろう（誰にも）",
      "ko": "보쿠노 테데와 마모레야 시나인다로- (다레니모)"
    },
    {
      "t": 190.18,
      "text": "触らせはしない（決して）",
      "ko": "사와라세와 시나이 (켓시테)"
    },
    {
      "t": 192.76,
      "text": "こころは僕のものだ",
      "ko": "코코로와 보쿠노 모노다"
    }
  ],
