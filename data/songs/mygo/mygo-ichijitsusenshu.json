  "lrclib": {
    "id": 39141467,
    "trackName": "聿日箋秋 - Ichijitsusenshu",
    "artistName": "MyGO!!!!!"
  },
  "durationSec": 240,
  "lines": [
    {
      "t": 17.79,
      "text": "こころ写す言葉",
      "ko": "코코로 우츠스 코토바"
    },
    {
      "t": 19.86,
      "text": "剥がして連れて行って",
      "ko": "하가시테 츠레테잇테"
    },
    {
      "t": 22.94,
      "text": "わかれ道の先へ",
      "ko": "와카레미치노 사키에"
    },
    {
      "t": 25.19,
      "text": "僕らは歩き出す",
      "ko": "보쿠라와 아루키다스"
    },
    {
      "t": 28.49,
      "text": "どうしたらいいのか",
      "ko": "도-시타라 이이노카"
    },
    {
      "t": 30.23,
      "text": "巡らせてる間に",
      "ko": "메구라세테루 아이다니"
    },
    {
      "t": 33.5,
      "text": "季節も変わるよ",
      "ko": "키세츠모 카와루요"
    },
    {
      "t": 36.27,
      "text": "僕もそうかな",
      "ko": "보쿠모 소-카나"
    },
    {
      "t": 39.09,
      "text": "ゆらゆら 今日も曲がり角に立つ",
      "ko": "유라유라 쿄-모 마가리카도니 타츠"
    },
    {
      "t": 44.27,
      "text": "右左どっちも選べないまま",
      "ko": "미기 히다리 돗치모 에라베나이 마마"
    },
    {
      "t": 49.49,
      "text": "ふらふらな僕の行方はわからない",
      "ko": "후라후라나 보쿠노 유쿠에와 와카라나이"
    },
    {
      "t": 54.64,
      "text": "だけどちょっと先へ行くつもりさ",
      "ko": "다케도 춋토 사키에 이쿠 츠모리사"
    },
    {
      "t": 59.7,
      "text": "筋書きのない日々を生きてく僕らは",
      "ko": "스지가키노 나이 히비오 이키테쿠 보쿠라와"
    },
    {
      "t": 64.81,
      "text": "慣れない感情に うろたえてる",
      "ko": "나레나이 칸죠-니 우로타에테루"
    },
    {
      "t": 70.29,
      "text": "傷ついても もしまた 傷つけたとしても",
      "ko": "키즈츠이테모 모시 마타 키즈츠케타토 시테모"
    },
    {
      "t": 76.51,
      "text": "僕のままで ここにいたいから",
      "ko": "보쿠노 마마데 코코니 이타이카라"
    },
    {
      "t": 92.02,
      "text": "自分のことも",
      "ko": "지분노 코토모"
    },
    {
      "t": 93.7,
      "text": "まるでわからないのに",
      "ko": "마루데 와카라나이노니"
    },
    {
      "t": 96.83,
      "text": "それでも君のこと",
      "ko": "소레데모 키미노 코토"
    },
    {
      "t": 98.95,
      "text": "わかりたかったんだよ",
      "ko": "와카리타캇탄다요"
    },
    {
      "t": 102.2,
      "text": "手のひらにのせた",
      "ko": "테노히라니 노세타"
    },
    {
      "t": 104.02,
      "text": "便箋はあたたかい",
      "ko": "빈센와 아타타카이"
    },
    {
      "t": 107.42,
      "text": "君と手つないでいるみたいで",
      "ko": "키미토 테 츠나이데 이루 미타이데"
    },
    {
      "t": 112.75,
      "text": "くらくらしては まぶたを閉じてさ",
      "ko": "쿠라쿠라 시테와 마부타오 토지테사"
    },
    {
      "t": 117.92,
      "text": "巻き戻し昨日を映すたびに",
      "ko": "마키모도시 키노-오 우츠스 타비니"
    },
    {
      "t": 123.16,
      "text": "ぽろぽろと今がこぼれ落ちるなら",
      "ko": "포로포로토 이마가 코보레오치루나라"
    },
    {
      "t": 128.4,
      "text": "僕は目を開けてみつめなくちゃ",
      "ko": "보쿠와 메오 아케테 미츠메나쿠챠"
    },
    {
      "t": 133.7,
      "text": "もう戻らない 欠片を集めてみても",
      "ko": "모- 모도라나이 카케라오 아츠메테 미테모"
    },
    {
      "t": 138.66,
      "text": "二度と同じ瞬間に 帰れなくて",
      "ko": "니도토 오나지 토키니 카에레나쿠테"
    },
    {
      "t": 144.08,
      "text": "足踏みして 進めずいると想ってたけど",
      "ko": "아시부미시테 스스메즈 이루토 오못테타케도"
    },
    {
      "t": 150.39,
      "text": "新しい風に吹かれてた",
      "ko": "아타라시- 카제니 후카레테타"
    },
    {
      "t": 156.05,
      "text": "はぐれた道が",
      "ko": "하구레타 미치가"
    },
    {
      "t": 158.64,
      "text": "もう一度この先でもしも交わるなら",
      "ko": "모- 이치도 코노 사키데 모시모 마지와루나라"
    },
    {
      "t": 164.84,
      "text": "うつむかずうたうよ 君を見つけたいから",
      "ko": "우츠무카즈 우타우요 키미오 미츠케타이카라"
    },
    {
      "t": 170.14,
      "text": "ひだまりのように笑っててほしくて あぁ",
      "ko": "히다마리노 요-니 와랏테테 호시쿠테 아-"
    },
    {
      "t": 188.94,
      "text": "僕らにしか迷えないたった今を",
      "ko": "보쿠라니시카 마요에나이 탓타 이마오"
    },
    {
      "t": 194.18,
      "text": "忘れたくないから うたっている",
      "ko": "와스레타쿠나이카라 우탓테이루"
    },
    {
      "t": 199.54,
      "text": "優しい君が君のままで いられるように",
      "ko": "야사시- 키미가 키미노 마마데 이라레루 요-니"
    },
    {
      "t": 205.81,
      "text": "この声にこめた",
      "ko": "코노 코에니 코메타"
    },
    {
      "t": 210.07,
      "text": "筋書きのない日々を生きてく僕らは",
      "ko": "스지가키노 나이 히비오 이키테쿠 보쿠라와"
    },
    {
      "t": 215.12,
      "text": "絶えない不安の中を踏み出してく",
      "ko": "타에나이 후안노 나카오 후미다시테쿠"
    },
    {
      "t": 220.62,
      "text": "傷ついても もし また 傷つけたとしても",
      "ko": "키즈츠이테모 모시 마타 키즈츠케타토 시테모"
    },
    {
      "t": 226.84,
      "text": "僕はここで うたっているから",
      "ko": "보쿠와 코코데 우탓테이루카라"
    }
  ],
