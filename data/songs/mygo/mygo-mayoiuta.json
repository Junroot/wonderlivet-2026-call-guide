  "lrclib": {
    "id": 12629103,
    "trackName": "迷星叫 - Mayoiuta",
    "artistName": "MyGO!!!!!"
  },
  "durationSec": 212,
  "lines": [
    {
      "t": 7.73,
      "text": "La-la-la-la",
      "ko": null
    },
    {
      "t": 16.36,
      "text": "交差点の真ん中",
      "ko": "코-사텐노 만나카"
    },
    {
      "t": 18.96,
      "text": "急ぐ人に紛れて",
      "ko": "이소구 히토니 마기레테"
    },
    {
      "t": 21.51,
      "text": "僕だけがあてもなく 漂うみたいだ",
      "ko": "보쿠다케가 아테모나쿠 타다요우 미타이다"
    },
    {
      "t": 26.59,
      "text": "流行りの歌はいつも",
      "ko": "하야리노 우타와 이츠모"
    },
    {
      "t": 29.03,
      "text": "僕のことは歌ってない",
      "ko": "보쿠노 코토와 우탓테나이"
    },
    {
      "t": 31.42,
      "text": "ねえ ビジョンの中から 笑いかけないで",
      "ko": "네- 비죤노 나카카라 와라이카케나이데"
    },
    {
      "t": 36.27,
      "text": "また今日も声にならずに 飲み込んだ感情",
      "ko": "마타 쿄-모 코에니 나라즈니 노미콘다 칸죠-"
    },
    {
      "t": 41.52,
      "text": "下書き埋め尽くして",
      "ko": "시타가키 우메츠쿠시테"
    },
    {
      "t": 44.03,
      "text": "ああ そうやって何千回夜を越える",
      "ko": "아- 소-얏테 난젠카이 요루오 코에루"
    },
    {
      "t": 49.44,
      "text": "僕のため それだけ それだけだったんだよ",
      "ko": "보쿠노 타메 소레다케 소레다케닷탄다요"
    },
    {
      "t": 55.03,
      "text": "出口（出口）探し（探し）溢れただけの言葉",
      "ko": "데구치 (데구치) 사가시 (사가시) 아후레타다케노 코토바"
    },
    {
      "t": 60.79,
      "text": "君の心へ届いて 隙間をちょっと埋めるなら",
      "ko": "키미노 코코로에 토도이테 스키마오 춋토 우메루나라"
    },
    {
      "t": 65.89,
      "text": "こんな僕でも ここにいる叫ぶよ",
      "ko": "콘나 보쿠데모 코코니 이루 사케부요"
    },
    {
      "t": 70.99,
      "text": "迷い星のうた",
      "ko": "마요이보시노 우타"
    },
    {
      "t": 83.36,
      "text": "問われることは何故か",
      "ko": "토와레루 코토와 나제카"
    },
    {
      "t": 85.76,
      "text": "将来のことばかり",
      "ko": "쇼-라이노 코토바카리"
    },
    {
      "t": 88.43,
      "text": "目の前にいる僕の 今はおざなりで",
      "ko": "메노 마에니 이루 보쿠노 이마와 오자나리데"
    },
    {
      "t": 93.54,
      "text": "華やぎに馴染めない",
      "ko": "하나야기니 나지메나이"
    },
    {
      "t": 95.94,
      "text": "この心を無視して",
      "ko": "코노 코코로오 무시시테"
    },
    {
      "t": 98.32,
      "text": "輝かしい明日を推奨しないでくれ",
      "ko": "카가야카시이 아스오 스이쇼-시나이데 쿠레"
    },
    {
      "t": 103.37,
      "text": "夜空にチカチカ光る 頼りない星屑",
      "ko": "요조라니 치카치카 히카루 타요리나이 호시쿠즈"
    },
    {
      "t": 108.38,
      "text": "躊躇いながらはぐれて",
      "ko": "타메라이나가라 하구레테"
    },
    {
      "t": 110.9,
      "text": "ああ 彷徨っているそれが僕",
      "ko": "아- 사마욧테이루 소레가 보쿠"
    },
    {
      "t": 116.34,
      "text": "僕になる それしか それしかできないだろう",
      "ko": "보쿠니 나루 소레시카 소레시카 데키나이다로-"
    },
    {
      "t": 121.9,
      "text": "誰の（誰の）真似も（真似も）上手くやれないんだ",
      "ko": "다레노 (다레노) 마네모 (마네모) 우마쿠 야레나인다"
    },
    {
      "t": 127.87,
      "text": "こんな痛い日々をなんで 退屈だって片付ける？",
      "ko": "콘나 이타이 히비오 난데 타이쿠츠닷테 카타즈케루?"
    },
    {
      "t": 132.66,
      "text": "よろめきながらでも もがいているんだよ",
      "ko": "요로메키나가라데모 모가이테이룬다요"
    },
    {
      "t": 137.87,
      "text": "迷い星のうた",
      "ko": "마요이보시노 우타"
    },
    {
      "t": 161.97,
      "text": "僕のため それだけ それだけだったんだよ",
      "ko": "보쿠노 타메 소레다케 소레다케닷탄다요"
    },
    {
      "t": 167.53,
      "text": "涙流し やっと生まれた言葉",
      "ko": "나미다 나가시 얏토 우마레타 코토바"
    },
    {
      "t": 173.1,
      "text": "どこかで同じように ヒリヒリする胸抱えて",
      "ko": "도코카데 오나지요-니 히리히리스루 무네 카카에테"
    },
    {
      "t": 178.33,
      "text": "震える君に僕もいる叫ぶよ",
      "ko": "후루에루 키미니 보쿠모 이루 사케부요"
    },
    {
      "t": 183.2,
      "text": "迷い星のうた",
      "ko": "마요이보시노 우타"
    },
    {
      "t": 189.42,
      "text": "La-la-la-la",
      "ko": null
    }
  ],
