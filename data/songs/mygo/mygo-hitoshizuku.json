  "lrclib": {
    "id": 40154303,
    "trackName": "壱雫空",
    "artistName": "MyGO!!!!!"
  },
  "durationSec": 189,
  "lines": [
    {
      "t": 1.06,
      "text": "もしこの雨が上がっても",
      "ko": "모시 코노 아메가 아갓테모"
    },
    {
      "t": 3.79,
      "text": "忘れずに歩いてくよ",
      "ko": "와스레즈니 아루이테쿠요"
    },
    {
      "t": 5.88,
      "text": "最初のひとしずくに 顔上げた今日の僕を",
      "ko": "사이쇼노 히토시즈쿠니 카오 아게타 쿄-노 보쿠오"
    },
    {
      "t": 18.3,
      "text": "透明な傘で作る ひとり分だけの世界",
      "ko": "토-메-나 카사데 츠쿠루 히토리분다케노 세카이"
    },
    {
      "t": 22.89,
      "text": "(遮って隠れた)",
      "ko": "(사에깃테 카쿠레타)"
    },
    {
      "t": 24.46,
      "text": "そっと逃げ込んでいた",
      "ko": "솟토 니게콘데이타"
    },
    {
      "t": 27.54,
      "text": "ビニール越しの空から",
      "ko": "비니-루고시노 소라카라"
    },
    {
      "t": 30.09,
      "text": "こぼれ落ちる音響いて",
      "ko": "코보레오치루 오토 히비이테"
    },
    {
      "t": 32.69,
      "text": "(弾けた合図)",
      "ko": "(하지케타 아이즈)"
    },
    {
      "t": 34.53,
      "text": "滲む心へと溶けた",
      "ko": "니지무 코코로에토 토케타"
    },
    {
      "t": 37.1,
      "text": "泣きじゃくっている この空といこう",
      "ko": "나키쟈쿳테이루 코노 소라토 이코-"
    },
    {
      "t": 41.86,
      "text": "(アスファルト染めていく 溢れ出したスコール)",
      "ko": "(아스화루토 소메테이쿠 아후레다시타 스코-루)"
    },
    {
      "t": 46.69,
      "text": "通り過ぎる時を 待つだけじゃなくて",
      "ko": "토-리스기루 토키오 마츠다케쟈나쿠테"
    },
    {
      "t": 50.97,
      "text": "僕は見つめていたいんだよ",
      "ko": "보쿠와 미츠메테이타인다요"
    },
    {
      "t": 55.49,
      "text": "無色でもそこにあるもの",
      "ko": "무쇼쿠데모 소코니 아루모노"
    },
    {
      "t": 58.64,
      "text": "この雨が上がってく時",
      "ko": "코노 아메가 아갓테쿠 토키"
    },
    {
      "t": 62.3,
      "text": "なにもなかったように",
      "ko": "나니모 나캇타요-니"
    },
    {
      "t": 64.71,
      "text": "消えてく傘花みたいに心は",
      "ko": "키에테쿠 카사바나 미타이니 코코로와"
    },
    {
      "t": 69.09,
      "text": "上手に折り畳めないから",
      "ko": "죠-즈니 오리타타메나이카라"
    },
    {
      "t": 71.61,
      "text": "過ぎ去ってしまう瞬間を",
      "ko": "스기삿테시마우 슌칸오"
    },
    {
      "t": 75.02,
      "text": "僕はあつめたいよ ああ ひとしずくを",
      "ko": "보쿠와 아츠메타이요 아- 히토시즈쿠오"
    },
    {
      "t": 90,
      "text": "とめどなく傘にすべり落ちる",
      "ko": "토메도나쿠 카사니 스베리오치루"
    },
    {
      "t": 94.63,
      "text": "雫が揺れて描いてく (模様)",
      "ko": "시즈쿠가 유레테 에가이테쿠 (모요-)"
    },
    {
      "t": 99.35,
      "text": "風に震えては",
      "ko": "카제니 후루에테와"
    },
    {
      "t": 101.7,
      "text": "ぐずついてる僕みたいな",
      "ko": "구즈츠이테루 보쿠 미타이나"
    },
    {
      "t": 105.92,
      "text": "くすんでる今日を映した",
      "ko": "쿠슨데루 쿄-오 우츠시타"
    },
    {
      "t": 108.92,
      "text": "迷い続けるこの空といこう",
      "ko": "마요이츠즈케루 코노 소라토 이코-"
    },
    {
      "t": 113.65,
      "text": "(曖昧に透ける色 眺めていたい)",
      "ko": "(아이마이니 스케루 이로 나가메테이타이)"
    },
    {
      "t": 118.22,
      "text": "ただよう雲だって 1秒先なんて",
      "ko": "타다요우 쿠모닷테 이치뵤- 사키난테"
    },
    {
      "t": 122.76,
      "text": "わからないままいくんだろう",
      "ko": "와카라나이마마 이쿤다로-"
    },
    {
      "t": 127.2,
      "text": "不安で鈍く霞んでく 明日も",
      "ko": "후안데 니부쿠 카슨데쿠 아시타모"
    },
    {
      "t": 132.89,
      "text": "もしこの雨が上がっても",
      "ko": "모시 코노 아메가 아갓테모"
    },
    {
      "t": 135.45,
      "text": "忘れたくないから",
      "ko": "와스레타쿠나이카라"
    },
    {
      "t": 137.88,
      "text": "たった今を書きとめておきたいんだ",
      "ko": "탓타 이마오 카키토메테 오키타인다"
    },
    {
      "t": 142.19,
      "text": "この手じゃ届かない",
      "ko": "코노 테쟈 토도카나이"
    },
    {
      "t": 144.55,
      "text": "あの空から点線の糸で",
      "ko": "아노 소라카라 텐센노 이토데"
    },
    {
      "t": 147.74,
      "text": "つなぐように届いた ひとしずく",
      "ko": "츠나구요-니 토도이타 히토시즈쿠"
    },
    {
      "t": 152.74,
      "text": "いまこの雨が上がってく",
      "ko": "이마 코노 아메가 아갓테쿠"
    },
    {
      "t": 156.54,
      "text": "最後のひと粒が",
      "ko": "사이고노 히토츠부가"
    },
    {
      "t": 158.94,
      "text": "小さく光って僕を映した",
      "ko": "치-사쿠 히캇테 보쿠오 우츠시타"
    },
    {
      "t": 163.48,
      "text": "まだ道は乾かないだろう",
      "ko": "마다 미치와 카와카나이다로-"
    },
    {
      "t": 166.04,
      "text": "潤んだ風を吸い込んだ",
      "ko": "우룬다 카제오 스이콘다"
    },
    {
      "t": 169.21,
      "text": "僕は連れていこう ああ ひとしずくを",
      "ko": "보쿠와 츠레테이코- 아- 히토시즈쿠오"
    }
  ],
