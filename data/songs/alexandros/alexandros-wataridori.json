  "lines": [
    {
      "t": 21.19,
      "text": "I wanna fly so high",
      "ko": null
    },
    {
      "t": 22.67,
      "text": "Yeah, I know my wings are dried",
      "ko": null
    },
    {
      "t": 24.45,
      "text": "「翼仰げば」って人は云う",
      "ko": "「츠바사 아오게바」앗테 히토와 이우"
    },
    {
      "t": 28.38,
      "text": "その向こうにあるは無情",
      "ko": "소노 무코-니 아루와 무죠-"
    },
    {
      "t": 31.55,
      "text": "飛べる者 落ちる者",
      "ko": "토베루 모노 오치루 모노"
    },
    {
      "t": 35.03,
      "text": "誰も見てない",
      "ko": "다레모 미테나이"
    },
    {
      "t": 36.73,
      "text": "気にも留めない",
      "ko": "키니모 토메나이"
    },
    {
      "t": 38.49,
      "text": "それでも飛び続けた",
      "ko": "소레데모 토비츠즈케타"
    },
    {
      "t": 42.28,
      "text": "傷ついた言葉乗せ",
      "ko": "키즈츠이타 코토바 노세"
    },
    {
      "t": 44.74,
      "text": "運びたいから",
      "ko": "하코비타이카라"
    },
    {
      "t": 48.77,
      "text": "追いかけて 届くよう",
      "ko": "오이카케테 토도쿠요-"
    },
    {
      "t": 52.76,
      "text": "僕等 一心に 羽ばたいて",
      "ko": "보쿠라 잇신니 하바타이테"
    },
    {
      "t": 56.24,
      "text": "問いかけて 嘆いた夜",
      "ko": "토이카케테 나게이타 요루"
    },
    {
      "t": 59.8,
      "text": "故郷は 一層 輝いて",
      "ko": "코쿄-와 잇소- 카가야이테"
    },
    {
      "t": 63.96,
      "text": "ワタリドリの様に今 旅に発つよ",
      "ko": "와타리도리노 요-니 이마 타비니 타츠요"
    },
    {
      "t": 71.12,
      "text": "ありもしないストーリーを",
      "ko": "아리모 시나이 스토-리-오"
    },
    {
      "t": 76.08,
      "text": "描いてみせるよ",
      "ko": "에가이테 미세루요"
    },
    {
      "t": 85.03,
      "text": "I wanna fly so far",
      "ko": null
    },
    {
      "t": 86.58,
      "text": "Away with my guitar",
      "ko": null
    },
    {
      "t": 88.32,
      "text": "「一人じゃない」って人々は歌う",
      "ko": "「히토리쟈 나이」앗테 히토비토와 우타우"
    },
    {
      "t": 92.44,
      "text": "間違いじゃない",
      "ko": "마치가이쟈 나이"
    },
    {
      "t": 93.63,
      "text": "理想論でもない",
      "ko": "리소-론데모 나이"
    },
    {
      "t": 95.41,
      "text": "ただ頼って生きたくはない",
      "ko": "타다 타욧테 이키타쿠와 나이"
    },
    {
      "t": 99.06,
      "text": "誰も聴いていない",
      "ko": "다레모 키이테 이나이"
    },
    {
      "t": 100.77,
      "text": "気にも留めない",
      "ko": "키니모 토메나이"
    },
    {
      "t": 102.55,
      "text": "それでも歌い続けた",
      "ko": "소레데모 우타이츠즈케타"
    },
    {
      "t": 106.31,
      "text": "傷ついた あなたを",
      "ko": "키즈츠이타 아나타오"
    },
    {
      "t": 108.77,
      "text": "笑わせたいから",
      "ko": "와라와세타이카라"
    },
    {
      "t": 113.03,
      "text": "追い風 届けるよ",
      "ko": "오이카제 토도케루요"
    },
    {
      "t": 117.09,
      "text": "僕等 一心に 羽ばたいて",
      "ko": "보쿠라 잇신니 하바타이테"
    },
    {
      "t": 120.14,
      "text": "遠い過去を 背負ってた",
      "ko": "토-이 카코오 세옷테타"
    },
    {
      "t": 123.92,
      "text": "あなたを未来へ運ぶよ",
      "ko": "아나타오 미라이에 하코부요"
    },
    {
      "t": 128.17,
      "text": "ワタリドリの様に今 群れをなして",
      "ko": "와타리도리노 요-니 이마 무레오 나시테"
    },
    {
      "t": 135.29,
      "text": "大それた四重奏を 奏で終える日まで",
      "ko": "오-소레타 시쥬-소-오 카나데오에루 히마데"
    },
    {
      "t": 155.61,
      "text": "All this time we come and we grow",
      "ko": null
    },
    {
      "t": 159.41,
      "text": "Now it's time that we should go",
      "ko": null
    },
    {
      "t": 162.72,
      "text": "But we both know that this is for sure",
      "ko": null
    },
    {
      "t": 165.62,
      "text": "It's not the end of the world",
      "ko": null
    },
    {
      "t": 169.61,
      "text": "Well, see you one day",
      "ko": null
    },
    {
      "t": 177.29,
      "text": "追いかけて 届くよう",
      "ko": "오이카케테 토도쿠요-"
    },
    {
      "t": 180.87,
      "text": "僕等 一心に 羽ばたいて",
      "ko": "보쿠라 잇신니 하바타이테"
    },
    {
      "t": 184.17,
      "text": "問いかけて 嘆いた夜",
      "ko": "토이카케테 나게이타 요루"
    },
    {
      "t": 187.94,
      "text": "朝焼け色に 染まっていく",
      "ko": "아사야케이로니 소맛테 이쿠"
    },
    {
      "t": 191.92,
      "text": "ワタリドリの様に いつか舞い戻るよ",
      "ko": "와타리도리노 요-니 이츠카 마이모도루요"
    },
    {
      "t": 199.18,
      "text": "ありもしないストーリーを",
      "ko": "아리모 시나이 스토-리-오"
    },
    {
      "t": 203.71,
      "text": "いつかまた会う日まで",
      "ko": "이츠카 마타 아우 히마데"
    }
  ],
