  "lines": [
    {
      "t": null,
      "text": "リンリンリンリン テレフォンタイム",
      "ko": "린린린린 테레폰 타이무"
    },
    {
      "t": null,
      "text": "モシモシキミのハートへと calling",
      "ko": "모시모시 키미노 하-토에토 calling"
    },
    {
      "t": null,
      "text": "(ハイ ハイ ハイ ハイ ハイ hoo hoo)",
      "ko": "(하이 하이 하이 하이 하이 hoo hoo)"
    },
    {
      "t": null,
      "text": "感度は良好です (good)",
      "ko": "칸도와 료-코-데스 (good)"
    },
    {
      "t": null,
      "text": "ハレワタルブルースカイ (fine)",
      "ko": "하레와타루 부루-스카이 (fine)"
    },
    {
      "t": null,
      "text": "ならばいきましょう (go)",
      "ko": "나라바 이키마쇼- (go)"
    },
    {
      "t": null,
      "text": "オモイネジコンデ (ok)",
      "ko": "오모이 네지콘데 (ok)"
    },
    {
      "t": null,
      "text": "ピピピ届け発信 (ピピッピー)",
      "ko": "피피피 토도케 핫신 (피핏피-)"
    },
    {
      "t": null,
      "text": "聞こえますか? ワタシの声が",
      "ko": "키코에마스카? 와타시노 코에가"
    },
    {
      "t": null,
      "text": "恒久的速やかにキャッチして! (Yeah)",
      "ko": "코-큐-테키 스미야카니 캿치시테! (Yeah)"
    },
    {
      "t": null,
      "text": "君のハート目がけ直電話",
      "ko": "키미노 하-토 메가케 지카뎅와"
    },
    {
      "t": null,
      "text": "逃がしたりしないよ",
      "ko": "니가시타리 시나이요"
    },
    {
      "t": null,
      "text": "二度と離さないくらい",
      "ko": "니도토 하나사나이 쿠라이"
    },
    {
      "t": null,
      "text": "トリコにしてあげたぃな",
      "ko": "토리코니 시테 아게타이나"
    },
    {
      "t": null,
      "text": "衝撃的トキメキで",
      "ko": "쇼-게키테키 토키메키데"
    },
    {
      "t": null,
      "text": "カラダのはじっこまで (yes)",
      "ko": "카라다노 하짓코마데 (yes)"
    },
    {
      "t": null,
      "text": "電流かけめぐる",
      "ko": "덴류- 카케메구루"
    },
    {
      "t": null,
      "text": "だから答えてお願い",
      "ko": "다카라 코타에테 오네가이"
    },
    {
      "t": null,
      "text": "Call me, tell me",
      "ko": null
    },
    {
      "t": null,
      "text": "カシャカシャカシャカシャ さぁフォトタイム",
      "ko": "카샤카샤카샤카샤 사- 포토 타이무"
    },
    {
      "t": null,
      "text": "ニコニコキミもフレームイン",
      "ko": "니코니코 키미모 후레-무 인"
    },
    {
      "t": null,
      "text": "カシャカシャカシャカシャ さぁフォトタイム",
      "ko": "카샤카샤카샤카샤 사- 포토 타이무"
    },
    {
      "t": null,
      "text": "キラキラキミも一緒にハイ cheese",
      "ko": "키라키라 키미모 잇쇼니 하이 cheese"
    },
    {
      "t": null,
      "text": "「キメ顏で! 撮りましょ! スリー! トゥー! ワーン!」",
      "ko": "「키메가오데! 토리마쇼! 스리-! 투-! 와-은!」"
    },
    {
      "t": null,
      "text": "応答ありがと (great)",
      "ko": "오-토- 아리가토 (great)"
    },
    {
      "t": null,
      "text": "ホンジツノメッセージ (hear)",
      "ko": "혼지츠노 멧세-지 (hear)"
    },
    {
      "t": null,
      "text": "高鳴る周波数に (cune)",
      "ko": "타카나루 슈-하스-니 (cune)"
    },
    {
      "t": null,
      "text": "チューニング合わせ (tune)",
      "ko": "츄-닝구 아와세 (tune)"
    },
    {
      "t": null,
      "text": "ピピピ愛の配信 (ピピッピー)",
      "ko": "피피피 아이노 하이신 (피핏피-)"
    },
    {
      "t": null,
      "text": "宜しければ ワタシたちみんな",
      "ko": "요로시케레바 와타시타치 민나"
    },
    {
      "t": null,
      "text": "恒常的永久にウォッチしてみて! (Yeah)",
      "ko": "코-죠-테키 에-큐-니 웟치시테미테! (Yeah)"
    },
    {
      "t": null,
      "text": "頭の中までお邪魔します",
      "ko": "아타마노 나카마데 오쟈마시마스"
    },
    {
      "t": null,
      "text": "脳内隅々へ (yes)",
      "ko": "노-나이 스미즈미에 (yes)"
    },
    {
      "t": null,
      "text": "シナプスハッキングメモリー",
      "ko": "시나푸스 핫킹구 메모리-"
    },
    {
      "t": null,
      "text": "ハッピーで満たしたぃな",
      "ko": "핫피-데 미타시타이나"
    },
    {
      "t": null,
      "text": "強制的スマイルで",
      "ko": "쿄-세-테키 스마이루데"
    },
    {
      "t": null,
      "text": "巻き込んであげるから (yes)",
      "ko": "마키콘데 아게루카라 (yes)"
    },
    {
      "t": null,
      "text": "クセになるくらいが",
      "ko": "쿠세니 나루 쿠라이가"
    },
    {
      "t": null,
      "text": "丁度いいかってもんでしょ?",
      "ko": "쵸-도 이-캇테 몬데쇼?"
    },
    {
      "t": null,
      "text": "Call me, tell me",
      "ko": null
    },
    {
      "t": null,
      "text": "風の日でも雨の日でも",
      "ko": "카제노 히데모 아메노 히데모"
    },
    {
      "t": null,
      "text": "現代科学で say hello!",
      "ko": "겐다이 카가쿠데 say hello!"
    },
    {
      "t": null,
      "text": "朝昼夜 深夜もオーライ",
      "ko": "아사 히루 요루 신야모 오-라이"
    },
    {
      "t": null,
      "text": "この想いよ飛んでけ!",
      "ko": "코노 오모이요 톤데케!"
    },
    {
      "t": null,
      "text": "目に見えないものでも通じ合えるよ",
      "ko": "메니 미에나이 모노데모 츠-지아에루요"
    },
    {
      "t": null,
      "text": "だから (絶対) きっと (全部)",
      "ko": "다카라 (젯타이) 킷토 (젠부)"
    },
    {
      "t": null,
