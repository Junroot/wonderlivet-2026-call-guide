    {
      "t": 1.03,
      "text": "It's 良い！So 良い！総意 so 良い so free",
      "ko": "It's 이-! So 이-! 소-이 so 이- so free"
    },
    {
      "t": 3.68,
      "text": "It's 良い！So 良い！総意 so 良い so feel",
      "ko": "It's 이-! So 이-! 소-이 so 이- so feel"
    },
    {
      "t": 6.49,
      "text": "It's 良い！So 良い！総意 so 良い so free",
      "ko": "It's 이-! So 이-! 소-이 so 이- so free"
    },
    {
      "t": 9.06,
      "text": "It's 良い！So 良い！ウチらの総意！",
      "ko": "It's 이-! So 이-! 우치라노 소-이!"
    },
    {
      "t": 11.73,
      "text": "流行ってるカフェ良い（総意！）流行ってる曲良い（総意！）",
      "ko": "하얏테루 카훼 이- (소-이!) 하얏테루 쿄쿠 이- (소-이!)"
    },
    {
      "t": 14.24,
      "text": "みんなが良いって言うからきっとこれが良い（総意！）",
      "ko": "민나가 이-테 이우카라 킷토 코레가 이- (소-이!)"
    },
    {
      "t": 17.04,
      "text": "ほんとはこっちが良い（総意？） 絶対こっちが良い（総意？）",
      "ko": "혼토와 콧치가 이- (소-이?) 젯타이 콧치가 이- (소-이?)"
    },
    {
      "t": 19.67,
      "text": "思ってても言えない 自我見出すの 困難です",
      "ko": "오못테테모 이에나이 지가 미이다스노 콘난데스"
    },
    {
      "t": 22.65,
      "text": "(S-O-U-I, S-O-U-I) 困難です (S-O-U-I, S-O-U-I)",
      "ko": "(S-O-U-I, S-O-U-I) 콘난데스 (S-O-U-I, S-O-U-I)"
    },
    {
      "t": 27.89,
      "text": "本音がね どっかにね",
      "ko": "혼네가네 독카니네"
    },
    {
      "t": 30.58,
      "text": "いっちゃって 不明なの",
      "ko": "잇챳테 후메-나노"
    },
    {
      "t": 33.04,
      "text": "同調して安心 隠しちゃった本心",
      "ko": "도-쵸-시테 안신 카쿠시챳타 혼신"
    },
    {
      "t": 35.76,
      "text": "それな！それな！それな！それな！それな！",
      "ko": "소레나! 소레나! 소레나! 소레나! 소레나!"
    },
    {
