    {
      "t": 30.78,
      "text": "眼差しは 唯ひたすらに愚直さを込めて",
      "ko": "마나자시와 타다 히타스라니 구초쿠사오 코메테"
    },
    {
      "t": 35.63,
      "text": "魂と本能をくすぐっていった",
      "ko": "타마시-토 혼노-오 쿠스굿테 잇타"
    },
    {
      "t": 40.21,
      "text": "新たな挑戦が 本物へと近づく",
      "ko": "아라타나 쵸-센가 혼모노에토 치카즈쿠"
    },
    {
      "t": 45.29,
      "text": "どんなステージだって 微笑みをあげるわ",
      "ko": "돈나 스테-지닷테 호호에미오 아게루와"
    },
    {
      "t": 49.96,
      "text": "(Breaking out) 逆鱗に触れた先に落ちた",
      "ko": "(Breaking out) 게키린니 후레타 사키니 오치타"
    },
    {
      "t": 54.86,
      "text": "(Breaking out) 産声が激しくぶつかり合う宴",
      "ko": "(Breaking out) 우부고에가 하게시쿠 부츠카리아우 우타게"
    },
    {
      "t": 61.21,
      "text": "競い咲くように 命の anthem 嗚らして",
      "ko": "키소이 사쿠 요-니 이노치노 anthem 나라시테"
    },
    {
      "t": 66.31,
      "text": "磨き上げてゆく それぞれのダイヤを胸に抱き",
      "ko": "미가키아게테 유쿠 소레조레노 다이야오 무네니 이다키"
    },
    {
      "t": 71,
      "text": "自らの音を 信じているからと 高らかに",
      "ko": "미즈카라노 오토오 신지테 이루카라토 타카라카니"
    },
    {
      "t": 76.29,
      "text": "妥協はしない 譲らない 決して揺るがないものは",
      "ko": "다쿄-와 시나이 유즈라나이 켓시테 유루가나이 모노와"
    },
    {
      "t": 81.3,
      "text": "誇りある この想い",
      "ko": "호코리 아루 코노 오모이"
    },
    {
      "t": 84.8,
      "text": "(We went all out to win)",
      "ko": null
    },
    {
      "t": 87.15,
      "text": "Passionate song",
      "ko": null
    },
    {
      "t": 89.57,
      "text": "(We went all out to win)",
      "ko": null
    },
    {
      "t": 94.2,
      "text": "Rush! 声と声 重ね合って",
      "ko": "Rush! 코에토 코에 카사네앗테"
    },
    {
      "t": 96.44,
      "text": "目覚めてゆく細胞は amazing",
      "ko": "메자메테 유쿠 사이보-와 amazing"
    },
    {
      "t": 99.28,
      "text": "限界を突破 超えて challenge",
      "ko": "겐카이오 톳파 코에테 challenge"
    },
    {
      "t": 101.76,
      "text": "その姿は 正に異端児",
      "ko": "소노 스가타와 마사니 이탄지"
    },
    {
      "t": 103.91,
      "text": "Rush! 成長の翼 freed",
      "ko": "Rush! 세-쵸-노 츠바사 freed"
    },
    {
      "t": 106.45,
      "text": "盤上に開く夢への gate",
      "ko": "반죠-니 히라쿠 유메에노 gate"
    },
    {
      "t": 108.87,
      "text": "かかって来なさい 勝てると思うのならば",
      "ko": "카캇테 키나사이 카테루토 오모우노나라바"
    },
    {
      "t": 113.95,
      "text": "(Living on) 互いのセオリー響き合わせて",
      "ko": "(Living on) 타가이노 세오리- 히비키아와세테"
    },
    {
      "t": 118.85,
      "text": "(Living on) 目覚ましく現れた熱情が光る",
      "ko": "(Living on) 메자마시쿠 아라와레타 네츠죠-가 히카루"
    },
    {
      "t": 125.11,
      "text": "常に燃え尽きることなく 心を動かして",
      "ko": "츠네니 모에츠키루 코토나쿠 코코로오 우고카시테"
    },
    {
      "t": 130.32,
      "text": "言の葉の世界が煌びやかに ひらり舞い踊る",
      "ko": "코토노하노 세카이가 키라비야카니 히라리 마이오도루"
    },
    {
      "t": 135,
      "text": "授かったものを 輝かしく育ててゆくまで",
      "ko": "사즈캇타 모노오 카가야카시쿠 소다테테 유쿠마데"
    },
    {
      "t": 140.2,
      "text": "崩れはしない 倒れない 決して壊れないものは",
      "ko": "쿠즈레와 시나이 타오레나이 켓시테 코와레나이 모노와"
    },
    {
      "t": 145.27,
      "text": "誇りある この絆",
      "ko": "호코리 아루 코노 키즈나"
    },
    {
      "t": 172.71,
      "text": "私たちの最果ては何処なのか",
      "ko": "와타시타치노 사이하테와 도코나노카"
    },
    {
      "t": 177.44,
      "text": "己の中を追い求め走り出す",
      "ko": "오노레노 나카오 오이모토메 하시리다스"
    },
    {
      "t": 182.46,
      "text": "この正解を手に入れるまでは",
      "ko": "코노 세-카이오 테니 이레루마데와"
    },
    {
      "t": 187.89,
      "text": "Are you ready? 容赦しない",
      "ko": "Are you ready? 요-샤 시나이"
    },
    {
      "t": 194.22,
      "text": "競い咲くように 命の anthem 嗚らして",
      "ko": "키소이 사쿠 요-니 이노치노 anthem 나라시테"
    },
