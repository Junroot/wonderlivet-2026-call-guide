  "lines": [
    {
      "t": 0.96,
      "text": "空がどんなたかくても",
      "ko": "소라가 돈나 타카쿠테모"
    },
    {
      "t": 6.82,
      "text": "羽根が千切れちっても",
      "ko": "하네가 치기레칫테모"
    },
    {
      "t": 12.83,
      "text": "飛び立つこと恐れずに",
      "ko": "토비타츠 코토 오소레즈니"
    },
    {
      "t": 18.85,
      "text": "焦がせ不死なる絆",
      "ko": "코가세 후시나루 키즈나"
    },
    {
      "t": 24.4,
      "text": "Fly to the sky, fire bird!",
      "ko": null
    },
    {
      "t": 35.61,
      "text": "「潰えぬ夢へ 燃え上がれ！」",
      "ko": "「츠이에누 유메에 모에아가레!」"
    },
    {
      "t": 40.04,
      "text": "Burning up",
      "ko": null
    },
    {
      "t": 43.2,
      "text": "Burning up",
      "ko": null
    },
    {
      "t": 46.64,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 48.32,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 49.87,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 51.41,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 52.83,
      "text": "暗闇でのぜつぼうも どうか怖がらないで",
      "ko": "쿠라야미데노 제츠보-모 도-카 코와가라나이데"
    },
    {
      "t": 58.92,
      "text": "貴方の胸いつだって 灯す夢があるから",
      "ko": "아나타노 무네 이츠닷테 토모스 유메가 아루카라"
    },
    {
      "t": 65.63,
      "text": "決断への(定めに)",
      "ko": "케츠단에노 (사다메니)"
    },
    {
      "t": 68.52,
      "text": "慟哭した(現実)",
      "ko": "도-코쿠시타 (겐지츠)"
    },
    {
      "t": 71.84,
      "text": "だけどそれは(愛ゆえの)",
      "ko": "다케도 소레와 (아이 유에노)"
    },
    {
      "t": 75.08,
      "text": "背負う未来だと",
      "ko": "세오우 츠바사다토"
    },
    {
      "t": 76.9,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 78.79,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 80.38,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 81.95,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 83.24,
      "text": "飛べよ鵬翼のヴァイオレット 火の鳥のように",
      "ko": "토베요 호-요쿠노 바이오렛토 히노토리노 요-니"
    },
    {
      "t": 89.49,
      "text": "We are 何度も歌い強くなった",
      "ko": "We are 난도모 우타이 츠요쿠 낫타"
    },
    {
      "t": 92.94,
      "text": "夢は負けない",
      "ko": "유메와 마케나이"
    },
    {
      "t": 95.21,
      "text": "貴女を連れて行きたいんだ",
      "ko": "아나타오 츠레테 이키타인다"
    },
    {
      "t": 99.19,
      "text": "絶世の天へ",
      "ko": "젯세-노 소라에"
    },
    {
      "t": 102.55,
      "text": "ゼロ距離で抱き締め合い 神話に記そう",
      "ko": "제로 쿄리데 다키시메아이 신와니 시루소-"
    },
    {
      "t": 108.62,
      "text": "この音の風で",
      "ko": "코노 오토노 카제데"
    },
    {
      "t": 111.92,
      "text": "そして新世界へ（Burning up）",
      "ko": "소시테 신세카이에 (Burning up)"
    },
    {
      "t": 116.94,
      "text": "Burning up",
      "ko": null
    },
    {
      "t": 120.18,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 121.84,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 123.68,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 125.24,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 126.34,
      "text": "泣きじゃくった あの夜の",
      "ko": "나키쟈쿳타 아노 요루노"
    },
    {
      "t": 129.59,
      "text": "答えはまだわからず",
      "ko": "코타에와 마다 와카라즈"
    },
    {
      "t": 132.89,
      "text": "だけど前に... 前だけに",
      "ko": "다케도 마에니... 마에다케니"
    },
    {
      "t": 135.95,
      "text": "きっとヒカリは刺すと",
      "ko": "킷토 히카리와 사스토"
    },
    {
      "t": 139.14,
      "text": "重低音と残光のこの聖なる領域で",
      "ko": "쥬-테-온토 잔코-노 코노 세-나루 료-이키데"
    },
    {
      "t": 145.51,
      "text": "不完全に(鉄槌を)",
      "ko": "후칸젠니 (텟츠이오)"
    },
    {
      "t": 148.73,
      "text": "本能のままに",
      "ko": "혼노-노 마마니"
    },
    {
      "t": 150.66,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 152.25,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 153.85,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 155.4,
      "text": "Lala, lalala",
      "ko": null
    },
    {
      "t": 156.66,
      "text": "舞えよ 暁に煌めく",
      "ko": "마에요 아카츠키니 키라메쿠"
    },
    {
      "t": 159.8,
      "text": "太陽のように",
      "ko": "타이요-노 요-니"
    },
    {
      "t": 163.3,
      "text": "We are 闇から逃げず 支え燃える",
      "ko": "We are 야미카라 니게즈 사사에 모에루"
    },
    {
      "t": 166.36,
      "text": "紅蓮の炎",
      "ko": "구렌노 호노오"
    },
    {
      "t": 168.88,
      "text": "幾千回拭ってもいいから",
      "ko": "이쿠센카이 누굿테모 이이카라"
    },
    {
      "t": 172.67,
      "text": "その手を伸ばせば",
      "ko": "소노 테오 노바세바"
    },
    {
      "t": 176.12,
      "text": "羽根に変わるんだと",
      "ko": "하네니 카와룬다토"
    },
    {
      "t": 179.02,
      "text": "信じて自分を",
      "ko": "신지테 지분오"
    },
    {
      "t": 182.57,
      "text": "信じて勇気を",
      "ko": "신지테 유-키오"
    },
    {
      "t": 185.46,
      "text": "そして明日へと",
      "ko": "소시테 아스에토"
    },
    {
      "t": 219.24,
      "text": "最初は上を見ることも",
      "ko": "사이쇼와 우에오 미루 코토모"
    },
    {
      "t": 225.46,
      "text": "空を望むことも怖かった",
      "ko": "소라오 노조무 코토모 코와캇타"
    },
    {
      "t": 231.71,
      "text": "カゴの中からの銀河は高く",
      "ko": "카고노 나카카라노 긴가와 타카쿠"
    },
    {
      "t": 238.16,
      "text": "その星の輝きに憧れては",
      "ko": "소노 호시노 카가야키니 아코가레테와"
    },
    {
      "t": 244.88,
      "text": "ただ眩しくて、ただ悔しくて",
      "ko": "타다 마부시쿠테, 타다 쿠야시쿠테"
    },
    {
      "t": 251.06,
      "text": "だけど今は、きっと此処から",
      "ko": "다케도 이마와, 킷토 코코카라"
    },
    {
      "t": 260.55,
      "text": "「羽撃こう... 頂点の夢へと」",
      "ko": "「하바타코-... 쵸-텐노 유메에토」"
    },
    {
      "t": 263.83,
      "text": "飛べよ鵬翼のヴァイオレット",
      "ko": "토베요 호-요쿠노 바이오렛토"
    },
    {
      "t": 267.04,
      "text": "火の鳥のように",
      "ko": "히노토리노 요-니"
    },
    {
      "t": 270.2,
      "text": "We are 再び誓う 頂点への",
      "ko": "We are 후타타비 치카우 쵸-텐에노"
    },
    {
      "t": 273.78,
      "text": "不滅のアンビション",
      "ko": "후메츠노 암비숀"
    },
    {
      "t": 276.04,
      "text": "貴方を連れて行きたいんだ 絶世の天へ",
      "ko": "아나타오 츠레테 이키타인다 젯세-노 소라에"
    },
    {
      "t": 283.29,
      "text": "終焉の楽園まで",
      "ko": "슈-엔노 라쿠엔마데"
    },
    {
      "t": 286.14,
      "text": "勇気と云う名の",
      "ko": "유-키토 이우 나노"
    },
    {
      "t": 289.38,
      "text": "音楽を地図に",
      "ko": "온가쿠오 치즈니"
    },
    {
      "t": 292.61,
      "text": "歌え新世界へ！(Burning up)",
      "ko": "우타에 신세카이에! (Burning up)"
    },
