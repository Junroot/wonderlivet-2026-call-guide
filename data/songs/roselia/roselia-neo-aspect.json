  "lines": [
    {
      "t": 0.32,
      "text": "美しき命の艶麗",
      "ko": "우츠쿠시키 이노치노 엔레-"
    },
    {
      "t": 3.61,
      "text": "紡がれた調べ 生まれゆく道",
      "ko": "츠무가레타 시라베 우마레유쿠 미치"
    },
    {
      "t": 8.5,
      "text": "Believe me this is the right way",
      "ko": null
    },
    {
      "t": 26.27,
      "text": "灯りは何処へ消えた? 手繰り寄せるように",
      "ko": "아카리와 도코에 키에타? 타구리요세루 요-니"
    },
    {
      "t": 32.67,
      "text": "伸ばす手は何も掴めないまま",
      "ko": "노바스 테와 나니모 츠카메나이 마마"
    },
    {
      "t": 37.66,
      "text": "息継ぎも上手くできず",
      "ko": "이키츠기모 우마쿠 데키즈"
    },
    {
      "t": 40.69,
      "text": "冷えた唇 黙り込む",
      "ko": "히에타 쿠치비루 다마리코무"
    },
    {
      "t": 47.57,
      "text": "Into (darkness, darkness)",
      "ko": null
    },
    {
      "t": 49.73,
      "text": "I feel (loneliness, loneliness)",
      "ko": null
    },
    {
      "t": 52.7,
      "text": "Your voice 心の裏側に触れた刹那",
      "ko": "Your voice 코코로노 우라가와니 후레타 세츠나"
    },
    {
      "t": 58.85,
      "text": "(Find a way, find a way)",
      "ko": null
    },
    {
      "t": 60.31,
      "text": "I know (loved one, loved one)",
      "ko": null
    },
    {
      "t": 62.92,
      "text": "もう一度繋ごう 手を",
      "ko": "모- 이치도 츠나고- 테오"
    },
    {
      "t": 68.93,
      "text": "きっと悔しくって 情けなくって",
      "ko": "킷토 쿠야시쿳테 나사케나쿳테"
    },
    {
      "t": 71.81,
      "text": "涙したって 此処にいるよ",
      "ko": "나미다 시탓테 코코니 이루요"
    },
    {
      "t": 74.83,
      "text": "扉は開けておくから",
      "ko": "토비라와 아케테 오쿠카라"
    },
    {
      "t": 78.71,
      "text": "I hold you",
      "ko": null
    },
    {
      "t": 80.06,
      "text": "Beautiful prouder",
      "ko": null
    },
    {
      "t": 81.15,
      "text": "So, beautiful braver",
      "ko": null
    },
    {
      "t": 82.4,
      "text": "So, beautiful brighter",
      "ko": null
    },
    {
      "t": 83.78,
      "text": "誇り高く (奏でたい)",
      "ko": "호코리 타카쿠 (카나데타이)"
    },
    {
      "t": 88.29,
      "text": "Ah on stage",
      "ko": null
    },
    {
      "t": 90.28,
      "text": "Sing away! Sing away!",
      "ko": null
    },
    {
      "t": 92.41,
      "text": "魅せよう 新たな姿を",
      "ko": "미세요- 아라타나 스가타오"
    },
    {
      "t": 96.29,
      "text": "Wo wo wow",
      "ko": null
    },
    {
      "t": 98.49,
      "text": "Wo wo wow",
      "ko": null
