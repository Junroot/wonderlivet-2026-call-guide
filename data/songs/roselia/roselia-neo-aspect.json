      "t": 103.97,
      "text": "Wo wo wow",
      "ko": null
    },
    {
      "t": 117.86,
      "text": "聴こえないフリをして",
      "ko": "키코에나이 후리오 시테"
    },
    {
      "t": 120.63,
      "text": "振り向かずにいた",
      "ko": "후리무카즈니 이타"
    },
    {
      "t": 123.27,
      "text": "感情に潰されないようにと",
      "ko": "칸죠-니 츠부사레나이 요-니토"
    },
    {
      "t": 128.46,
      "text": "知らず知らずのうちに",
      "ko": "시라즈 시라즈노 우치니"
    },
    {
      "t": 131.36,
      "text": "飲まれてく意志 薄れだす",
      "ko": "노마레테쿠 이시 우스레다스"
    },
    {
      "t": 137.63,
      "text": "I will (go ahead, go ahead)",
      "ko": null
    },
    {
      "t": 140.39,
      "text": "This is (destiny, destiny)",
      "ko": null
    },
    {
      "t": 143.05,
      "text": "Your eyes 瞳の裏側に灯る世界",
      "ko": "Your eyes 히토미노 우라가와니 토모루 세카이"
    },
    {
      "t": 149.31,
      "text": "(Find a way, find a way)",
      "ko": null
    },
    {
      "t": 151.06,
      "text": "You know (brightness, brightness)",
      "ko": null
    },
    {
      "t": 153.95,
      "text": "もう一度 始めよう今",
      "ko": "모- 이치도 하지메요- 이마"
    },
    {
      "t": 159.38,
      "text": "きっと辛くたって もどかしくって",
      "ko": "킷토 츠라쿠탓테 모도카시쿳테"
    },
    {
      "t": 162.24,
      "text": "躓いたって 傍に居るよ",
      "ko": "츠마즈이탓테 소바니 이루요"
    },
    {
      "t": 165.01,
      "text": "扉は開けておくから",
      "ko": "토비라와 아케테 오쿠카라"
    },
    {
      "t": 168.83,
      "text": "I got you",
      "ko": null
    },
    {
      "t": 170.85,
      "text": "夢に沿って 言葉に沿って",
      "ko": "유메니 솟테 코토바니 솟테"
    },
    {
      "t": 172.92,
      "text": "想いに沿って 駆け上がるわ (届けたい)",
      "ko": "오모이니 솟테 카케아가루와 (토도케타이)"
    },
    {
      "t": 178.85,
      "text": "Ah, on stage",
      "ko": null
    },
    {
      "t": 181.61,
      "text": "Only one! Only one!",
      "ko": null
    },
    {
      "t": 183.09,
      "text": "廻ろう 貴方の気持ちと",
      "ko": "마와로- 아나타노 키모치토"
    },
    {
      "t": 220.61,
      "text": "音粒を一つずつ 抱きしめるように歌うの",
      "ko": "오토츠부오 히토츠즈츠 다키시메루 요-니 우타우노"
    },
    {
      "t": 231.26,
      "text": "存在 stay alive, stay alive",
      "ko": "손자이 stay alive, stay alive"
    },
    {
      "t": 233.74,
      "text": "瞬間 stay alive, stay alive",
      "ko": "슌칸 stay alive, stay alive"
    },
    {
      "t": 236.28,
      "text": "強く感じたいよ 貴方たちを",
