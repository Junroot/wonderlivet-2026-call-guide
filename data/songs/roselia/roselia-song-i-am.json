    },
    {
      "t": 123.6,
      "text": "さらに気高く響け！",
      "ko": "사라니 케다카쿠 히비케!"
    },
    {
      "t": 126.76,
      "text": "(Song I am)",
      "ko": null
    },
    {
      "t": 128.23,
      "text": "この先 どんなに長い道のりだろうと",
      "ko": "코노 사키 돈나니 나가이 미치노리다로-토"
    },
    {
      "t": 131.66,
      "text": "(Song I am)",
      "ko": null
    },
    {
      "t": 133.22,
      "text": "何を恐れることがある？",
      "ko": "나니오 오소레루 코토가 아루?"
    },
    {
      "t": 136.95,
      "text": "選ぶ先は 正解しかないんだ",
      "ko": "에라부 사키와 세-카이시카 나인다"
    },
    {
      "t": 141.85,
      "text": "(Song I am)",
      "ko": null
    },
    {
      "t": 143.38,
      "text": "確かな運命を 今此処から",
      "ko": "타시카나 운메-오 이마 코코카라"
    },
    {
      "t": 145.67,
      "text": "Declare to be！",
      "ko": null
    },
    {
      "t": 165.96,
      "text": "Song I am",
      "ko": null
    },
    {
      "t": 194.97,
      "text": "(I am song)",
      "ko": null
    },
    {
      "t": 196.36,
      "text": "導き続けてくれたもの達へ贈ろう",
      "ko": "미치비키츠즈케테 쿠레타 모노타치에 오쿠로-"
    },
    {
      "t": 200.02,
      "text": "(I am song)",
      "ko": null
    },
    {
      "t": 201.51,
      "text": "感謝と そして想いを...",
      "ko": "칸샤토 소시테 오모이오..."
    },
    {
      "t": 205.25,
      "text": "私達が在る為の未来まで",
      "ko": "와타시타치가 아루 타메노 미라이마데"
