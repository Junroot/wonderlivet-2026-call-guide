    {
      "t": 252.5,
      "text": "未来永劫 咲き誇るのよ",
      "ko": "미라이에-고- 사키호코루노요"
    },
    {
      "t": 267.65,
      "text": "絆の薔薇よ 美しく (華ひらくとき)",
      "ko": "키즈나노 바라요 우츠쿠시쿠 (하나 히라쿠 토키)"
    },
    {
      "t": 273.22,
      "text": "私たちのモノガタリが (また始まるの)",
      "ko": "와타시타치노 모노가타리가 (마타 하지마루노)"
    }
