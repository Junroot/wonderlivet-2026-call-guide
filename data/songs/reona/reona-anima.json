  "lines": [
    {
      "t": 0.69,
      "text": "魂の色は 何色ですか",
      "ko": "타마시-노 이로와 나니이로데스카"
    },
    {
      "t": 17.38,
      "text": "「もういっそ 折れたままで」",
      "ko": "「모- 잇소 오레타 마마데」"
    },
    {
      "t": 20.43,
      "text": "捨てるほど 逃げ出すほど",
      "ko": "스테루호도 니게다스호도"
    },
    {
      "t": 24.26,
      "text": "強くないよ ほら",
      "ko": "츠요쿠나이요 호라"
    },
    {
      "t": 27.3,
      "text": "もう一度 鼓動、高鳴る",
      "ko": "모- 이치도 코도-, 타카나루"
    },
    {
      "t": 30.37,
      "text": "何が正しいかなんて",
      "ko": "나니가 타다시-카난테"
    },
    {
      "t": 34.08,
      "text": "わからないけど",
      "ko": "와카라나이케도"
    },
    {
      "t": 37.22,
      "text": "形のないものばかりが",
      "ko": "카타치노 나이 모노바카리가"
    },
    {
      "t": 42.27,
      "text": "大切になって行く",
      "ko": "타이세츠니 낫테 유쿠"
    },
    {
      "t": 47.4,
      "text": "飾らない言葉だけが",
      "ko": "카자라나이 코토바다케가"
    },
    {
      "t": 52.35,
      "text": "強く結ばれてる",
      "ko": "츠요쿠 무스바레테루"
    },
    {
      "t": 57.24,
      "text": "また 躓いて 転がって",
      "ko": "마타 츠마즈이테 코로갓테"
    },
    {
      "t": 59.85,
      "text": "それでも砕けない",
      "ko": "소레데모 쿠다케나이"
    },
    {
      "t": 62.37,
      "text": "魂の色は 何色ですか",
      "ko": "타마시-노 이로와 나니이로데스카"
    },
    {
      "t": 67.17,
      "text": "ただ 傷ついて 強がって",
      "ko": "타다 키즈츠이테 츠요갓테"
    },
    {
      "t": 69.75,
      "text": "それでも見つけたいよ",
      "ko": "소레데모 미츠케타이요"
    },
    {
      "t": 72.28,
      "text": "魂のカタチ 確かめてるよ",
      "ko": "타마시-노 카타치 타시카메테루요"
    },
    {
      "t": 88.37,
      "text": "深い地の底で一人",
      "ko": "후카이 치노 소코데 히토리"
    },
    {
      "t": 91.38,
      "text": "扉と鍵を探す",
      "ko": "토비라토 카기오 사가스"
    },
    {
      "t": 95.13,
      "text": "おとぎ話は ほら",
      "ko": "오토기바나시와 호라"
    },
    {
      "t": 98.13,
      "text": "泡の様に全部消えて",
      "ko": "아와노 요-니 젠부 키에테"
    },
    {
      "t": 101.28,
      "text": "葛藤、残像だけ",
      "ko": "캇토-, 잔조-다케"
    },
    {
      "t": 104.86,
      "text": "次の頁へ",
      "ko": "츠기노 페-지에"
    },
    {
      "t": 108.32,
      "text": "伸びてく枝葉が分かれて",
      "ko": "노비테쿠 에다하가 와카레테"
    },
    {
      "t": 113.07,
      "text": "それぞれの道を行く",
      "ko": "소레조레노 미치오 유쿠"
    },
    {
      "t": 118.12,
      "text": "寂しい思い出だけが",
      "ko": "사비시- 오모이데다케가"
    },
    {
      "t": 123.16,
      "text": "強く根を張ってる",
      "ko": "츠요쿠 네오 핫테루"
    },
    {
      "t": 130.61,
      "text": "まだ 貫いて 失って",
      "ko": "마다 츠라누이테 우시낫테"
    },
    {
      "t": 133.28,
      "text": "それでも挫けない",
      "ko": "소레데모 쿠지케나이"
    },
    {
      "t": 135.53,
      "text": "心はどこに 器はどこに",
      "ko": "코코로와 도코니 우츠와와 도코니"
    },
    {
      "t": 140.66,
      "text": "ただ 残されて 抜け落ちて",
      "ko": "타다 노코사레테 누케오치테"
    },
    {
      "t": 143.16,
      "text": "それでも伝えたいよ",
      "ko": "소레데모 츠타에타이요"
    },
    {
      "t": 145.51,
      "text": "魂の日々を 魂の意志を",
      "ko": "타마시-노 히비오 타마시-노 이시오"
    },
    {
      "t": 150.39,
      "text": "ずっと",
      "ko": "즛토"
    },
    {
      "t": 155.33,
      "text": "ずっと",
      "ko": "즛토"
    },
    {
