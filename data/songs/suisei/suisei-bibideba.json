  "lines": [
    {
      "t": 12.67,
      "text": "つまらないデイズもう散々ね！",
      "ko": "츠마라나이 데이즈 모- 산잔네!"
    },
    {
      "t": 14.56,
      "text": "奇蹟願っているだけの人生",
      "ko": "키세키 네갓테이루다케노 진세-"
    },
    {
      "t": 16.74,
      "text": "Watch me do, do-ru-do",
      "ko": null
    },
    {
      "t": 17.65,
      "text": "呪術秘中トリック無しのマジック",
      "ko": "쥬쥬츠 히츄- 토릭쿠 나시노 마직쿠"
    },
    {
      "t": 20.65,
      "text": "I wanna be free! だってまだふりだし",
      "ko": "I wanna be free! 닷테 마다 후리다시"
    },
    {
      "t": 23.02,
      "text": "(The party ain't started)",
      "ko": null
    },
    {
      "t": 24.81,
      "text": "Hey タクシー ちょっと宇宙迄",
      "ko": "Hey 타쿠시- 춋토 우츄-마데"
    },
    {
      "t": 28.17,
      "text": "秒針は音を立てて夜を急かす魔物のよう",
      "ko": "뵤-신와 오토오 타테테 요루오 세카스 마모노노 요-"
    },
    {
      "t": 36.14,
      "text": "人生は一瞬にして溶ける魔法",
      "ko": "진세-와 잇슌니 시테 토케루 마호-"
    },
    {
      "t": 41.21,
      "text": "それならば駆け抜けて想通り！",
      "ko": "소레나라바 카케누케테 오모이도-리!"
    },
    {
      "t": 46.07,
      "text": "おしゃまな馬車 飛び乗ってdrivin'",
      "ko": "오샤마나 바샤 토비놋테 drivin'"
    },
    {
      "t": 48.66,
      "text": "あたしは大変身メイクアップ！",
      "ko": "아타시와 다이헨신 메이크압푸!"
    },
    {
      "t": 50.64,
      "text": "我儘のまにまに 燦きに注意",
      "ko": "와가마마노 마니마니 키라메키니 츄-이"
    },
    {
      "t": 54.55,
      "text": "洒落な街でdancin'",
      "ko": "샤레나 마치데 dancin'"
    },
    {
      "t": 56.7,
      "text": "左様なら グッバイ劣等感",
      "ko": "사요-나라 굿바이 렛토-칸"
    },
    {
      "t": 58.66,
      "text": "何時かは 喝采クラップオウデエンス",
      "ko": "이츠카와 캇사이 쿠랍푸 오-디엔스"
    },
    {
      "t": 60.85,
      "text": "皆皆 御唱和あれ！",
      "ko": "미나미나 고쇼-와 아레!"
    },
    {
      "t": 63.12,
      "text": "Bibbidi bobbidi boowa",
      "ko": null
    },
    {
      "t": 64.78,
      "text": "Bibbidi bobbidi boowa, yeah",
      "ko": null
    },
    {
      "t": 67.21,
      "text": "混絡がっても仕様が無い",
      "ko": "콘가랏테모 쇼-가 나이"
    },
    {
      "t": 68.94,
      "text": "ガラスシューズで踊るtonight",
      "ko": "가라스 슈-즈데 오도루 tonight"
    },
    {
      "t": 71.12,
      "text": "Bibbidi bobbidi boowa",
      "ko": null
    },
    {
      "t": 72.85,
      "text": "Bibbidi bobbidi boowa, yeah",
      "ko": null
    },
    {
      "t": 75.2,
      "text": "今夜に明日など無い",
      "ko": "콘야니 아시타나도 나이"
    },
    {
      "t": 76.71,
      "text": "ならば自由に踊った者勝ちでしょう？",
      "ko": "나라바 지유-니 오돗타 모노가치데쇼-?"
    },
    {
      "t": 82.42,
      "text": "Da-da-da-dance! ラリラリホ",
      "ko": "Da-da-da-dance! 라리라리호"
    },
    {
      "t": 84.6,
      "text": "どんな問題も解は一つ",
      "ko": "돈나 몬다이모 카이와 히토츠"
    },
    {
      "t": 86.65,
      "text": "白紙も正解も間違いも愛す",
      "ko": "하쿠시모 세-카이모 마치가이모 아이스"
    },
    {
      "t": 88.84,
      "text": "本当のあたしの理想",
      "ko": "혼토-노 아타시노 리소-"
    },
    {
      "t": 90.39,
      "text": "Ah 何だか世界は限界の気配がして",
      "ko": "Ah 난다카 세카이와 겐카이노 케하이가 시테"
    },
    {
      "t": 94.53,
      "text": "Oh ただただ安心じゃあ心配",
      "ko": "Oh 타다타다 안신쟈- 심파이"
    },
    {
      "t": 96.72,
      "text": "Ah 今すぐjumpin', jumpin' out",
      "ko": "Ah 이마스구 jumpin', jumpin' out"
    },
    {
      "t": 99.21,
      "text": "Chitty chitty bang bang",
      "ko": null
    },
    {
      "t": 100.18,
      "text": "Chitty bang bang",
      "ko": null
    },
    {
      "t": 100.99,
      "text": "唯唯諾諾に危機感抱く日々に",
      "ko": "이이다쿠다쿠니 키키칸 이다쿠 히비니"
    },
    {
      "t": 103.21,
      "text": "ぎりぎり爆発気味",
      "ko": "기리기리 바쿠하츠기미"
    },
    {
      "t": 104.31,
      "text": "たった今発散してしまおうか",
      "ko": "탓타 이마 핫산시테 시마오-카"
    },
    {
      "t": 106.71,
      "text": "まだまだビイビイ弾巧みに乱射",
      "ko": "마다마다 비-비-단 타쿠미니 란샤"
    },
    {
      "t": 108.93,
      "text": "一発じゃあ撃ち足りないわ",
      "ko": "잇파츠쟈- 우치타리나이와"
    },
    {
      "t": 110.53,
      "text": "ついに導き出した君にアンサー",
      "ko": "츠이니 미치비키다시타 키미니 안사-"
    },
    {
      "t": 112.93,
      "text": "灰に成る迄踊って居よう",
      "ko": "하이니 나루마데 오돗테 이요-"
