  "durationSec": 233.47,
  "lines": [
    {
      "t": 17.31,
      "text": "あの黄昏も 折り畳めば静寂",
      "ko": "아노 타소가레모 오리타타메바 세-자쿠"
    },
    {
      "t": 22.65,
      "text": "僕らの街じゃ 暗がりは合図だ",
      "ko": "보쿠라노 마치쟈 쿠라가리와 아이즈다"
    },
    {
      "t": 28.2,
      "text": "灯を消して はじめよう 幕よ開け",
      "ko": "히오 케시테 하지메요- 마쿠요 아케"
    },
    {
      "t": 33.56,
      "text": "見上げ願いを あなたのように",
      "ko": "미아게 네가이오 아나타노 요-니"
    },
    {
      "t": 37.95,
      "text": "変わらず在っていたい",
      "ko": "카와라즈 앗테이타이"
    },
    {
      "t": 40.57,
      "text": "きらめきのヴェールを",
      "ko": "키라메키노 베-루오"
    },
    {
      "t": 43.49,
      "text": "目元に箒星 描いて",
      "ko": "메모토니 호-키보시 에가이테"
    },
    {
      "t": 48.14,
      "text": "瞬いた ソワレ 今だ",
      "ko": "마타타이타 소와레 이마다"
    },
    {
      "t": 51.32,
      "text": "寝息を立てる太陽の目を盗んで",
      "ko": "네이키오 타테루 타이요-노 메오 누슨데"
    },
    {
      "t": 56.16,
      "text": "大脱走さ 逃げ出そうぜ",
      "ko": "다이닷소-사 니게다소-제"
    },
    {
      "t": 58.96,
      "text": "朝未き空を跨ぐ 栞を挟んだら",
      "ko": "아사마다키 소라오 마타구 시오리오 하산다라"
    },
    {
      "t": 64.44,
      "text": "行かなくちゃ ソワレ",
      "ko": "이카나쿠챠 소와레"
    },
    {
      "t": 67.1,
      "text": "夜が明けるまでさ",
      "ko": "요가 아케루마데사"
    },
    {
      "t": 69.25,
      "text": "もうすこし このままで",
      "ko": "모- 스코시 코노 마마데"
    },
    {
      "t": 83.91,
      "text": "あの鐘の音は",
      "ko": "아노 카네노 네와"
    },
    {
      "t": 86.18,
      "text": "茜差したって止まない",
      "ko": "아카네 사시탓테 야마나이"
    },
    {
      "t": 89.56,
      "text": "時間だ 集まろう",
      "ko": "지칸다 아츠마로-"
    },
    {
      "t": 91.5,
      "text": "野望に喝采 エールを",
      "ko": "야보-니 캇사이 에-루오"
    },
    {
      "t": 94.93,
      "text": "未来の話を",
      "ko": "미라이노 하나시오"
    },
    {
      "t": 97.06,
      "text": "寂しそうに聞いてる君に",
      "ko": "사비시소-니 키이테루 키미니"
    },
    {
      "t": 100.45,
      "text": "誓うよ 世界に魔法がなくたって",
      "ko": "치카우요 세카이니 마호-가 나쿠탓테"
    },
    {
      "t": 104.65,
      "text": "夢は続いていく",
      "ko": "유메와 츠즈이테 이쿠"
    },
    {
      "t": 107.48,
      "text": "おやすみに代わるよう",
      "ko": "오야스미니 카와루요-"
    },
    {
      "t": 110.19,
      "text": "鳴りやまないメロディー 届けて",
      "ko": "나리야마나이 메로디- 토도케테"
    },
    {
      "t": 115.05,
      "text": "見逃すな ソワレ 僕ら目撃者だ",
      "ko": "미노가스나 소와레 보쿠라 모쿠게키샤다"
    },
    {
      "t": 119.58,
      "text": "蒼穹に手を伸ばした",
      "ko": "소-큐-니 테오 노바시타"
    },
    {
      "t": 122.86,
      "text": "水平線がうたた寝したって",
      "ko": "스이헤-센가 우타타네시탓테"
    },
    {
      "t": 125.91,
      "text": "とめどなく日々を繋ぐ",
      "ko": "토메도나쿠 히비오 츠나구"
    },
    {
      "t": 129.11,
      "text": "架け橋 渡ったら",
      "ko": "카케하시 와탓타라"
    },
    {
      "t": 131.31,
      "text": "いつの日か ソワレ 君に届くまでさ",
      "ko": "이츠노 히카 소와레 키미니 토도쿠마데사"
    },
    {
      "t": 136.14,
      "text": "何度でも 呼び声を",
      "ko": "난도데모 요비고에오"
    },
    {
      "t": 140.08,
      "text": "【Star tail】 消えない軌跡 辿って",
      "ko": "【Star tail】 키에나이 키세키 타돗테"
    },
    {
      "t": 145.43,
      "text": "【Star tale】",
      "ko": null
    },
    {
      "t": 146.98,
      "text": "幾星霜の果てへ どこまでも",
      "ko": "이쿠세이소-노 하테에 도코마데모"
    },
    {
      "t": 162.27,
      "text": "一晩じゃ語り尽くせない悲劇も",
      "ko": "히토반쟈 카타리츠쿠세나이 히게키모"
    },
    {
      "t": 167.81,
      "text": "一晩中 語り明かせたら",
      "ko": "히토반쥬- 카타리아카세타라"
    },
    {
      "t": 172.12,
      "text": "喜劇になってゆく",
      "ko": "키게키니 낫테 유쿠"
    },
    {
      "t": 174.05,
      "text": "【Star tail】 聞かせてよ",
      "ko": "【Star tail】 키카세테요"
    },
    {
      "t": 176.89,
      "text": "【Star tail】 一筋の",
      "ko": "【Star tail】 히토스지노"
    },
    {
      "t": 179.56,
      "text": "【Star tale】",
      "ko": null
    },
    {
      "t": 183.07,
      "text": "瞬いた ソワレ 今だ",
      "ko": "마타타이타 소와레 이마다"
    },
    {
      "t": 186.4,
      "text": "寝息を立てる太陽の目を盗んで",
      "ko": "네이키오 타테루 타이요-노 메오 누슨데"
    },
    {
      "t": 191,
      "text": "大脱走さ 逃げ出そうぜ",
      "ko": "다이닷소-사 니게다소-제"
    },
    {
      "t": 194.04,
      "text": "朝未き空を跨ぐ 栞を挟んだら",
      "ko": "아사마다키 소라오 마타구 시오리오 하산다라"
    },
    {
      "t": 199.43,
      "text": "約束だ ソワレ 僕が眠るまでは",
      "ko": "야쿠소쿠다 소와레 보쿠가 네무루마데와"
    },
    {
      "t": 204.28,
      "text": "何度でも また明日",
      "ko": "난도데모 마타 아시타"
    },
    {
      "t": 212.73,
      "text": "拝啓 ソワレ",
      "ko": "하이케- 소와레"
    },
    {
      "t": 214.36,
      "text": "君へ詠み継がれる 僕たちの物語",
      "ko": "키미에 요미츠가레루 보쿠타치노 모노가타리"
    }
  ],
