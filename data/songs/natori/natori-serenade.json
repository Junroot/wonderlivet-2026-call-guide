  "durationSec": 218,
  "lines": [
    {
      "t": 9.1,
      "text": "都合のいい思いを燃やして",
      "ko": "츠고-노 이- 오모이오 모야시테"
    },
    {
      "t": 12.73,
      "text": "呆れた願いはもう手放した",
      "ko": "아키레타 네가이와 모- 테바나시타"
    },
    {
      "t": 16.37,
      "text": "裏切りや秘密が漂って、ここから動けない",
      "ko": "우라기리야 히미츠가 타다욧테, 코코카라 우고케나이"
    },
    {
      "t": 22.66,
      "text": "生まれてしまった、あるいは壊れてしまった",
      "ko": "우마레테 시맛타, 아루이와 코와레테 시맛타"
    },
    {
      "t": 25.66,
      "text": "あの日あの場所で",
      "ko": "아노 히 아노 바쇼데"
    },
    {
      "t": 26.71,
      "text": "ずっと、止まったままでいた未来",
      "ko": "즛토, 토맛타 마마데 이타 미라이"
    },
    {
      "t": 29.64,
      "text": "それでも、心のどこかで君を感じていた",
      "ko": "소레데모, 코코로노 도코카데 키미오 칸지테이타"
    },
    {
      "t": 33.22,
      "text": "許せない、今の僕は誰？",
      "ko": "유루세나이, 이마노 보쿠와 다레?"
    },
    {
      "t": 36.67,
      "text": "ねぇ、ずっとずっとそばにいたんだ",
      "ko": "네-, 즛토 즛토 소바니 이탄다"
    },
    {
      "t": 39.01,
      "text": "「勘違いだ」って、嘘じゃないよ",
      "ko": "「칸치가이」닷테, 우소쟈나이요"
    },
    {
      "t": 40.85,
      "text": "望んだものじゃなくとも",
      "ko": "노존다 모노쟈나쿠토모"
    },
    {
      "t": 43.38,
      "text": "あなたに出会えた痛みだけが",
      "ko": "아나타니 데아에타 이타미다케가"
    },
    {
      "t": 47.13,
      "text": "愛だって信じられるように",
      "ko": "아이닷테 신지라레루 요-니"
    },
    {
      "t": 50.19,
      "text": "僕に触れないで！",
      "ko": "보쿠니 후레나이데!"
    },
    {
      "t": 51.85,
      "text": "祈る、セレナーデ",
      "ko": "이노루, 세레나-데"
    },
    {
      "t": 53.56,
      "text": "僕なしで上手く幸せになってね",
      "ko": "보쿠 나시데 우마쿠 시아와세니 낫테네"
    },
    {
      "t": 57.11,
      "text": "誰よりもずっと、何を手放しても",
      "ko": "다레요리모 즛토, 나니오 테바나시테모"
    },
    {
      "t": 60.68,
      "text": "これが愛だって信じていた、罰をください",
      "ko": "코레가 아이닷테 신지테이타, 바츠오 쿠다사이"
    },
    {
      "t": 66.08,
      "text": "誰でもない、あなた あなただけ",
      "ko": "다레데모 나이, 아나타 아나타다케"
    },
    {
      "t": 69.19,
      "text": "世界がまだ忘れてくれなくても",
      "ko": "세카이가 마다 와스레테 쿠레나쿠테모"
    },
    {
      "t": 72.91,
      "text": "きっと、まだ あなた あなただけ",
      "ko": "킷토, 마다 아나타 아나타다케"
    },
    {
      "t": 76.2,
      "text": "願い疲れても歌うよ、セレナーデ",
      "ko": "네가이 츠카레테모 우타우요, 세레나-데"
    },
    {
      "t": 83.22,
      "text": "願い疲れても歌うよ、セレナーデ",
      "ko": "네가이 츠카레테모 우타우요, 세레나-데"
    },
    {
      "t": 88.99,
      "text": "シナリオ通りのコメディ",
      "ko": "시나리오 도-리노 코메디"
    },
    {
      "t": 90.86,
      "text": "不幸自慢はハウメニー？",
      "ko": "후코- 지만와 하우메니-?"
    },
    {
      "t": 92.72,
      "text": "エゴイスティックに光った瞳の中に映っている",
      "ko": "에고이스틱쿠니 히캇타 히토미노 나카니 우츳테이루"
    },
    {
      "t": 95.33,
      "text": "「あなた」は「誰？」",
      "ko": "「아나타」와 「다레?」"
    },
    {
      "t": 96.25,
      "text": "暗闇が光らせた舞台の上で",
      "ko": "쿠라야미가 히카라세타 부타이노 우에데"
    },
    {
      "t": 97.8,
      "text": "何も知らずにただ踊っていられたならよかった",
      "ko": "나니모 시라즈니 타다 오돗테 이라레타나라 요캇타"
    },
    {
      "t": 102.31,
      "text": "希望も不幸も身勝手だ",
      "ko": "키보-모 후코-모 미갓테다"
    },
    {
      "t": 104.24,
      "text": "僕らは、全員共犯者だった",
      "ko": "보쿠라와, 젠인 쿄-한샤닷타"
    },
    {
      "t": 106.5,
      "text": "疑う余地もないほど",
      "ko": "우타가우 요치모 나이호도"
    },
    {
      "t": 109.24,
      "text": "運命が定まった、あの夜から",
      "ko": "운메-가 사다맛타, 아노 요루카라"
    },
    {
      "t": 112.42,
      "text": "僕は愛し方を忘れた",
      "ko": "보쿠와 아이시카타오 와스레타"
    },
    {
      "t": 115.77,
      "text": "これだけ願って、これだけ祈って",
      "ko": "코레다케 네갓테, 코레다케 이놋테"
    },
    {
      "t": 119.21,
      "text": "こんな、悲しい結末でごめんね",
      "ko": "콘나, 카나시- 케츠마츠데 고멘네"
    },
    {
      "t": 122.73,
      "text": "すべて失って、すべて消え去っても",
      "ko": "스베테 우시낫테, 스베테 키에삿테모"
    },
    {
      "t": 126.32,
      "text": "ただ、君がずっと生きていた痛みが欲しい",
      "ko": "타다, 키미가 즛토 이키테이타 이타미가 호시-"
    },
    {
      "t": 145.03,
      "text": "あと、何回数えたら",
      "ko": "아토, 난카이 카조에타라"
    },
    {
      "t": 146.62,
      "text": "あと、何回傷つけば",
      "ko": "아토, 난카이 키즈츠케바"
    },
    {
      "t": 148.54,
      "text": "あと、何回失えば",
      "ko": "아토, 난카이 우시나에바"
    },
    {
      "t": 150.39,
      "text": "あと、何回壊れたら",
      "ko": "아토, 난카이 코와레타라"
    },
    {
      "t": 152,
      "text": "あと、何回数えたら",
      "ko": "아토, 난카이 카조에타라"
    },
