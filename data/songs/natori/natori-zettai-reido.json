  "lines": [
    {
      "t": 0.6,
      "text": "泣き声、遠く 息を合わせて、もう一度",
      "ko": "나키고에, 토-쿠 이키오 아와세테, 모- 이치도"
    },
    {
      "t": 4.59,
      "text": "そんな、僕らの未来を強く願う歌",
      "ko": "손나, 보쿠라노 미라이오 츠요쿠 네가우 우타"
    },
    {
      "t": 18.07,
      "text": "革命前夜、僕たちの声は",
      "ko": "카쿠메- 젠야, 보쿠타치노 코에와"
    },
    {
      "t": 20.38,
      "text": "夜明け前にかき消されていく",
      "ko": "요아케 마에니 카키케사레테이쿠"
    },
    {
      "t": 22.38,
      "text": "ネガ、エゴ、嫉妬、くだらない悪意",
      "ko": "네가, 에고, 싯토, 쿠다라나이 아쿠이"
    },
    {
      "t": 24.33,
      "text": "それすらも飲み込んだ、スーパーヒーロー",
      "ko": "소레스라모 노미콘다, 스-파-히-로-"
    },
    {
      "t": 26.72,
      "text": "息継ぎだって、ギリギリな僕らは",
      "ko": "이키츠기닷테, 기리기리나 보쿠라와"
    },
    {
      "t": 28.97,
      "text": "目と目、合わせて 合図して",
      "ko": "메토 메, 아와세테 아이즈시테"
    },
    {
      "t": 30.56,
      "text": "声にならない声が、確かに聞こえていたんだ",
      "ko": "코에니 나라나이 코에가, 타시카니 키코에테이탄다"
    },
    {
      "t": 34.24,
      "text": "いやいや、その愛を守るために",
      "ko": "이야이야, 소노 아이오 마모루 타메니"
    },
    {
      "t": 36.26,
      "text": "今、必要なのはそんな言い訳じゃないぜ",
      "ko": "이마, 히츠요-나노와 손나 이-와케쟈나이제"
    },
    {
      "t": 39.31,
      "text": "決められることのない、ありふれた未来を",
      "ko": "키메라레루 코토노 나이, 아리후레타 미라이오"
    },
    {
      "t": 43.56,
      "text": "全部、燃やし尽くして 絶対零度",
      "ko": "젠부, 모야시츠쿠시테 젯타이레-도"
    },
    {
      "t": 46.28,
      "text": "理由も体裁も関係ない",
      "ko": "리유-모 테-사이모 칸케-나이"
    },
    {
      "t": 48.36,
      "text": "もう、フラッシュバック＆ディスコミュニケーション！",
      "ko": "모-, 후랏슈박쿠 & 디스코뮤니케-숀!"
    },
    {
      "t": 51.86,
      "text": "きっと、僕ら 不安定な延長線上",
      "ko": "킷토, 보쿠라 후안테-나 엔쵸-센죠-"
    },
    {
      "t": 54.93,
      "text": "聞こえた、いつの日のエスオーエス",
      "ko": "키코에타, 이츠노 히노 에스오-에스"
    },
    {
      "t": 56.95,
      "text": "そう、何度だって",
      "ko": "소-, 난도닷테"
    },
    {
      "t": 58.0,
      "text": "繰り返してよベイベー、地獄のなる方へ",
      "ko": "쿠리카에시테요 베이베-, 지고쿠노 나루 호-에"
    },
    {
      "t": 70.28,
      "text": "全く以って、つまらない",
      "ko": "맛타쿠 못테, 츠마라나이"
    },
    {
      "t": 71.64,
      "text": "錆び臭い街の匂いや喧騒に罰×10",
      "ko": "사비쿠사이 마치노 니오이야 켄소-니 바츠텐"
    },
    {
      "t": 74.59,
      "text": "被害者づらする善悪にとどめを刺してくれ",
      "ko": "히가이샤즈라 스루 젠아쿠니 토도메오 사시테쿠레"
    },
    {
      "t": 78.94,
      "text": "全く以って、つまらない",
      "ko": "맛타쿠 못테, 츠마라나이"
    },
    {
      "t": 80.48,
      "text": "錆び臭い街の匂いや喧騒に罰×10",
      "ko": "사비쿠사이 마치노 니오이야 켄소-니 바츠텐"
    },
    {
      "t": 83.21,
      "text": "被害者づらする善悪にとどめを刺して！",
      "ko": "히가이샤즈라 스루 젠아쿠니 토도메오 사시테!"
    },
    {
      "t": 87.07,
      "text": "全部、燃やし尽くして 絶対零度",
      "ko": "젠부, 모야시츠쿠시테 젯타이레-도"
    },
    {
      "t": 89.65,
      "text": "奪って、奪い返す 前哨戦",
      "ko": "우밧테, 우바이카에스 젠쇼-센"
    },
    {
      "t": 91.67,
      "text": "もう、フラッシュバック＆ディスコミュニケーション！",
      "ko": "모-, 후랏슈박쿠 & 디스코뮤니케-숀!"
    },
    {
      "t": 95.32,
      "text": "きっと、僕ら 不安定な感情線上",
      "ko": "킷토, 보쿠라 후안테-나 칸죠-센죠-"
    },
    {
      "t": 98.35,
      "text": "途絶えた、いつの日のエスオーエス",
      "ko": "토다에타, 이츠노 히노 에스오-에스"
    },
    {
      "t": 100.34,
      "text": "そう、何度だって",
      "ko": "소-, 난도닷테"
    },
    {
      "t": 101.42,
      "text": "思い出してよベイベー",
      "ko": "오모이다시테요 베이베-"
    },
    {
      "t": 102.84,
      "text": "確かに今も、ずっと鳴り止まないで",
      "ko": "타시카니 이마모, 즛토 나리야마나이데"
    },
    {
      "t": 105.9,
      "text": "僕らを揺らした、ロックンロールのように",
      "ko": "보쿠라오 유라시타, 롯쿤로-루노 요-니"
    },
    {
      "t": 108.9,
      "text": "臆病にさえ苛立つ、僕の愚かさも",
      "ko": "오쿠뵤-니 사에 이라다츠, 보쿠노 오로카사모"
    },
    {
      "t": 111.31,
      "text": "消せない過去の痛みも",
      "ko": "케세나이 카코노 이타미모"
    },
    {
      "t": 113.42,
      "text": "全部を抱えて、歩いていくんだ",
      "ko": "젠부오 카카에테, 아루이테이쿤다"
    },
    {
      "t": 117.74,
      "text": "全部を抱えて、歩いていくんだ",
      "ko": "젠부오 카카에테, 아루이테이쿤다"
    },
    {
      "t": 126.19,
      "text": "全部、燃やし尽くして 絶対零度",
