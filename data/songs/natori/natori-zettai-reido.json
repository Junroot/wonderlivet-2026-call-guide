    },
    {
      "t": 149.28,
      "text": "この、感情がまた叫んでんだって ずっと！",
      "ko": "코노, 칸죠-가 마타 사켄덴닷테 즛토!"
    },
    {
      "t": 152.71,
      "text": "泣き声、遠く 息を合わせて、もう一度",
      "ko": "나키고에, 토-쿠 이키오 아와세테, 모- 이치도"
    },
    {
      "t": 156.69,
      "text": "奪われることのない、ありふれた未来を",
      "ko": "우바와레루 코토노 나이, 아리후레타 미라이오"
    },
    {
      "t": 160.56,
      "text": "なぁなぁなぁ、運命がなんだって",
      "ko": "나- 나- 나-, 운메-가 난닷테"
    },
    {
      "t": 163.45,
      "text": "なぁ、絶望がなんだって",
      "ko": "나-, 제츠보-가 난닷테"
    },
    {
      "t": 165.59,
      "text": "その目に映った、全部を抱えて",
      "ko": "소노 메니 우츳타, 젠부오 카카에테"
    },
    {
      "t": 167.89,
      "text": "生きていくんだ、間違いないさ",
      "ko": "이키테이쿤다, 마치가이나이사"
    },
    {
      "t": 170.03,
      "text": "夜明けが来なくたって",
      "ko": "요아케가 코나쿠탓테"
    },
    {
      "t": 172.11,
      "text": "雨が降り止まなくたって",
      "ko": "아메가 후리야마나쿠탓테"
    },
    {
      "t": 174.06,
      "text": "凍てつくほど燃えている、絶対零度",
      "ko": "이테츠쿠 호도 모에테이루, 젯타이레-도"
