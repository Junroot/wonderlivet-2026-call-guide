  "lines": [
    {
      "t": 9.98,
      "text": "そこに愛 集った",
      "ko": "소코니 아이 츠돗타"
    },
    {
      "t": 12.75,
      "text": "形だけのモンスターが育った",
      "ko": "카타치다케노 몬스타-가 소닷타"
    },
    {
      "t": 15.35,
      "text": "それを愛さなくちゃ",
      "ko": "소레오 아이사나쿠챠"
    },
    {
      "t": 18.47,
      "text": "「ダメだった」から「躊躇った」",
      "ko": "「다메닷타」카라 「타메랏타」"
    },
    {
      "t": 20.82,
      "text": "「どうして 僕ばっか？」",
      "ko": "「도-시테 보쿠박카?」"
    },
    {
      "t": 23.61,
      "text": "とか 思えたバスタイムも束の間",
      "ko": "토카 오모에타 바스타이무모 츠카노마"
    },
    {
      "t": 26.31,
      "text": "どれも綺麗だったが",
      "ko": "도레모 키레-닷타가"
    },
    {
      "t": 29.14,
      "text": "どれも嫌いだった",
      "ko": "도레모 키라이닷타"
    },
    {
      "t": 33.06,
      "text": "どう 頑張っても僕は普通",
      "ko": "도- 감밧테모 보쿠와 후츠-"
    },
    {
      "t": 35.52,
      "text": "この 生涯全部ビビディバビヴー",
      "ko": "코노 쇼-가이 젠부 비비디바비부-"
    },
    {
      "t": 38.42,
      "text": "どうしようもないこと吐く 白昼夢に",
      "ko": "도-시요-모 나이 코토 하쿠 하쿠츄-무니"
    },
    {
      "t": 41.13,
      "text": "今世紀最期のプロポーズをしよう",
      "ko": "콘세-키 사이고노 프로포-즈오 시요-"
    },
    {
      "t": 44.11,
      "text": "「嫌われちゃったら どうしよう？」",
      "ko": "「키라와레챳타라 도-시요-?」"
    },
    {
      "t": 46.37,
      "text": "とか 考えてんの色々",
      "ko": "토카 캉가에텐노 이로이로"
    },
    {
      "t": 49.42,
      "text": "「嫌われちゃったら どうしよう？」",
      "ko": "「키라와레챳타라 도-시요-?」"
    },
    {
      "t": 51.73,
