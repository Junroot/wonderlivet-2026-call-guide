    {
      "t": 17.31,
      "text": "本当は分かっていた",
      "ko": "혼토-와 와캇테이타"
    },
    {
      "t": 18.89,
      "text": "いけないことだったって 分かっていたのに",
      "ko": "이케나이 코토닷탓테 와캇테이타노니"
    },
    {
      "t": 21.17,
      "text": "この手をすり抜ける全部が愛に見えたの",
      "ko": "코노 테오 스리누케루 젠부가 아이니 미에타노"
    },
    {
      "t": 25.44,
      "text": "確かめていた言葉が形になって、揺れるだけ",
      "ko": "타시카메테이타 코토바가 카타치니 낫테, 유레루다케"
    },
    {
      "t": 33,
      "text": "弾いて 描いて きっと それだけ",
      "ko": "하지이테 카이테 킷토 소레다케"
    },
    {
      "t": 35.59,
      "text": "つまらないな 正解の読み合わせ",
