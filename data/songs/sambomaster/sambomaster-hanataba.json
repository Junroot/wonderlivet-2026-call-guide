  "lines": [
    {
      "t": null,
      "text": "この花束を あなたに贈りたいんだ",
      "ko": "코노 하나타바오 아나타니 오쿠리타인다"
    },
    {
      "t": null,
      "text": "この花束 あなたに贈りたいんだ",
      "ko": "코노 하나타바 아나타니 오쿠리타인다"
    },
    {
      "t": null,
      "text": "Acacia, Lavender そう、恋が生まれるほど",
      "ko": "Acacia, Lavender 소-, 코이가 우마레루호도"
    },
    {
      "t": null,
      "text": "花言葉なんて 今は気にしちゃダメなのさ",
      "ko": "하나코토바난테 이마와 키니 시챠 다메나노사"
    },
    {
      "t": null,
      "text": "僕たちは たくさんのさびしさ悲しさを",
      "ko": "보쿠타치와 타쿠산노 사비시사 카나시사오"
    },
    {
      "t": null,
      "text": "抱きしめたけど 今日から変わるの",
      "ko": "다키시메타케도 쿄-카라 카와루노"
    },
    {
      "t": null,
      "text": "この花束を 今すぐ届けたいんだ",
      "ko": "코노 하나타바오 이마스구 토도케타인다"
    },
    {
      "t": null,
      "text": "この花束 今すぐ届けたいんだ",
      "ko": "코노 하나타바 이마스구 토도케타인다"
    },
    {
      "t": null,
      "text": "アスファルトの固さを つき破りだして",
      "ko": "아스파루토노 카타사오 츠키야부리다시테"
    },
    {
      "t": null,
      "text": "のびてく草木のように 強い君だったはずさ",
      "ko": "노비테쿠 쿠사키노 요-니 츠요이 키미닷타 하즈사"
    },
    {
      "t": null,
      "text": "僕たちは たくさんの捨てちまいたい",
      "ko": "보쿠타치와 타쿠산노 스테치마이타이"
    },
    {
      "t": null,
      "text": "夜を数えたけれど 今日から変わるの",
      "ko": "요루오 카조에타케레도 쿄-카라 카와루노"
    },
    {
      "t": null,
      "text": "信じてんぜ君を だからあなたに贈りたいんだ",
      "ko": "신지텐제 키미오 다카라 아나타니 오쿠리타인다"
    },
    {
      "t": null,
      "text": "花束 花束 いろんな色の",
      "ko": "하나타바 하나타바 이론나 이로노"
    },
    {
      "t": null,
      "text": "くよくよするなよ（するなよ）そう昔から気づいてた",
      "ko": "쿠요쿠요 스루나요 (스루나요) 소- 무카시카라 키즈이테타"
    },
    {
      "t": null,
      "text": "あなたは あなたは ぬくもり取り戻せる人",
      "ko": "아나타와 아나타와 누쿠모리 토리모도세루 히토"
    },
    {
      "t": null,
      "text": "今新たな 想いが生まれそうさ",
      "ko": "이마 아라타나 오모이가 우마레소-사"
    },
    {
      "t": null,
      "text": "今新たな 想いが生まれそうなのさ",
      "ko": "이마 아라타나 오모이가 우마레소-나노사"
    },
    {
      "t": null,
      "text": "気づかずに過ごしてきたのさ 今まで",
      "ko": "키즈카즈니 스고시테 키타노사 이마마데"
    },
    {
      "t": null,
      "text": "まだ間に合うだろうか いやきっと間に合うはずさ",
      "ko": "마다 마니아우다로-카 이야 킷토 마니아우 하즈사"
    },
    {
      "t": null,
      "text": "僕たちは たくさんの寂しさ悲しさを",
      "ko": "보쿠타치와 타쿠산노 사비시사 카나시사오"
    },
    {
      "t": null,
      "text": "抱きしめたけど 今日から変わるの Come on",
      "ko": "다키시메타케도 쿄-카라 카와루노 Come on"
    },
    {
      "t": null,
      "text": "信じてんぜ君を だからあかしに贈りたいんだ",
      "ko": "신지텐제 키미오 다카라 아카시니 오쿠리타인다"
    },
    {
      "t": null,
      "text": "花束 花束 いろんな色の",
      "ko": "하나타바 하나타바 이론나 이로노"
    },
    {
      "t": null,
      "text": "くよくよするなよ（するなよ）そう昔から気づいてた",
      "ko": "쿠요쿠요 스루나요 (스루나요) 소- 무카시카라 키즈이테타"
    },
    {
      "t": null,
      "text": "あなたは あなたは 愛しさ抱きしめる人",
      "ko": "아나타와 아나타와 이토시사 다키시메루 히토"
    },
    {
      "t": null,
      "text": "あなたは花束（あなたは花束 ）",
      "ko": "아나타와 하나타바 (아나타와 하나타바)"
    },
    {
      "t": null,
      "text": "寂しさにさよなら（寂しさにさよなら）",
      "ko": "사비시사니 사요나라 (사비시사니 사요나라)"
    },
    {
      "t": null,
      "text": "大丈夫なんだから（大丈夫なんだから）",
      "ko": "다이죠-부난다카라 (다이죠-부난다카라)"
    },
    {
      "t": null,
      "text": "それでは気曲行きますよう",
      "ko": "소레데와 키쿄쿠 이키마스요-"
    },
    {
      "t": null,
      "text": "One, two, one two 三 四",
      "ko": "One, two, one two 산 시"
    },
    {
      "t": null,
      "text": "この世には たくさんの寂しさ悲しさが",
      "ko": "코노 요니와 타쿠산노 사비시사 카나시사가"
    },
    {
      "t": null,
      "text": "あふれてるけど それでも生きようよ",
      "ko": "아후레테루케도 소레데모 이키요-요"
    },
    {
      "t": null,
      "text": "信じてんぜ君を だからあなたに贈りたいんだ",
      "ko": "신지텐제 키미오 다카라 아나타니 오쿠리타인다"
    },
    {
      "t": null,
      "text": "花束 花束 いろんな色の",
      "ko": "하나타바 하나타바 이론나 이로노"
    },
    {
      "t": null,
      "text": "くよくよするなよ（するなよ）そう昔から気づいてた",
      "ko": "쿠요쿠요 스루나요 (스루나요) 소- 무카시카라 키즈이테타"
    },
    {
      "t": null,
      "text": "あなたは あなたは ぬくもり取り戻せる人",
      "ko": "아나타와 아나타와 누쿠모리 토리모도세루 히토"
    },
    {
      "t": null,
      "text": "人 人 人 人 人...",
      "ko": "히토 히토 히토 히토 히토..."
    },
    {
      "t": null,
      "text": "信じてんぜ君を そう昔から気づいてた",
      "ko": "신지텐제 키미오 소- 무카시카라 키즈이테타"
    },
    {
      "t": null,
      "text": "あなたは あなたは 花のように咲きほこる人",
      "ko": "아나타와 아나타와 하나노 요-니 사키호코루 히토"
