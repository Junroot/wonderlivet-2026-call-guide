  "durationSec": 269,
  "lines": [
    {
      "t": 0.61,
      "text": "もしもキミが",
      "ko": "모시모 키미가"
    },
    {
      "t": 2.85,
      "text": "心の中の悲しみだとか",
      "ko": "코코로노 나카노 카나시미다토카"
    },
    {
      "t": 8.08,
      "text": "痛みを抱えきれなくなって",
      "ko": "이타미오 카카에키레나쿠 낫테"
    },
    {
      "t": 13.53,
      "text": "自分自身を今",
      "ko": "지분지신오 이마"
    },
    {
      "t": 17.49,
      "text": "見失いそうになっても",
      "ko": "미우시나이소-니 낫테모"
    },
    {
      "t": 38.45,
      "text": "忘れないで この世には",
      "ko": "와스레나이데 코노 요니와"
    },
    {
      "t": 43.56,
      "text": "痛みと悲しみを",
      "ko": "이타미토 카나시미오"
    },
    {
      "t": 45.91,
      "text": "歯をくいしばって",
      "ko": "하오 쿠이시밧테"
    },
    {
      "t": 49.08,
      "text": "抱きしめるキミにだけ",
      "ko": "다키시메루 키미니다케"
    },
    {
      "t": 52.47,
      "text": "起こせる奇跡があるってことを",
      "ko": "오코세루 키세키가 아룻테 코토오"
    },
    {
      "t": 60.99,
      "text": "ついにその時が来たんだよ",
      "ko": "츠이니 소노 토키가 키탄다요"
    },
    {
      "t": 63.71,
      "text": "心臓の音が合図だろ?",
      "ko": "신조-노 오토가 아이즈다로?"
    },
    {
      "t": 66.5,
      "text": "誰のマネもしなくていいの",
      "ko": "다레노 마네모 시나쿠테 이이노"
    },
    {
      "t": 68.82,
      "text": "キミだけの花よ咲け",
      "ko": "키미다케노 하나요 사케"
    },
    {
      "t": 73.69,
      "text": "負けないでキミの心",
      "ko": "마케나이데 키미노 코코로"
    },
    {
      "t": 77.56,
      "text": "輝いていて",
      "ko": "카가야이테이테"
    },
    {
      "t": 80.32,
      "text": "大丈夫 乗り越えられる",
      "ko": "다이죠-부 노리코에라레루"
    },
    {
      "t": 84.33,
      "text": "くじけないで笑っておくれ",
      "ko": "쿠지케나이데 와랏테 오쿠레"
    },
    {
      "t": 88.55,
      "text": "胸張っていけ",
      "ko": "무네 핫테 이케"
    },
    {
      "t": 91.1,
      "text": "キミこそ 僕の奇跡なんだから",
      "ko": "키미코소 보쿠노 키세키난다카라"
    },
    {
      "t": 106.01,
      "text": "間違えんなよ 終わりの景色だとか",
      "ko": "마치가엔나요 오와리노 케시키다토카"
    },
    {
      "t": 110.44,
      "text": "時間は止まらないって",
      "ko": "지칸와 토마라나잇테"
    },
    {
      "t": 113.1,
      "text": "悲しいサダメと言うけど",
      "ko": "카나시이 사다메토 이우케도"
    },
    {
      "t": 117.34,
      "text": "終わらないよ",
      "ko": "오와라나이요"
    },
    {
      "t": 118.92,
      "text": "一瞬が過ぎてくだけ",
      "ko": "잇슌가 스기테쿠 다케"
    },
    {
      "t": 121.17,
      "text": "ほら次の瞬間だぜ",
      "ko": "호라 츠기노 슌칸다제"
    },
    {
      "t": 123.71,
      "text": "だから簡単に終わらせんなよ",
      "ko": "다카라 칸탄니 오와라센나요"
    },
    {
      "t": 127.63,
      "text": "負けないでキミの心",
      "ko": "마케나이데 키미노 코코로"
    },
    {
      "t": 131.52,
      "text": "輝いていて",
      "ko": "카가야이테이테"
    },
    {
      "t": 134.33,
      "text": "大丈夫と声が聴こえる",
      "ko": "다이죠-부토 코에가 키코에루"
    },
    {
      "t": 138.31,
      "text": "キミ自身をまもっておくれ",
      "ko": "키미 지신오 마못테 오쿠레"
    },
    {
      "t": 142.34,
      "text": "自分を責めないで",
      "ko": "지분오 세메나이데"
    },
    {
      "t": 145.08,
      "text": "キミこそ 待ち望んだ人だから",
      "ko": "키미코소 마치노존다 히토다카라"
    },
    {
      "t": 172.2,
      "text": "悲しい魔法を",
      "ko": "카나시이 마호-오"
    },
    {
      "t": 174.88,
      "text": "僕らかけられても",
      "ko": "보쿠라 카케라레테모"
    },
    {
      "t": 177.78,
      "text": "自由になれるさ 必ず",
      "ko": "지유-니 나레루사 카나라즈"
    },
    {
