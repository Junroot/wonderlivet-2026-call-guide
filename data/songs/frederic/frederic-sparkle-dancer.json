  "durationSec": 220.94,
  "lines": [
    {
      "t": 16.98,
      "text": "さあさあ 寄ってらっしゃい 旗なびかせて",
      "ko": "사- 사- 욧테랏샤이 하타 나비카세테"
    },
    {
      "t": 20.14,
      "text": "水面を揺らす音はどこへゆく",
      "ko": "미나모오 유라스 오토와 도코에 유쿠"
    },
    {
      "t": 23.88,
      "text": "さあさあ 喰らいあって眼を光らして",
      "ko": "사- 사- 쿠라이앗테 메오 히카라시테"
    },
    {
      "t": 26.94,
      "text": "鮮やかな軌跡を刻み込んで",
      "ko": "아자야카나 키세키오 키자미콘데"
    },
    {
      "t": 30.54,
      "text": "響かせナンバー 煌めくようなランウェイ",
      "ko": "히비카세 남바- 키라메쿠요-나 란웨이"
    },
    {
      "t": 33.99,
      "text": "負けられないや 滑走 理想 節操",
      "ko": "마케라레나이야 캇소- 리소- 셋소-"
    },
    {
      "t": 37.5,
      "text": "荒波さえも乗りこなせよメロディ",
      "ko": "아라나미사에모 노리코나세요 메로디"
    },
    {
      "t": 40.95,
      "text": "心揺らしていけ",
      "ko": "코코로 유라시테 이케"
    },
    {
      "t": 43.24,
      "text": "突き刺さってくように 火花舞ってくように",
      "ko": "츠키사삿테쿠 요-니 히바나 맛테쿠 요-니"
    },
    {
      "t": 46.51,
      "text": "熱くなっていこうぜ 束の間のダンサー",
      "ko": "아츠쿠낫테 이코-제 츠카노마노 단사-"
    },
    {
      "t": 50.03,
      "text": "突き破っていこうぜ 誰よりもぎらぎらと",
      "ko": "츠키야붓테 이코-제 다레요리모 기라기라토"
    },
    {
      "t": 53.96,
      "text": "この命燃やしていけ",
      "ko": "코노 이노치 모야시테 이케"
    },
    {
      "t": 57.35,
      "text": "のってけ のってけ のってけ のってけ",
      "ko": "놋테케 놋테케 놋테케 놋테케"
    },
    {
      "t": 60.65,
      "text": "のってけ 熱狂攫って のってけ 一層飛ばして",
      "ko": "놋테케 넷쿄- 사랏테 놋테케 잇소- 토바시테"
    },
    {
      "t": 64.3,
      "text": "のってけ のってけ のってけ のってけ",
      "ko": "놋테케 놋테케 놋테케 놋테케"
    },
    {
      "t": 67.87,
      "text": "このままかっ飛ばしてぶっ放して往来",
      "ko": "코노마마 캇토바시테 붓파나시테 오-라이"
    },
    {
      "t": 83.4,
      "text": "はいはい 手鳴らして いちにのさんし",
      "ko": "하이 하이 테 나라시테 이치니노 산시"
    },
    {
      "t": 86.39,
      "text": "期待を超えて船はどこへゆく",
      "ko": "키타이오 코에테 후네와 도코에 유쿠"
    },
    {
      "t": 90.26,
      "text": "宵宵 比べあって 高鳴りあって",
      "ko": "요이 요이 쿠라베앗테 타카나리앗테"
    },
    {
      "t": 93.38,
      "text": "振り向くな後ろに未知はあるか?",
      "ko": "후리무쿠나 우시로니 미치와 아루카?"
    },
    {
      "t": 97.07,
      "text": "かませブレイバー 高まるエントロピー",
      "ko": "카마세 브레이바- 타카마루 엔토로피-"
    },
    {
      "t": 100.32,
      "text": "焚き付けたいや 活況 希望 先頭",
      "ko": "타키츠케타이야 캇쿄- 키보- 센토-"
    },
    {
      "t": 103.92,
      "text": "茨の道も乗り越えればリバティ",
      "ko": "이바라노 미치모 노리코에레바 리바티"
    },
    {
      "t": 107.37,
      "text": "心震わしていけ",
      "ko": "코코로 후루와시테 이케"
    },
    {
      "t": 109.56,
      "text": "駆け巡ってくように 解き放ってくように",
      "ko": "카케메굿테쿠 요-니 토키하낫테쿠 요-니"
    },
    {
      "t": 113.14,
      "text": "攻めまくっていこうぜ 勝鬨のアンサー",
      "ko": "세메마쿳테 이코-제 카치도키노 안사-"
    },
    {
      "t": 116.36,
      "text": "舞い踊っていこうぜ 心はケセラセラと",
      "ko": "마이오돗테 이코-제 코코로와 케세라세라토"
    },
    {
      "t": 120.51,
      "text": "この気持ち化かしていけ",
      "ko": "코노 키모치 바카시테 이케"
    },
    {
      "t": 123.96,
      "text": "のってけ のってけ のってけ のってけ",
      "ko": "놋테케 놋테케 놋테케 놋테케"
    },
    {
      "t": 127.38,
      "text": "のってけ 熱狂攫って のってけ 一層飛ばして",
      "ko": "놋테케 넷쿄- 사랏테 놋테케 잇소- 토바시테"
