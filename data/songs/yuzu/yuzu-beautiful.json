  "lines": [
    {
      "t": 1.12,
      "text": "響き合うよ 僕らは 少しずつ彩ってゆく",
      "ko": "히비키아우요 보쿠라와 스코시즈츠 이로돗테 유쿠"
    },
    {
      "t": 9.37,
      "text": "支えたいよ いつでも 君を探してる",
      "ko": "사사에타이요 이츠데모 키미오 사가시테루"
    },
    {
      "t": 32.71,
      "text": "狂いそうになって 塞ぎ込んだって",
      "ko": "쿠루이소-니 낫테 후사기콘닷테"
    },
    {
      "t": 36.13,
      "text": "もうどんくらい 暗い 嫌 辛いや",
      "ko": "모- 돈쿠라이 쿠라이 이야 츠라이야"
    },
    {
      "t": 38.34,
      "text": "痛みは止まない 何も変わんない",
      "ko": "이타미와 야마나이 나니모 카완나이"
    },
    {
      "t": 39.94,
      "text": "踏みにじられたって 奪い去られたって",
      "ko": "후미니지라레탓테 우바이사라레탓테"
    },
    {
      "t": 43.61,
      "text": "舌の根も乾かない 時は過ぎんだ",
      "ko": "시타노 네모 카와카나이 토키와 스긴다"
    },
    {
      "t": 46.45,
      "text": "忘却の彼方に 消えていくんだ",
      "ko": "보-캬쿠노 카나타니 키에테 이쿤다"
    },
    {
      "t": 50.88,
      "text": "悲しみの中にしか 咲かない花があるから",
      "ko": "카나시미노 나카니시카 사카나이 하나가 아루카라"
    },
    {
      "t": 58.23,
      "text": "大地かき分け芽を伸ばす 光へ",
      "ko": "다이치 카키와케 메오 노바스 히카리에"
    },
    {
      "t": 64.96,
      "text": "Beautiful 願えば",
      "ko": "Beautiful 네가에바"
    },
    {
      "t": 68.75,
      "text": "Beautiful, never give up",
      "ko": null
    },
    {
      "t": 72.19,
      "text": "Beautiful, beautiful",
      "ko": null
    },
    {
      "t": 76.12,
