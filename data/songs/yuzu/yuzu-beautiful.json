      "text": "(Beautiful) 響き合うよ 僕らは",
      "ko": "(Beautiful) 히비키아우요 보쿠라와"
    },
    {
      "t": 83.87,
      "text": "(Beautiful) 変わりゆく時代の中で",
      "ko": "(Beautiful) 카와리유쿠 지다이노 나카데"
    },
    {
      "t": 88.55,
      "text": "たどり着いた場所で今",
      "ko": "타도리츠이타 바쇼데 이마"
    },
    {
      "t": 91.46,
      "text": "君は何を思う？",
      "ko": "키미와 나니오 오모우?"
    },
    {
      "t": 96.1,
      "text": "どうやってみたって 到底無理だって",
      "ko": "도-얏테 미탓테 토-테- 무리닷테"
    },
    {
      "t": 99.87,
      "text": "立ちはだかるんだ 高すぎる壁の前でも",
      "ko": "타치하다카룬다 타카스기루 카베노 마에데모"
    },
    {
      "t": 103.83,
      "text": "切り開くんだ いつだって握ってる",
      "ko": "키리히라쿤다 이츠닷테 니깃테루"
    },
    {
      "t": 107.3,
      "text": "運命はこの手にまだ ほら託されたまま",
      "ko": "운메-와 코노 테니 마다 호라 타쿠사레타 마마"
    },
    {
      "t": 109.97,
      "text": "決めるのは君次第だ",
      "ko": "키메루노와 키미 시다이다"
    },
    {
      "t": 111.35,
      "text": "分かり合えないときに 見つける歌があるから",
      "ko": "와카리아에나이 토키니 미츠케루 우타가 아루카라"
    },
    {
      "t": 118.52,
      "text": "囚われた心 手を伸ばす 闇から",
      "ko": "토라와레타 코코로 테오 노바스 야미카라"
    },
