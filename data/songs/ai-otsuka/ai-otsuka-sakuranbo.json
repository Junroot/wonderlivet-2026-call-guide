  "lines": [
    {
      "t": 0.82,
      "text": "愛し合う２人 幸せの空",
      "ko": "아이시아우 후타리 시아와세노 소라"
    },
    {
      "t": 7.47,
      "text": "隣どおし あなたとあたし さくらんぼ",
      "ko": "토나리도-시 아나타토 아타시 사쿠람보"
    },
    {
      "t": 23.09,
      "text": "手帳開くと もう ２年たつなぁって",
      "ko": "테쵸- 히라쿠토 모- 니넨 타츠나앗테"
    },
    {
      "t": 28.6,
      "text": "やっぱ実感するね なんだか照れたりするね",
      "ko": "얍파 짓칸스루네 난다카 테레타리 스루네"
    },
    {
      "t": 34.11,
      "text": "そういや ヒドイ コトもされたし",
      "ko": "소-이야 히도이 코토모 사레타시"
    },
    {
      "t": 37.23,
      "text": "ヒドイ コトも言ったし",
      "ko": "히도이 코토모 잇타시"
    },
    {
      "t": 39.92,
      "text": "中実がいっぱいつまった 甘い甘いものです",
      "ko": "나카미가 잇파이 츠맛타 아마이 아마이 모노데스"
    },
    {
      "t": 45.5,
      "text": "泣き泣きの１日や 自転車の旅や",
      "ko": "나키나키노 이치니치야 지텐샤노 타비야"
    },
    {
      "t": 49.5,
      "text": "書きあらわせない",
      "ko": "카키아라와세나이"
    },
    {
      "t": 51.27,
      "text": "だって 多いんだもん！",
      "ko": "닷테 오-인다몽!"
    },
    {
      "t": 53.46,
      "text": "笑顔咲ク 君とつながってたい",
      "ko": "에가오 사쿠 키미토 츠나갓테타이"
    },
    {
      "t": 59.65,
      "text": "もしあの向こうにッ見えるものがあるなら",
      "ko": "모시 아노 무코-닛 미에루 모노가 아루나라"
    },
    {
      "t": 64.81,
      "text": "愛し合う２人 幸せの空",
      "ko": "아이시아우 후타리 시아와세노 소라"
    },
    {
      "t": 70.87,
      "text": "隣どおし あなたとあたし さくらんぼ",
      "ko": "토나리도-시 아나타토 아타시 사쿠람보"
    },
    {
      "t": 86.41,
      "text": "もらったものは そう愛を感じ",
      "ko": "모랏타 모노와 소- 아이오 칸지"
    },
    {
      "t": 92.32,
      "text": "あげたものは もちろん 全力の愛です",
      "ko": "아게타 모노와 모치론 젠료쿠노 아이데스"
    },
    {
      "t": 97.74,
      "text": "やっぱいいもんだよね 共同作業 罰ゲーム",
      "ko": "얍파 이이몬다요네 쿄-도-사교- 바츠게-무"
    },
    {
      "t": 103.44,
      "text": "思いがけなく歴史は さらに深いけれど",
      "ko": "오모이가케나쿠 레키시와 사라니 후카이케레도"
    },
    {
      "t": 109.11,
      "text": "１つでも 欠けてたら とんでもなく",
      "ko": "히토츠데모 카케테타라 톤데모나쿠"
    },
    {
      "t": 112.35,
      "text": "足りない 足りない！ 足りない！ ２人の絆",
      "ko": "타리나이 타리나이! 타리나이! 후타리노 키즈나"
    },
    {
      "t": 116.68,
      "text": "笑顔咲ク 君と 抱き合ってたい",
      "ko": "에가오 사쿠 키미토 다키앗테타이"
    },
    {
      "t": 123.23,
      "text": "もし遠い未来を 予想するのなら",
      "ko": "모시 토-이 미라이오 요소-스루노나라"
    },
    {
      "t": 128.06,
      "text": "愛し合う２人 いつの時も",
      "ko": "아이시아우 후타리 이츠노 토키모"
    },
    {
