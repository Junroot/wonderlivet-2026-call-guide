  "durationSec": 246,
  "lines": [
    {
      "t": 10.3,
      "text": "あの交差点で",
      "ko": "아노 코-사텐데"
    },
    {
      "t": 12.98,
      "text": "みんながもしスキップをして",
      "ko": "민나가 모시 스킷푸오 시테"
    },
    {
      "t": 16.64,
      "text": "もしあの街の真ん中で",
      "ko": "모시 아노 마치노 만나카데"
    },
    {
      "t": 20.49,
      "text": "手をつないで空を見上げたら",
      "ko": "테오 츠나이데 소라오 미아게타라"
    },
    {
      "t": 24.23,
      "text": "もしもあの街のどこかで",
      "ko": "모시모 아노 마치노 도코카데"
    },
    {
      "t": 27.98,
      "text": "チャンスがつかみたいのなら",
      "ko": "찬스가 츠카미타이노나라"
    },
    {
      "t": 31.61,
      "text": "まだ泣くのには早いよね",
      "ko": "마다 나쿠노니와 하야이요네"
    },
    {
      "t": 35.36,
      "text": "ただ前に進むしかないわいやいや",
      "ko": "타다 마에니 스스무시카 나이와 이야이야"
    },
    {
      "t": 40.26,
      "text": "PONPON 出して",
      "ko": "PONPON 다시테"
    },
    {
      "t": 42.16,
      "text": "しまえばいいの",
      "ko": "시마에바 이이노"
    },
    {
      "t": 43.42,
      "text": "ぜんぜん しないの",
      "ko": "젠젠 시나이노"
    },
    {
      "t": 45.85,
      "text": "つまらないでしょ",
      "ko": "츠마라나이데쇼"
    },
    {
      "t": 47.83,
      "text": "ヘッドフォンかけて",
      "ko": "헷도폰 카케테"
    },
    {
      "t": 49.72,
      "text": "リズムに乗せて",
      "ko": "리즈무니 노세테"
    },
    {
      "t": 51.54,
      "text": "WAYWAY空けて",
      "ko": "WAYWAY 아케테"
    },
    {
      "t": 53.4,
      "text": "あたしの道を",
      "ko": "아타시노 미치오"
    },
    {
      "t": 54.8,
      "text": "PONPON 進む",
      "ko": "PONPON 스스무"
    },
    {
      "t": 57.21,
      "text": "色々なこと",
      "ko": "이로이로나 코토"
    },
    {
      "t": 58.32,
      "text": "どんどん キテる?",
      "ko": "돈돈 키테루?"
    },
    {
      "t": 60.83,
      "text": "あなたのキモチ",
      "ko": "아나타노 키모치"
    },
    {
      "t": 62.89,
      "text": "POIPOI 捨てる",
      "ko": "POIPOI 스테루"
    },
    {
      "t": 64.79,
      "text": "悪い子はだれ?",
      "ko": "와루이 코와 다레?"
    },
    {
      "t": 66.58,
      "text": "そうそう いいコ",
      "ko": "소-소- 이이 코"
    },
    {
      "t": 68.46,
      "text": "ああ You Make Me Happy",
      "ko": "아- You Make Me Happy"
    },
    {
      "t": 70.5,
      "text": "Every Day PON",
      "ko": null
    },
