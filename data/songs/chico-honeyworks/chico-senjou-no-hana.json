  "durationSec": 188.79,
  "lines": [
    {
      "t": 13.02,
      "text": "人とは何か違った",
      "ko": "히토토와 나니카 치갓타"
    },
    {
      "t": 15.3,
      "text": "歪んだ感情 仮面の中",
      "ko": "유간다 칸죠- 카멘노 나카"
    },
    {
      "t": 17.8,
      "text": "抑えられない衝動",
      "ko": "오사에라레나이 쇼-도-"
    },
    {
      "t": 20.26,
      "text": "リアルとフェイクぶっ壊したくて",
      "ko": "리아루토 페이쿠 붓코와시타쿠테"
    },
    {
      "t": 22.76,
      "text": "敷かれたレールを超えて",
      "ko": "시카레타 레-루오 코에테"
    },
    {
      "t": 25.24,
      "text": "運命は再び出会うから",
      "ko": "운메이와 후타타비 데아우카라"
    },
    {
      "t": 27.61,
      "text": "世界のどんなものより",
      "ko": "세카이노 돈나 모노요리"
    },
    {
      "t": 30.27,
      "text": "高ぶる i が興奮する",
      "ko": "타카부루 아이가 코-훈스루"
    },
    {
      "t": 32.71,
      "text": "(Hey) 言葉じゃ伝わらんおバカ様",
      "ko": "(Hey) 코토바쟈 츠타와란 오바카사마"
    },
    {
      "t": 35.02,
      "text": "(Hey) ゴングなんて待てやしない",
      "ko": "(Hey) 공구난테 마테야시나이"
    },
    {
      "t": 37.64,
      "text": "(Hey) 我が愛しのサンドバッグ",
      "ko": "(Hey) 와가 이토시노 산도박구"
    },
    {
      "t": 40.34,
      "text": "手加減できない",
      "ko": "테카겐 데키나이"
    },
    {
      "t": 44.71,
      "text": "体をめぐるこの血",
      "ko": "카라다오 메구루 코노 치"
    },
    {
      "t": 47.25,
      "text": "沸騰し燃え上がる",
      "ko": "훗토-시 모에아가루"
    },
    {
      "t": 49.78,
      "text": "誰かが言った言葉",
      "ko": "다레카가 잇타 코토바"
    },
    {
      "t": 52.13,
      "text": "流されないで生きる",
      "ko": "나가사레나이데 이키루"
    },
    {
      "t": 54.66,
      "text": "負ける気なんてしない",
      "ko": "마케루 키난테 시나이"
    },
    {
      "t": 57.05,
      "text": "この身朽ちゆくまで",
      "ko": "코노 미 쿠치유쿠마데"
    },
    {
      "t": 59.59,
      "text": "捧げると誓ったから",
      "ko": "사사게루토 치캇타카라"
    },
    {
      "t": 61.92,
      "text": "誰でもない貴方に あぁ",
      "ko": "다레데모 나이 아나타니 아-"
    },
    {
      "t": 74.57,
      "text": "傷付けたいわけじゃない",
      "ko": "키즈츠케타이 와케쟈나이"
    },
    {
      "t": 77.17,
      "text": "嫌われたくてやってるんじゃない",
      "ko": "키라와레타쿠테 얏테룬쟈나이"
    },
    {
      "t": 79.65,
      "text": "理不尽の裏で笑う",
      "ko": "리후진노 우라데 와라우"
    },
    {
      "t": 82.06,
      "text": "ずるいやつらをぶっ飛ばしたくて",
      "ko": "즈루이 야츠라오 붓토바시타쿠테"
    },
    {
      "t": 84.6,
      "text": "見て見ぬふりばかりの中",
      "ko": "미테 미누 후리바카리노 나카"
    },
    {
      "t": 87.07,
      "text": "貴方だけが普通を果たすんだ",
      "ko": "아나타다케가 후츠-오 하타슨다"
    },
    {
      "t": 89.63,
      "text": "余裕な顔鼻につく",
      "ko": "요유-나 카오 하나니 츠쿠"
    },
    {
      "t": 91.9,
      "text": "じわりと胸が熱くなった",
      "ko": "지와리토 무네가 아츠쿠낫타"
    },
    {
      "t": 94.47,
      "text": "(Hey) 噂に群れちゃっておバカ様",
      "ko": "(Hey) 우와사니 무레챳테 오바카사마"
    },
    {
      "t": 96.95,
      "text": "(Hey) 流され救いようねえな",
      "ko": "(Hey) 나가사레 스쿠이요- 네-나"
    },
    {
      "t": 99.42,
      "text": "(Hey) 信じるなら見極めろよ",
      "ko": "(Hey) 신지루나라 미키와메로요"
    },
    {
      "t": 102.2,
      "text": "仲良くできない",
      "ko": "나카요쿠 데키나이"
    },
    {
      "t": 106.55,
      "text": "体を走る電気",
      "ko": "카라다오 하시루 덴키"
    },
    {
      "t": 109.01,
      "text": "魂 突き動かす",
      "ko": "타마시- 츠키우고카스"
    },
    {
      "t": 111.57,
      "text": "貴方が言った言葉",
      "ko": "아나타가 잇타 코토바"
    },
    {
      "t": 113.91,
      "text": "好きになってしまえよ",
      "ko": "스키니 낫테 시마에요"
    },
    {
      "t": 116.46,
      "text": "負ける気なんてしない",
      "ko": "마케루 키난테 시나이"
    },
    {
      "t": 118.88,
      "text": "その言葉があれば",
      "ko": "소노 코토바가 아레바"
    },
    {
      "t": 121.59,
      "text": "愛しいと思ったから",
      "ko": "이토시-토 오못타카라"
    },
    {
      "t": 123.87,
      "text": "誰でもない貴方を あぁ",
      "ko": "다레데모 나이 아나타오 아-"
    },
    {
      "t": 136.21,
      "text": "人は恋という 人は愛という",
      "ko": "히토와 코이토 이우 히토와 아이토 이우"
    },
    {
      "t": 141.24,
      "text": "目には見えないもので 少し難しい",
      "ko": "메니와 미에나이 모노데 스코시 무즈카시-"
    },
    {
      "t": 146.12,
      "text": "難しいのに今日も落ちていくだけ",
      "ko": "무즈카시-노니 쿄-모 오치테이쿠다케"
    },
    {
      "t": 160.81,
      "text": "戦場の華 舞って",
      "ko": "센죠-노 하나 맛테"
    },
    {
      "t": 163.48,
      "text": "美しく咲き誇る",
      "ko": "우츠쿠시쿠 사키호코루"
    },
    {
      "t": 165.9,
      "text": "助けなんていらなかった",
      "ko": "타스케난테 이라나캇타"
    },
    {
      "t": 168.35,
      "text": "貴方に出会うまでは",
      "ko": "아나타니 데아우마데와"
    },
    {
      "t": 170.85,
      "text": "負ける気なんてしない",
      "ko": "마케루 키난테 시나이"
    },
    {
      "t": 173.35,
      "text": "この身朽ちゆくまで",
      "ko": "코노 미 쿠치유쿠마데"
    },
    {
      "t": 175.85,
      "text": "捧げると誓ったから",
      "ko": "사사게루토 치캇타카라"
    },
    {
      "t": 178.38,
      "text": "誰でもない貴方に",
      "ko": "다레데모 나이 아나타니"
    },
    {
      "t": 180.82,
      "text": "ファーストキスのように",
      "ko": "파-스토 키스노 요-니"
    },
    {
      "t": 183.22,
      "text": "消えないこの i もずっと",
      "ko": "키에나이 코노 아이모 즛토"
    }
  ],
