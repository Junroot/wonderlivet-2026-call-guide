  "durationSec": 267.17,
  "lines": [
    {
      "t": 16.58,
      "text": "可愛くね とびきりの愛よ届け！",
      "ko": "카와이쿠네 토비키리노 아이요 토도케!"
    },
    {
      "t": 21.14,
      "text": "宜しければ名前だけでも覚えてって下さいm(_ _)m(ハイ！)",
      "ko": "요로시케레바 나마에다케데모 오보에텟테 쿠다사이 (하이!)"
    },
    {
      "t": 37.28,
      "text": "レッスン開始！意気込むけれど",
      "ko": "렛슨 카이시! 이키고무케레도"
    },
    {
      "t": 42.82,
      "text": "歌って踊ってヘトヘト",
      "ko": "우탓테 오돗테 헤토헤토"
    },
    {
      "t": 47.95,
      "text": "比較される事もあるけど",
      "ko": "히카쿠사레루 코토모 아루케도"
    },
    {
      "t": 53.56,
      "text": "私は私でありたい",
      "ko": "와타시와 와타시데 아리타이"
    },
    {
      "t": 58.71,
      "text": "本気出さなきゃ響かないんだ",
      "ko": "혼키 다사나캬 히비카나인다"
    },
    {
      "t": 64.15,
      "text": "ファンの心を掴みたいんだ",
      "ko": "환노 코코로오 츠카미타인다"
    },
    {
      "t": 69.25,
      "text": "だからスタート全開飛ばしますよ",
      "ko": "다카라 스타-토 젠카이 토바시마스요"
    },
    {
      "t": 74.03,
      "text": "(You're my angel！！)",
      "ko": null
    },
    {
      "t": 75.38,
      "text": "可愛くね とびきりの愛よ届け！",
      "ko": "카와이쿠네 토비키리노 아이요 토도케!"
    },
    {
      "t": 79.84,
      "text": "宜しければ名前だけでも覚えてって下さいm(_ _)m(ハイ！)",
      "ko": "요로시케레바 나마에다케데모 오보에텟테 쿠다사이 (하이!)"
    },
    {
      "t": 85.99,
      "text": "あざとくね とびきりのスマイルで！",
      "ko": "아자토쿠네 토비키리노 스마이루데!"
    },
    {
      "t": 90.52,
      "text": "宜しければ\"推し\"にしちゃってくれませんか？|дﾟ)",
      "ko": "요로시케레바 \"오시\"니 시챳테 쿠레마센카?"
    },
    {
      "t": 95.44,
      "text": "なんてねっ！笑",
      "ko": "난테넷! (와라)"
    },
    {
      "t": 96.68,
      "text": "ちょっぴりマジなの期待していいですか？(ハイ！)",
      "ko": "춋피리 마지나노 키타이시테 이이데스카? (하이!)"
    },
    {
      "t": 112.05,
      "text": "人生変えるそんな一日",
      "ko": "진세- 카에루 손나 이치니치"
    },
    {
      "t": 117.53,
      "text": "憧れ夢見たステージ",
      "ko": "아코가레 유메미타 스테-지"
    },
    {
      "t": 122.63,
      "text": "オシャレ？流行り？追いつけなくて",
      "ko": "오샤레? 하야리? 오이츠케나쿠테"
    },
    {
      "t": 128.18,
      "text": "言い訳弱音も出ちゃうよ",
      "ko": "이이와케 요와네모 데챠우요"
    },
    {
      "t": 133.15,
      "text": "向いてないかな？",
      "ko": "무이테나이카나?"
    },
    {
      "t": 136.25,
      "text": "愛想悪いしこんなアイドル他にいないし",
      "ko": "아이소 와루이시 콘나 아이도루 호카니 이나이시"
    },
    {
      "t": 144.17,
      "text": "でもね絶対絶対見返すんだ",
      "ko": "데모네 젯타이 젯타이 미카에슨다"
    },
    {
      "t": 148.72,
      "text": "(You're my angel！！)",
      "ko": null
    },
    {
      "t": 149.92,
      "text": "愛してね \"日本一\"夢見てる",
      "ko": "아이시테네 \"닛폰이치\" 유메미테루"
    },
    {
      "t": 154.51,
      "text": "宜しければ合いの手一つ入れてやって下さいm(_ _)m(ハイ！)",
      "ko": "요로시케레바 아이노테 히토츠 이레테 얏테 쿠다사이 (하이!)"
    },
    {
      "t": 160.54,
      "text": "手を上げて 視線独り占めして！",
      "ko": "테오 아게테 시센 히토리지메 시테!"
    },
    {
      "t": 165.26,
      "text": "宜しければ愛を恵んでくれませんか？|дﾟ)",
      "ko": "요로시케레바 아이오 메군데 쿠레마센카?"
    },
    {
      "t": 170.12,
      "text": "なんてねっ！笑",
      "ko": "난테넷! (와라)"
    },
    {
      "t": 171.22,
      "text": "絶対後悔させませんよ？マジでね！！(ハイ！)",
      "ko": "젯타이 코-카이 사세마센요? 마지데네!! (하이!)"
    },
    {
      "t": 176.83,
      "text": "今もステージは胸がギュッと熱くなる",
      "ko": "이마모 스테-지와 무네가 귯토 아츠쿠나루"
    },
    {
      "t": 187.01,
      "text": "揺れる景色焼き付けて歌う声に愛を込める",
      "ko": "유레루 케시키 야키츠케테 우타우 코에니 아이오 코메루"
    },
    {
      "t": 197.27,
      "text": "((ギター！))",
      "ko": "((기타-!))"
    },
    {
      "t": 208.12,
      "text": "響く歓声気持ち高鳴る",
      "ko": "히비쿠 칸세- 키모치 타카나루"
    },
    {
      "t": 213.53,
      "text": "これは証明私ここだよ",
      "ko": "코레와 쇼-메- 와타시 코코다요"
    },
    {
      "t": 218.63,
      "text": "いくよ！絶対絶対声出してね？",
      "ko": "이쿠요! 젯타이 젯타이 코에 다시테네?"
    },
