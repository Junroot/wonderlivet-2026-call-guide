  },
  "lrclib": {
    "id": 27806895,
    "trackName": "プライド革命",
    "artistName": "CHiCO with HoneyWorks"
  },
  "durationSec": 238,
  "lines": [
    {
      "t": 0.71,
      "text": "理想だけを口にしてた過去",
      "ko": "리소-다케오 쿠치니 시테타 카코"
    },
    {
      "t": 5.05,
      "text": "壁はどこにだって立ち塞いで",
      "ko": "카베와 도코니닷테 타치후사이데"
    },
    {
      "t": 8.28,
      "text": "手探りで生きてく",
      "ko": "테사구리데 이키테쿠"
    },
    {
      "t": 25.23,
      "text": "紅い空が影を伸ばす",
      "ko": "아카이 소라가 카게오 노바스"
    },
    {
      "t": 28.86,
      "text": "まだそれは頼りなくて自分勝手",
      "ko": "마다 소레와 타요리나쿠테 지분갓테"
    },
    {
      "t": 32.95,
      "text": "ため息をこぼす",
      "ko": "타메이키오 코보스"
    },
    {
      "t": 35.59,
      "text": "違う歩幅合わない呼吸でも",
      "ko": "치가우 호하바 아와나이 코큐-데모"
    },
    {
      "t": 40.13,
      "text": "君はまっすぐにぶつかって",
      "ko": "키미와 맛스구니 부츠캇테"
    },
    {
      "t": 43.26,
      "text": "側にいてくれる",
      "ko": "소바니 이테쿠레루"
    },
    {
      "t": 46.07,
      "text": "すれ違い見渡せばそう取り残されていた",
      "ko": "스레치가이 미와타세바 소- 토리노코사레테이타"
    },
    {
      "t": 51.65,
      "text": "「明日は見えてますか」",
      "ko": "「아스와 미에테마스카」"
    },
    {
      "t": 55.56,
      "text": "暗闇かき消す君の声が聞こえたんだ",
      "ko": "쿠라야미 카키케스 키미노 코에가 키코에탄다"
    },
    {
      "t": 66.6,
      "text": "弱くたって立ち向かうんだ",
      "ko": "요와쿠탓테 타치무카운다"
    },
    {
      "t": 69.28,
      "text": "理由なら君にもらった",
      "ko": "리유-나라 키미니 모랏타"
    },
    {
      "t": 71.93,
      "text": "分かってる、だから行くんだよ",
      "ko": "와캇테루 다카라 이쿤다요"
    },
    {
      "t": 76.21,
      "text": "今も苦しくって胸が痛いよ",
      "ko": "이마모 쿠루시쿳테 무네가 이타이요"
    },
    {
      "t": 79.47,
      "text": "力なら君にもらった",
      "ko": "치카라나라 키미니 모랏타"
    },
    {
      "t": 82.25,
      "text": "守り抜く為に行くんだよ",
      "ko": "마모리누쿠 타메니 이쿤다요"
    },
    {
      "t": 97.82,
      "text": "負けてばかり守るものもない",
      "ko": "마케테바카리 마모루 모노모 나이"
    },
    {
      "t": 102.4,
      "text": "そんな自信なくて試合放棄",
      "ko": "손나 지신 나쿠테 시아이 호-키"
    },
    {
      "t": 105.45,
      "text": "言い訳をこぼす",
      "ko": "이이와케오 코보스"
    },
    {
      "t": 108.21,
      "text": "どこからとなく耳を刺した声",
      "ko": "도코카라토 나쿠 미미오 사시타 코에"
    },
    {
      "t": 112.77,
      "text": "君は「まっすぐにぶつかれ」って",
      "ko": "키미와 「맛스구니 부츠카렛」테"
    },
    {
      "t": 116.11,
      "text": "悔しそうに嘆く",
      "ko": "쿠야시소-니 나게쿠"
    },
    {
      "t": 118.76,
      "text": "触れ合えば胸の奥に土足で踏み込んで",
      "ko": "후레아에바 무네노 오쿠니 도소쿠데 후미콘데"
    },
    {
      "t": 124.28,
      "text": "「明日は君が決めろ」",
      "ko": "「아스와 키미가 키메로」"
    },
    {
      "t": 128.29,
      "text": "暗闇かき消す君の声は\"泣いていた\"",
      "ko": "쿠라야미 카키케스 키미노 코에와 \"나이테이타\""
    },
    {
      "t": 139.37,
      "text": "涙なんて振り払うんだ",
      "ko": "나미다난테 후리하라운다"
    },
    {
      "t": 141.8,
      "text": "理由なら僕が作った",
      "ko": "리유-나라 보쿠가 츠쿳타"
    },
    {
      "t": 144.63,
      "text": "分かってる、だから行くんだよ",
      "ko": "와캇테루 다카라 이쿤다요"
    },
    {
      "t": 148.91,
      "text": "今も怖くなって足がすくんで",
      "ko": "이마모 코와쿠낫테 아시가 스쿤데"
    },
    {
      "t": 152.01,
      "text": "本当は震えてるんだ",
      "ko": "혼토-와 후루에테룬다"
    },
    {
      "t": 154.88,
      "text": "取り戻す為に闘うよ",
      "ko": "토리모도스 타메니 타타카우요"
    },
    {
      "t": 160.1,
      "text": "「立ち向かう」",
      "ko": "「타치무카우」"
    },
    {
      "t": 161.45,
      "text": "「怖くない」",
      "ko": "「코와쿠나이」"
    },
    {
      "t": 162.75,
      "text": "「君がいる」",
      "ko": "「키미가 이루」"
    },
    {
      "t": 163.95,
      "text": "「ここにいる」",
      "ko": "「코코니 이루」"
    },
    {
      "t": 165.55,
      "text": "「待っていて」",
      "ko": "「맛테이테」"
    },
    {
      "t": 166.68,
      "text": "「大丈夫」",
      "ko": "「다이죠-부」"
    },
    {
      "t": 168.12,
      "text": "「負けないよ」",
      "ko": "「마케나이요」"
    },
    {
      "t": 169.42,
      "text": "「認めてる」",
      "ko": "「미토메테루」"
    },
    {
      "t": 169.93,
      "text": "さあ踏み込んで進むんだ",
      "ko": "사- 후미콘데 스스문다"
    },
    {
      "t": 173.28,
      "text": "届くまで笑え あぁ",
      "ko": "토도쿠마데 와라에 아-"
    },
    {
      "t": 197.83,
      "text": "声にならない叫び声が",
      "ko": "코에니 나라나이 사케비고에가"
    },
    {
      "t": 200.2,
      "text": "胸の中震えてるんだ",
      "ko": "무네노 나카 후루에테룬다"
    },
    {
      "t": 202.82,
      "text": "分かってる、だから闘うよ",
      "ko": "와캇테루 다카라 타타카우요"
    },
    {
      "t": 207.23,
      "text": "今は一人じゃない胸が熱いよ",
      "ko": "이마와 히토리쟈나이 무네가 아츠이요"
    },
    {
      "t": 210.58,
      "text": "力なら君にもらった",
      "ko": "치카라나라 키미니 모랏타"
    },
    {
      "t": 213.37,
      "text": "守り抜くために闘うよ あぁ",
      "ko": "마모리누쿠 타메니 타타카우요 아-"
    },
    {
      "t": 223.25,
      "text": "君とまた笑ってる",
      "ko": "키미토 마타 와랏테루"
    }
  ],
